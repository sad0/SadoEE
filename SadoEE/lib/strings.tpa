// UI strings of M_PSTASH.lua, in the language chosen in the installer (tra/<language>/ui.tra, @100+).
// Generated by build_strings.py; ACTION_INCLUDE it from the main component.
// English first, then the installer language over it: a key missing in a translation stays English.
LOAD_TRA ~SadoEE/tra/english/ui.tra~
ACTION_IF FILE_EXISTS ~SadoEE/tra/%LANGUAGE%/ui.tra~ BEGIN
	LOAD_TRA ~SadoEE/tra/%LANGUAGE%/ui.tra~
END
