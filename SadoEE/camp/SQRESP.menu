menu
{
	name "SQRESP_TICK"
	ignoreesc
	-- SadoQoL respec: opens the next creation panel when the previous one closed (SQRespec_Tick).
	label
	{
		area 0 0 0 0
		enabled "SQRespec_Tick()"
	}
}

menu
{
	name "SQRESP_BACK"
	ignoreesc
	align center center
	-- SadoQoL respec: the creation screen's backdrop under the Race / Kit / Alignment panels, which draw only the
	-- bottom of the screen in the stock UI (the game's CHARGEN screen draws the rest; LeUI's panels are whole).
	label
	{
		area 0 0 1024 768
		mosaic 'GUICGB'
		enabled "SQRespec_NeedBack()"
	}
}

menu
{
	name "SQRESPEC"
	ignoreesc
	align center top
	-- SadoQoL respec: who is being recreated, "Continue" (after a panel closed with Back). The end is automatic.
	label
	{
		area 0 0 520 64
		rectangle 0
		rectangle opacity 200
	}
	label
	{
		area 16 6 488 26
		text lua "SQRespec_Title()"
		text style "title"
		text align center center
	}
	button
	{
		area 150 32 220 28
		bam GUIBUTWS
		sequence 0
		text lua "SQRespec.TXT_CONTINUE"
		text style "button"
		enabled "SQRespec_Active() and not SQRespec_AtEnd()"
		action "SQRespec_Continue()"
	}
}

menu
{
	name "SQRESP_DUAL"
	modal
	align center center
	ignoreesc
	-- SadoQoL respec, human single class: level of the first class before dual-classing (the rest of the XP comes
	-- back once he has dual-classed).
	label
	{
		area 0 0 560 200
		rectangle 0
		rectangle opacity 230
	}
	label
	{
		area 20 12 520 30
		text lua "SQRespec.TXT_DUAL_TITLE"
		text style "title"
		text align center center
	}
	button
	{
		area 150 56 40 40
		bam GUIBUTWS
		sequence 0
		text "-"
		text style "button"
		action "SQRespec_DualStep(-1)"
		actionAlt "SQRespec_DualStep(-5)"
	}
	label
	{
		area 200 56 160 40
		text lua "tostring(SQRespec_DualLevel())"
		text style "title"
		text align center center
	}
	button
	{
		area 370 56 40 40
		bam GUIBUTWS
		sequence 0
		text "+"
		text style "button"
		action "SQRespec_DualStep(1)"
		actionAlt "SQRespec_DualStep(5)"
	}
	label
	{
		area 20 104 520 34
		text lua "SQRespec_DualText()"
		text style "normal"
		text align center center
	}
	button
	{
		area 50 148 220 36
		bam GUIBUTWS
		sequence 0
		text lua "SQRespec.TXT_DUAL_OK"
		text style "button"
		action "SQRespec_DualConfirm()"
	}
	button
	{
		area 290 148 220 36
		bam GUIBUTWS
		sequence 0
		text lua "SQRespec.TXT_DUAL_NONE"
		text style "button"
		action "SQRespec_DualNone()"
	}
}

