menu
{
	name "PSXP7_BAR"
	ignoreesc
	-- Party members 7+ (M_PSXP7.lua places every item). Generated by genmenu.py.
	label
	{
		name "PSXP7_CL"
		area -100 -100 1 1
		enabled "PSXP7_ColumnsLayout() and false"
	}
	button
	{
		name "PSXP7_C6"
		area -100 -100 1 1
		portrait 6
		bam GUIRSP10
		enabled "PSXP7_BarVisible() and Infinity_GetNumCharacters() > 6"
		action "Infinity_OnPortraitLClick(6)"
		actionDbl "Infinity_OnPortraitDblClick(6)"
		actionAlt "Infinity_OnPortraitRClick(6)"
		actiondrag "Infinity_SwapWithPortrait(6)"
		glow lua "draggedPortrait and draggedPortrait ~= 6"
		actionEnter "mouseOverPortrait = 6"
		actionExit "mouseOverPortrait = -1"
		actionSimpleDrag "draggedPortrait = 6"
		actionSimpleDrop "PSXP7_DropPortrait(6)"
		tooltip lua "Infinity_GetPortraitTooltip(6)"
		clickable lua "sidebarsGreyed ~= 1"
	}
