-- Generated by build_gm_menu.py: edit that instead.
menu
{
	name "PSXGM_TICK"
	ignoreesc
	-- Camp merchant: its enabled check runs every frame (throttled in PSXGM_Tick): store discovery, the page.
	label
	{
		area 0 0 0 0
		enabled "PSXGM_Tick()"
	}
}

menu
{
	name "PSXGM_BACK"
	align center center
	size 864 710
	ignoreesc
	label
	{
		area 664 14 184 32
		rectangle 1
		rectangle opacity 120
	}
	button
	{
		area 664 14 184 32
		text lua "PSXGM_T('gm_back')"
		text style "button"
		text align center center
		action "PSXGM_Back()"
	}
}

menu
{
	name "PSXGM_PAGE"
	align center center
	size 864 710
	ignoreesc
	onOpen "PSXGM_OnOpen()"
	label
	{
		area 0 0 864 710
		rectangle 0
		rectangle opacity 255
	}
	label
	{
		enabled "PSXGM_Skin() == 1"
		area 0 0 864 710
		mosaic PSXGMBA
	}
	label
	{
		enabled "PSXGM_Skin() == 2"
		area 0 0 864 710
		mosaic PSXGMBB
	}
	button
	{
		area 0 0 864 710
		action ""
	}
	label
	{
		enabled "PSXGM_Tick()"
		area 0 0 0 0
	}
	label
	{
		enabled "PSXGM_Mode() == 'camp'"
		area 282 14 340 42
		bam PSXGMTT
	}
	label
	{
		enabled "PSXGM_Mode() == 'chest'"
		area 282 14 340 42
		bam PSXGMTC
	}
	list
	{
		column
		{
			width 100
			label
			{
				area 0 0 180 26
				bam PSXGMCIR
				frame lua "PSXGM_TreeSelected(rowNumber) and 1 or 0"
			}
			label
			{
				area 10 0 -1 -1
				text lua "PSXGM_TreeText(rowNumber)"
				text style "normal_parchment"
				text align left center
			}
		}
		area 26 68 184 580
		rowheight 26
		table "gmTreeList"
		var gmTreeRow
		hidehighlight
		action "PSXGM_TreeClick()"
	}
	label
	{
		enabled "gmFindText == ''"
		area 242 60 190 32
		text lua "PSXGM_T('gm_search') .. '...'"
		text style "normal"
		text align left center
	}
	edit
	{
		area 236 60 196 32
		var gmFindText
		text style "edit"
		maxlines 1
		fill 40 25 10 110
		action "return PSXGM_SearchEdit()"
	}
	label
	{
		area 440 64 24 24
		bam ROUNDBUT
		scaleToClip
		frame lua "PSXGM_FilterFrame('usable')"
	}
	button
	{
		area 438 60 112 32
		text lua "PSXGM_FilterText('usable')"
		text style "label_parchment"
		text align right center
		action "PSXGM_ToggleUsable()"
	}
	label
	{
		area 556 64 24 24
		bam ROUNDBUT
		scaleToClip
		frame lua "PSXGM_FilterFrame('afford')"
	}
	button
	{
		area 554 60 114 32
