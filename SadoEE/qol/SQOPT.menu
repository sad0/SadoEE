menu
{
	name "SQOPT_DROP"
	align center center
	size 864 710
	modal
	ignoreesc
	button
	{
		area 0 0 864 710
		action ""
	}
	label
	{
		area 232 54 440 552
		fill 60 40 20 220
	}
	label
	{
		area 236 58 432 544
		fill 226 208 170 255
	}
	label
	{
		area 246 64 412 30
		text lua "SQOpt_DropTitle()"
		text style "label_parchment"
		text align left center
	}
	list
	{
		column
		{
			width 100
			label
			{
				enabled "SQOpt_DropSelected(rowNumber)"
				area 0 0 -1 -1
				fill 90 60 20 70
			}
			label
			{
				area 6 0 -1 -1
				text lua "SQOpt_DropText(rowNumber)"
				text style "normal_parchment"
				text align left center
			}
		}
		area 246 100 412 444
		rowheight 24
		table "sqOptDropList"
		var sqOptDropRow
		hidehighlight
		scrollbar 'GUISCRP'
		action "SQOpt_DropClick()"
	}
	button
