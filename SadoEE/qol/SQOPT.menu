		area 380 556 144 32
		text lua "SQOpt.TXT.cancel"
		text style "label_parchment"
		text align center center
		on esc
		action "SQOpt_DropClose()"
		bam SQOPTBN
		sequence 0
	}
}

menu
{
	name "SQOPT_TICK"
