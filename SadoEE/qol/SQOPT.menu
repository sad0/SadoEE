}

menu
{
	name "SQOPT_TEMPLATES"
	ignoreesc
	-- the "SadoEE" button injected into the game's Options menu (ESC_MENU), styled like its Return button
	template
	{
		button
		{
			text lua "SQOpt_EscText()"
			text style "button"
			action "SQOpt_Open()"
			scaleToClip
		}
		name "SQOPT_TEMPLATE_EscButton"
	}
}
