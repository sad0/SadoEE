COPY_EXISTING ~UI.MENU~ ~override~
	PATCH_IF (INDEX_BUFFER (~autoRoller_~) >= 0) BEGIN
		PATCH_PRINT ~Auto Roller already present in UI.MENU, skipping.~
	END ELSE BEGIN
		// the BG2 abilities screen draws its Store / Recall / Reroll with GUIOSTSM
		SET bg2 = (INDEX_BUFFER (~bam GUIOSTSM~) >= 0) ? 1 : 0
		PATCH_IF (INDEX_BUFFER (~rgRerollButtonName~) >= 0) BEGIN   // Infinity UI++
			TEXT_SPRINT sq_aroll ~%sq_aroll_iui%~
		END ELSE PATCH_IF (INDEX_BUFFER (~area 42 510 340 32[ %TAB%%WNL%%LNL%]+bam[ %TAB%]+GUICHLNG~) >= 0) BEGIN   // LeUI
			// EEUITweaks' own auto-roller (its AUTO-REROLL at 454 578): ours goes above it
			PATCH_IF (INDEX_BUFFER (~UpdateAutoRoll~) >= 0) BEGIN SET y = 362 SET h = 226 END ELSE BEGIN SET y = 440 SET h = 304 END   // (470: the status line fell under the frame, John 2026-10-25)
			SET y2 = y + 36 SET y3 = y + 80 SET y4 = y + 124
			INNER_PATCH_SAVE sq_aroll ~%sq_aroll_leui%~ BEGIN
				REPLACE_TEXTUALLY ~SQY1~ ~%y%~
				REPLACE_TEXTUALLY ~SQY2~ ~%y2%~
				REPLACE_TEXTUALLY ~SQY3~ ~%y3%~
				REPLACE_TEXTUALLY ~SQY4~ ~%y4%~
			END
			REPLACE_TEXTUALLY ~area 436 128 382 478\([ %TAB%%WNL%%LNL%]+text lua "[^"]*abilityOrGeneralHelp()\)~ ~area 436 128 382 %h%\1~
		END ELSE PATCH_IF bg2 BEGIN TEXT_SPRINT sq_aroll ~%sq_aroll_bg2%~ END ELSE BEGIN TEXT_SPRINT sq_aroll ~%sq_aroll_bg1%~ END
		SET found = 0
		REPLACE_EVALUATE ~\(action[ %TAB%]+"createCharScreen:OnAbilityRecallButtonClick()"[ %TAB%%WNL%%LNL%]*}\)~ BEGIN
			SET found = found + 1
		END ~%MATCH1%%LNL%%sq_aroll%~
		PATCH_IF (found != 1) BEGIN
			PATCH_FAIL ~Could not find the Recall button in CHARGEN_ABILITIES (found %found%). Is another UI mod installed?~
		END
	END
BUT_ONLY


////////// Engine extension (#40+) //////////
// #40 Big party (John 2026-10-23): 7 to 32 members, an EEex engine extension (lib/party.tpa). BGEE + EET (EET is the dev game).
BEGIN @40 DESIGNATED 40
GROUP @2003
LABEL ~SADOEE-PARTY-BIG~
REQUIRE_PREDICATE GAME_IS ~bgee eet~ @41
REQUIRE_PREDICATE MOD_IS_INSTALLED ~EEex.tp2~ (ID_OF_LABEL ~EEex.tp2~ ~B3-EEex-Main~) @2
INCLUDE ~SadoEE/lib/party.tpa~
