	COPY ~EEex.ini~ ~EEex.ini~
		REPLACE_TEXTUALLY ~\(\[Empty Container Module\][%TAB% %WNL%%LNL%]*Enable=\)0~ ~\11~
		PATCH_IF (INDEX_BUFFER (~\[Empty Container Module\]~) < 0) BEGIN
			TEXT_SPRINT section ~%WNL%[Empty Container Module]%WNL%Enable=1%WNL%~
			SET end = BUFFER_LENGTH
