END ELSE BEGIN
	<<<<<<<< .../sadoee-inlined/EEex.ini
[Empty Container Module]
Enable=1
>>>>>>>>
	COPY ~.../sadoee-inlined/EEex.ini~ ~EEex.ini~
END

