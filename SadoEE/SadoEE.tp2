	ACTION_IF MOD_IS_INSTALLED ~PartyStash.tp2~ ~7~ BEGIN FAIL @2010 END
	ACTION_IF MOD_IS_INSTALLED ~PartyStash.tp2~ ~8~ BEGIN FAIL @2010 END
	ACTION_IF MOD_IS_INSTALLED ~PartyStash.tp2~ ~9~ BEGIN FAIL @2010 END
	ACTION_IF MOD_IS_INSTALLED ~PartyStash.tp2~ ~40~ BEGIN FAIL @2010 END
	ACTION_IF MOD_IS_INSTALLED ~SadoQoL.tp2~ ~0~ BEGIN FAIL @2010 END
	ACTION_IF MOD_IS_INSTALLED ~SadoQoL.tp2~ ~1~ BEGIN FAIL @2010 END
