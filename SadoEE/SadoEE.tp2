COPY ~SadoEE/camp/necro~ ~override~

// respec of the joined creatures (docs/NECRO_RESPEC.md, John 2026-10-25): every class, kit, multi-class and
// dual-class for the non-playable races (RACE.IDS 100-199, not in RACETEXT, not already a column): a CLSRCREQ
// column each, all 1 (its DUALCLASS row is the dual-class gate), and an ABRACERQ row each (3-18; natural scores
// above 18 are allowed per creature at run time)
OUTER_TEXT_SPRINT sq_head ~~
COPY_EXISTING ~CLSRCREQ.2DA~ ~override~
	REPLACE_EVALUATE ~^[ %TAB%]+\(HUMAN[^%WNL%%LNL%]*\)~ BEGIN
		TEXT_SPRINT sq_head ~ %MATCH1% ~
	END ~%MATCH0%~
BUT_ONLY
OUTER_TEXT_SPRINT sq_playable ~~
COPY_EXISTING ~RACETEXT.2DA~ ~override~
	REPLACE_EVALUATE ~^\([A-Z_][A-Z0-9_-]*\)[ %TAB%]+[0-9]+~ BEGIN
		TEXT_SPRINT sq_playable ~%sq_playable% %MATCH1% ~
	END ~%MATCH0%~
BUT_ONLY
OUTER_TEXT_SPRINT sq_names ~~
OUTER_TEXT_SPRINT sq_ones ~~
OUTER_TEXT_SPRINT sq_abrows ~~
OUTER_SET sq_nraces = 0
COPY_EXISTING ~RACE.IDS~ ~override~
	REPLACE_EVALUATE ~^\([0-9]+\)[ %TAB%]+\([A-Z_][A-Z0-9_-]*\)~ BEGIN
		SET sq_id = %MATCH1%
		PATCH_IF (sq_id >= 100) AND (sq_id < 200)
			AND (INDEX (EXACT_MATCH ~ %MATCH2% ~ ~%sq_playable%~) < 0)
			AND (INDEX (EXACT_MATCH ~ %MATCH2% ~ ~%sq_head%~) < 0) BEGIN
			TEXT_SPRINT sq_names ~%sq_names%  %MATCH2%~
			TEXT_SPRINT sq_ones ~%sq_ones%  1~
			TEXT_SPRINT sq_abrows ~%sq_abrows%%MATCH2%  3  18  3  18  3  18  3  18  3  18  3  18%LNL%~
			SET sq_nraces = sq_nraces + 1
		END
	END ~%MATCH0%~
BUT_ONLY
ACTION_IF sq_nraces > 0 BEGIN
	COPY_EXISTING ~CLSRCREQ.2DA~ ~override~
		REPLACE_EVALUATE ~^\([ %TAB%]+HUMAN[^%WNL%%LNL%]*\)~ BEGIN END ~%MATCH1%%sq_names%~
		REPLACE_EVALUATE ~^\([A-Z_][A-Z0-9_]*[ %TAB%]+-?[0-9][^%WNL%%LNL%]*\)~ BEGIN END ~%MATCH1%%sq_ones%~
	BUT_ONLY
	APPEND ~ABRACERQ.2DA~ ~%sq_abrows%~
	PRINT ~Necromancer respec: %sq_nraces% creature races may take every class.~
END

// no level up for creatures without a player class (joined monsters: the engine crashes dividing by zero)
COPY_EXISTING ~UI.MENU~ ~override~
	PATCH_IF (INDEX_BUFFER (~SQNecro_LevelUpClickable~) < 0) BEGIN
		REPLACE_TEXTUALLY EXACT_MATCH ~lua "characterScreen:IsLevelUpButtonClickable()"~
			~lua "(SQNecro_LevelUpClickable or function() return characterScreen:IsLevelUpButtonClickable() end)()"~
		REPLACE_TEXTUALLY ~enabled "Infinity_CanLevelUp(\([0-9]+\))"~ ~enabled "(SQNecro_CanLevelUp or Infinity_CanLevelUp)(\1)"~
	END
	// Customize > Appearance (the portrait) open to the necromancer's creatures (the engine greys it out for them)
	PATCH_IF (INDEX_BUFFER (~SQNecro_AppearanceClickable~) < 0) BEGIN
		REPLACE_TEXTUALLY ~\(text "APPEARANCE_BUTTON"[ %TAB%%WNL%%LNL%]+clickable lua[ %TAB%%WNL%%LNL%]+"\)[ %TAB%%WNL%%LNL%]*characterScreen:IsAppearanceButtonClickable();~
			~\1(SQNecro_AppearanceClickable or function() return characterScreen:IsAppearanceButtonClickable() end)()~
	END
BUT_ONLY
// the inventory draws the standing frame of creatures the engine has no paper doll for, under the doll button (which
// keeps its item drops): the game's inventory and Party Stash's page (PSTASH.menu draws its own paper doll)
ACTION_FOR_EACH sq_menu IN ~UI.MENU~ ~PSTASH.menu~ BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%sq_menu%~ BEGIN
		COPY_EXISTING ~%sq_menu%~ ~override~
		PATCH_IF (INDEX_BUFFER (~SQNecro_DollBam~) < 0) BEGIN
			SET found = 0
			REPLACE_EVALUATE ~\(button[ %TAB%%WNL%%LNL%]*{[ %TAB%%WNL%%LNL%]*area[ %TAB%]+\([0-9]+ [0-9]+ [0-9]+ [0-9]+\)[ %TAB%%WNL%%LNL%]+paperdoll 1[ %TAB%%WNL%%LNL%]+actiondrag "Infinity_SwapWithAppearance()"\)~ BEGIN
				SET found = found + 1
			END ~label%LNL%	{%LNL%		area %MATCH2%%LNL%		enabled "SQNecro_HasDoll and SQNecro_HasDoll()"%LNL%		bam lua "SQNecro_DollBam and SQNecro_DollBam() or ''"%LNL%		sequence 0%LNL%		frame 0%LNL%		scaleToClip%LNL%	}%LNL%	%MATCH1%~
			PATCH_IF (found != 1) BEGIN
				PATCH_PRINT ~Necromancer: the inventory paper doll was not found in %SOURCE_FILE% (found %found%): no doll for monsters.~
			END
		END
		BUT_ONLY
	END
END

