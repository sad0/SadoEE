// #16 Quest chronicle (John 2026-10-24): Decard, the camp's old scholar, opens a page with every quest of the game
// (the game's own quest table and journal: status, entries), searchable, with hints and a full solution per quest
// (quests/data/<language>.lua, built by quests/build_q_lua.py). M_PSXQ.lua + PSXQ.menu (build_q_menu.py).
BEGIN @20 DESIGNATED 16
GROUP @2001
LABEL ~SADOEE-QUEST-CHRONICLE~
REQUIRE_PREDICATE MOD_IS_INSTALLED ~SadoEE.tp2~ (ID_OF_LABEL ~SadoEE.tp2~ ~SADOEE-CAMP-SCHOLAR~) @21
REQUIRE_PREDICATE GAME_IS ~bgee bg2ee eet~ @2
REQUIRE_PREDICATE MOD_IS_INSTALLED ~EEex.tp2~ (ID_OF_LABEL ~EEex.tp2~ ~B3-EEex-Main~) @2
REQUIRE_PREDICATE FILE_EXISTS_IN_GAME ~sqcain.dlg~ @21
COPY ~SadoEE/M_PSXQ.lua~ ~override~
     ~SadoEE/PSXQ.menu~ ~override~
// full pages over the world (shared helper, John 2026-10-24): the game paused, the world veiled, the portrait bars live
COPY ~SadoEE/M_PSXPG.lua~ ~override~
     ~SadoEE/PSXPG.menu~ ~override~
// the notice board and the paper tickets of the camp merchant's page (the same files as #8)
COPY ~SadoEE/PSXGMBA.MOS~ ~override~
     ~SadoEE/PSXGMBB.MOS~ ~override~
     ~SadoEE/PSXGMBN2.BAM~ ~override~
     ~SadoEE/PSXGMBN4.BAM~ ~override~
     ~SadoEE/PSXGMCIR.BAM~ ~override~
// hints and solutions in the install language (English when there is none yet), the title lettering likewise
ACTION_IF FILE_EXISTS ~SadoEE/quests/data/%LANGUAGE%.lua~ BEGIN
	COPY ~SadoEE/quests/data/%LANGUAGE%.lua~ ~override/M_PSXQD.lua~
END ELSE BEGIN
	COPY ~SadoEE/quests/data/english.lua~ ~override/M_PSXQD.lua~
END
ACTION_IF ~%LANGUAGE%~ STRING_EQUAL_CASE ~french~ BEGIN
	COPY ~SadoEE/PSXQTFR.BAM~ ~override/PSXQT.BAM~
END ELSE BEGIN
	COPY ~SadoEE/PSXQTEN.BAM~ ~override/PSXQT.BAM~
END
COMPILE ~SadoEE/quests/PSXQCAIN.d~ USING ~SadoEE/tra/%LANGUAGE%/quests.tra~
