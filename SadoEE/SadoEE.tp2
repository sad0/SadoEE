// SadoEE: Party Stash + SadoQoL in one mod, every feature an optional component (John 2026-10-23).
// GENERATED by build_sadoee.py from the PartyStash and SadoQoL dev folders: edit those (and SadoEE/src), not this file.
BACKUP ~weidu_external/backup/SadoEE~
AUTHOR ~sad0~
VERSION ~v1.0.1~
README ~SadoEE/readme/readme-%LANGUAGE%.html~ ~SadoEE/readme/readme-english.html~

// SadoEE replaces Party Stash and SadoQoL: same override files, so never both (uninstall theirs first).
ALWAYS
	ACTION_IF MOD_IS_INSTALLED ~PartyStash.tp2~ ~0~ BEGIN FAIL @2010 END
	ACTION_IF MOD_IS_INSTALLED ~PartyStash.tp2~ ~1~ BEGIN FAIL @2010 END
	ACTION_IF MOD_IS_INSTALLED ~PartyStash.tp2~ ~2~ BEGIN FAIL @2010 END
	ACTION_IF MOD_IS_INSTALLED ~PartyStash.tp2~ ~3~ BEGIN FAIL @2010 END
