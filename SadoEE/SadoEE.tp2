INCLUDE ~SadoEE/quests/mod_quests.tpa~

// Camp necromancer (John 2026-10-24): target dummies raised from the whole bestiary, any number, undying and
// passive or unleashed, a damage meter, clean up, join the party. Needs the rest camp (#10). M_SQNECR.lua +
// SQNECR.menu; the bestiary (every CRE of the game) is written at install into M_SQBEST.lua.
BEGIN @1326 DESIGNATED 17
GROUP @2001
LABEL ~SADOEE-CAMP-NECROMANCER~
REQUIRE_PREDICATE MOD_IS_INSTALLED ~SadoEE.tp2~ (ID_OF_LABEL ~SadoEE.tp2~ ~SADOEE-CAMP~) @2011

// the necromancer: a human mage in a black robe with red trims, from Xzar's creature
COPY_EXISTING ~XZAR.CRE~ ~override/SQNECRO.CRE~
	WRITE_LONG 0x28 0x6200           // MAGE_MALE_HUMAN
	WRITE_BYTE 0x2c 30               // metal
	WRITE_BYTE 0x2d 47               // minor: blood red (John 2026-10-25: black and red, kept)
	WRITE_BYTE 0x2e 66               // major: black
	WRITE_BYTE 0x2f 12               // skin
	WRITE_BYTE 0x30 66               // leather
	WRITE_BYTE 0x31 66               // armor
	WRITE_BYTE 0x32 0                // hair
	WRITE_LONG 0x14 0                // no XP
	WRITE_LONG 0x1c 0                // no gold
	WRITE_BYTE 0x270 128             // NEUTRAL
	SAY NAME1 @1297
	SAY NAME2 @1297
	WRITE_ASCII SCRIPT_OVERRIDE ~~ #8
	WRITE_ASCII SCRIPT_CLASS ~~ #8
	WRITE_ASCII SCRIPT_RACE ~~ #8
	WRITE_ASCII SCRIPT_GENERAL ~~ #8
	WRITE_ASCII SCRIPT_DEFAULT ~~ #8
	WRITE_ASCII DEATHVAR ~SQNECRO~ #32
	WRITE_ASCII DIALOG ~SQNECRO~ #8
COMPILE ~SadoEE/camp/dlg/SQNECRO.d~ USING ~SadoEE/tra/%LANGUAGE%/qol.tra~

// the bestiary: every creature with a name, HP and an animation: { resref, name strref, level, max HP, AC, race }
OUTER_TEXT_SPRINT sq_best ~~
COPY_EXISTING_REGEXP GLOB ~^.+\.cre$~ ~override~
	PATCH_IF SOURCE_SIZE > 0x2d4 BEGIN
		READ_ASCII 0 sq_sig (8)
		PATCH_IF ~%sq_sig%~ STRING_EQUAL ~CRE V1.0~ BEGIN
			READ_LONG 0x0c sq_nm
			PATCH_IF sq_nm <= 0 BEGIN READ_LONG 0x08 sq_nm END
			READ_SHORT 0x26 sq_hp
			READ_SSHORT 0x46 sq_ac
			READ_BYTE 0x234 sq_lvl
			READ_BYTE 0x272 sq_race
			READ_LONG 0x28 sq_anim
			PATCH_IF sq_nm > 0 AND sq_hp > 1 AND sq_anim > 0 BEGIN
				TEXT_SPRINT sq_best ~%sq_best%{"%SOURCE_RES%",%sq_nm%,%sq_lvl%,%sq_hp%,%sq_ac%,%sq_race%},~
			END
		END
	END
	BUT_ONLY
<<<<<<<< .../sadoee-inlined/M_SQBEST.lua
-- SadoQoL #20: the camp necromancer's bestiary, written at install from every CRE of the game.
-- { resref, name strref, level, max HP, AC, race }
SQNecro_Bestiary = { SQ_BEST_DATA }
>>>>>>>>
COPY ~.../sadoee-inlined/M_SQBEST.lua~ ~override~
	REPLACE_TEXTUALLY EXACT_MATCH ~SQ_BEST_DATA~ ~%sq_best%~

