////////// Party Stash (#0-#7) //////////
// The look choice (John 2026-10-19): "(recommended)" only on the game's own look, so each look exists twice, in
// two SUBCOMPONENT groups (@1 on BGEE, @11 = the same name on BG2EE/EET, each with its game predicate): one group
// shows per game. One group for both did not work: WeiDU skips the whole group when any member fails its predicate.
// No per-component REQUIRE_PREDICATE on the game (WeiDU would print "SKIPPING ..." for the other game's group): the
// group predicate hides it, and a forced install (--force-install) of the other game's look stops with @12 / @13. Numbers kept from v0.4: #0 = BG1 look on BGEE,
// #2 = BG2 look on BG2EE/EET; #3 = BG1 look on BG2EE/EET, #4 = BG2 look on BGEE.
BEGIN @6 DESIGNATED 0 SUBCOMPONENT @1 (GAME_IS ~bgee~)
GROUP @2000
LABEL ~SADOEE-MAIN~
REQUIRE_PREDICATE MOD_IS_INSTALLED ~EEex.tp2~ (ID_OF_LABEL ~EEex.tp2~ ~B3-EEex-Main~) @2
ACTION_IF NOT GAME_IS ~bgee~ BEGIN FAIL @12 END   // forced installs ignore the group predicate
OUTER_TEXT_SPRINT ps_look ~bg1~
INCLUDE ~SadoEE/lib/main.tpa~

// #1 Sorted loot = SadoQoL #3 (John 2026-10-19: in both mods). Same files under the same override names
// (M_SQSORT.lua, SQSORT.menu), so whichever is installed last provides it and only one copy ever runs.
// Ground piles, containers and the quick loot bar list quest items, weightless items, then value/weight.
// Quest item = an item the game asks for: the dialogues and scripts are read here and every item they check or
// take from the party, and that no store sells, goes in the Lua's quest table (nothing is written back).
BEGIN @5 DESIGNATED 1
GROUP @2000
LABEL ~SADOEE-SORTED-LOOT~
REQUIRE_PREDICATE GAME_IS ~bgee bg2ee eet~ @2
REQUIRE_PREDICATE MOD_IS_INSTALLED ~EEex.tp2~ (ID_OF_LABEL ~EEex.tp2~ ~B3-EEex-Main~) @2

ACTION_CLEAR_ARRAY sq_quest
OUTER_TEXT_SPRINT sq_party ~PartyHasItem\|PartyHasItemIdentified\|TakePartyItem\|TakePartyItemNum\|TakePartyItemAll\|DestroyPartyItem\|DestroyPartyItemNum~
// Dialogues keep their triggers and actions as text. HasItem there is about the speaker's party.
COPY_EXISTING_REGEXP GLOB ~^.+\.dlg$~ ~override~
	REPLACE_EVALUATE CASE_INSENSITIVE ~\(%sq_party%\|HasItem\|HasItemEquiped\|HasItemEquipedReal\)([ %TAB%]*"\([^"]+\)"~ BEGIN
		TEXT_SPRINT r ~%MATCH2%~
		TO_UPPER r
		SET $sq_quest(~%r%~) = 1
	END ~%MATCH0%~
	REPLACE_EVALUATE CASE_INSENSITIVE ~TakeItemReplace([ %TAB%]*"[^"]*"[ %TAB%]*,[ %TAB%]*"\([^"]+\)"~ BEGIN
		TEXT_SPRINT r ~%MATCH1%~
		TO_UPPER r
		SET $sq_quest(~%r%~) = 1
	END ~%MATCH0%~
BUT_ONLY
// Scripts: only the party checks (HasItem there is mostly a creature looking at its own potions).
// only scripts holding one of them are decompiled (compiled: TR <trigger id> / AC <action id>; PartyHasItem 0x4042,
// PartyHasItemIdentified 0x40A9, TakePartyItem 116, TakePartyItemAll 188, TakePartyItemNum 204): decompiling every
// script cost minutes on a big EET install
COPY_EXISTING_REGEXP GLOB ~^.+\.bcs$~ ~override~
	PATCH_IF INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%LNL%16450 ~) >= 0 OR INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~%LNL%16553 ~) >= 0
			OR INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~AC%LNL%116OB~) >= 0 OR INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~AC%LNL%188OB~) >= 0
			OR INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~AC%LNL%204OB~) >= 0 BEGIN
	READ_ASCII 0 bcs (BUFFER_LENGTH)
	INNER_PATCH ~%bcs%~ BEGIN
		DECOMPILE_BCS_TO_BAF
		REPLACE_EVALUATE CASE_INSENSITIVE ~\(%sq_party%\)([ %TAB%]*"\([^"]+\)"~ BEGIN
			TEXT_SPRINT r ~%MATCH2%~
			TO_UPPER r
			SET $sq_quest(~%r%~) = 1
		END ~%MATCH0%~
	END
	END
BUT_ONLY
// Anything a store sells is common (healing potions, wands, gems a dialogue happens to ask for): not a quest item.
ACTION_CLEAR_ARRAY sq_sold
COPY_EXISTING_REGEXP GLOB ~^.+\.sto$~ ~override~
	READ_LONG 0x34 off
	READ_LONG 0x38 cnt
	FOR (i = 0; i < cnt; ++i) BEGIN
		READ_ASCII (off + i * 0x1c) r (8) NULL
		TO_UPPER r
		SET $sq_sold(~%r%~) = 1
	END
BUT_ONLY

OUTER_TEXT_SPRINT sq_list ~{~
OUTER_SET sq_n = 0
ACTION_PHP_EACH sq_quest AS r => v BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%r%.itm~ AND NOT VARIABLE_IS_SET $sq_sold(~%r%~) BEGIN
		OUTER_TEXT_SPRINT sq_list ~%sq_list% ["%r%"] = true,~
		OUTER_SET sq_n += 1
	END
END
OUTER_TEXT_SPRINT sq_list ~%sq_list% }~
PRINT ~PartyStash sorted loot: %sq_n% quest items.~
COPY ~SadoEE/M_SQSORT.lua~ ~override~
	REPLACE_TEXTUALLY EXACT_MATCH ~SQ_SORT_QUEST_LIST~ ~%sq_list%~
COPY ~SadoEE/SQSORT.menu~ ~override~

BEGIN @7 DESIGNATED 2 SUBCOMPONENT @11 (GAME_IS ~bg2ee eet~)
GROUP @2000
LABEL ~SADOEE-MAIN-BG2-LOOK~
REQUIRE_PREDICATE MOD_IS_INSTALLED ~EEex.tp2~ (ID_OF_LABEL ~EEex.tp2~ ~B3-EEex-Main~) @2
ACTION_IF NOT GAME_IS ~bg2ee eet~ BEGIN FAIL @13 END   // forced installs ignore the group predicate
OUTER_TEXT_SPRINT ps_look ~bg2~
INCLUDE ~SadoEE/lib/main.tpa~

BEGIN @9 DESIGNATED 3 SUBCOMPONENT @11 (GAME_IS ~bg2ee eet~)
GROUP @2000
LABEL ~SADOEE-MAIN-BG1-LOOK-ON-BG2~
REQUIRE_PREDICATE MOD_IS_INSTALLED ~EEex.tp2~ (ID_OF_LABEL ~EEex.tp2~ ~B3-EEex-Main~) @2
ACTION_IF NOT GAME_IS ~bg2ee eet~ BEGIN FAIL @13 END   // forced installs ignore the group predicate
OUTER_TEXT_SPRINT ps_look ~bg1~
INCLUDE ~SadoEE/lib/main.tpa~

BEGIN @10 DESIGNATED 4 SUBCOMPONENT @1 (GAME_IS ~bgee~)
GROUP @2000
LABEL ~SADOEE-MAIN-BG2-LOOK-ON-BGEE~
REQUIRE_PREDICATE MOD_IS_INSTALLED ~EEex.tp2~ (ID_OF_LABEL ~EEex.tp2~ ~B3-EEex-Main~) @2
ACTION_IF NOT GAME_IS ~bgee~ BEGIN FAIL @12 END   // forced installs ignore the group predicate
OUTER_TEXT_SPRINT ps_look ~bg2~
INCLUDE ~SadoEE/lib/main.tpa~

// Install options (John 2026-10-22), off unless chosen. Each writes a tiny override Lua file that sets one flag of
// PStash_Opt, read by M_PSTASH.lua at run time. They need the stash (any look).
// #5 the stash weighs nothing; #6 the party gold survives the campaign moves (BG1 -> SoD, EET SoD -> BG2);
// #7 "hardcore": those moves empty the stash too (by default it is kept).
BEGIN @14 DESIGNATED 5
GROUP @2000
LABEL ~SADOEE-OPT-WEIGHTLESS~
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~SadoEE.tp2~ 0 OR MOD_IS_INSTALLED ~SadoEE.tp2~ 2 OR MOD_IS_INSTALLED ~SadoEE.tp2~ 3 OR MOD_IS_INSTALLED ~SadoEE.tp2~ 4) @17
<<<<<<<< .../SadoEE-inlined/M_PSOPTW.lua
-- Party Stash install option (SadoEE.tp2 #5): the stash weighs nothing.
PStash_Opt = PStash_Opt or {}
PStash_Opt.weightless = true
>>>>>>>>
COPY ~.../SadoEE-inlined/M_PSOPTW.lua~ ~override~

BEGIN @15 DESIGNATED 6
GROUP @2000
LABEL ~SADOEE-OPT-KEEPGOLD~
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~SadoEE.tp2~ 0 OR MOD_IS_INSTALLED ~SadoEE.tp2~ 2 OR MOD_IS_INSTALLED ~SadoEE.tp2~ 3 OR MOD_IS_INSTALLED ~SadoEE.tp2~ 4) @17
<<<<<<<< .../SadoEE-inlined/M_PSOPTG.lua
-- Party Stash install option (SadoEE.tp2 #6): the party gold survives the campaign moves.
PStash_Opt = PStash_Opt or {}
PStash_Opt.keepgold = true
>>>>>>>>
COPY ~.../SadoEE-inlined/M_PSOPTG.lua~ ~override~

BEGIN @16 DESIGNATED 7
GROUP @2000
LABEL ~SADOEE-OPT-LOSESTASH~
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~SadoEE.tp2~ 0 OR MOD_IS_INSTALLED ~SadoEE.tp2~ 2 OR MOD_IS_INSTALLED ~SadoEE.tp2~ 3 OR MOD_IS_INSTALLED ~SadoEE.tp2~ 4) @17
<<<<<<<< .../SadoEE-inlined/M_PSOPTL.lua
-- Party Stash install option (SadoEE.tp2 #7): the campaign moves empty the stash too.
PStash_Opt = PStash_Opt or {}
PStash_Opt.losestash = true
>>>>>>>>
COPY ~.../SadoEE-inlined/M_PSOPTL.lua~ ~override~


////////// Rest camp (#10-#15) //////////
// Rest camp: a quiet camp (SQCAMP, cropped from BD5000 by tools/build_camp.py, reusing BD5000's tilesets) reached
// from the world map through a parchment over the Travel button, 0 h there and back. M_SQCAMP.lua + SQCAMP.menu.
BEGIN @1100 DESIGNATED 10
GROUP @2001
LABEL ~SADOEE-CAMP~
REQUIRE_PREDICATE GAME_IS ~bgee eet bg2ee~ @2014
REQUIRE_PREDICATE MOD_IS_INSTALLED ~EEex.tp2~ (ID_OF_LABEL ~EEex.tp2~ ~B3-EEex-Main~) @1002

COPY ~SadoEE/qol/M_SQ0BLD.lua~ ~override~   // engine build address table (v2.7.3 / v2.6.6)
COPY ~SadoEE/camp/area~ ~override~
// BG2EE (John 2026-10-25): the camp is OH5300, the Helmite Camp, whole (tools/build_camp_bg2.py); its spots in M_SQ0CMP.lua
ACTION_IF GAME_IS ~bg2ee~ BEGIN
	COPY ~SadoEE/camp/area_bg2~ ~override~
END
OUTER_SET camp = RESOLVE_STR_REF (@1101)
OUTER_SET back = RESOLVE_STR_REF (@1102)
COPY ~SadoEE/camp/M_SQCAMP.lua~ ~override~
	REPLACE_TEXTUALLY EXACT_MATCH ~{ 'SQMERCH', 723, 301, 2 },~ ~-- SADOEE-MERCHANT { 'SQMERCH', 723, 301, 2 },~
	REPLACE_TEXTUALLY EXACT_MATCH ~SQ_CAMP_STR_CAMP~ ~%camp%~
	REPLACE_TEXTUALLY EXACT_MATCH ~SQ_CAMP_STR_BACK~ ~%back%~
COPY ~SadoEE/camp/SQCAMP.menu~ ~override~

// the camp people's voices (John 2026-10-24): a whole soundset (100 strrefs at 0xA4) taken from a game creature
// AGNASI: calm female greetings ("Puis-je vous aider ?") for the priestess (MERCHA, the merchant's: in his block)
// (BG2EE has neither: the priestess of Ilmater's WILMAT, the Athkatla merchant's AEMERCH, John 2026-10-25)
OUTER_SET sq_voice_priest = 0
OUTER_SPRINT sq_vp_cre ~AGNASI~
ACTION_IF !FILE_EXISTS_IN_GAME ~agnasi.cre~ BEGIN OUTER_SPRINT sq_vp_cre ~WILMAT~ END
ACTION_IF FILE_EXISTS_IN_GAME ~%sq_vp_cre%.cre~ BEGIN
	OUTER_SET sq_voice_priest = 1
	COPY_EXISTING ~%sq_vp_cre%.CRE~ ~override~
		FOR (i = 0; i < 100; i += 1) BEGIN READ_LONG (0xa4 + i * 4) EVAL ~sq_vp_%i%~ END
	BUT_ONLY
END
// the wandering priest by the fire: temple services (donations, identification, cures), from Kelddath's creature
COPY_EXISTING ~SQPRIEST.STO~ ~override~
	SAY 0x0c @1114
// (BG2EE has no Kelddath: a cleric of Lathander's creature, AMTCLE01; looks and scripts are rewritten anyway)
OUTER_SPRINT sq_base ~KELDDA~
ACTION_IF !FILE_EXISTS_IN_GAME ~keldda.cre~ BEGIN OUTER_SPRINT sq_base ~AMTCLE01~ END
COPY_EXISTING ~%sq_base%.CRE~ ~override/SQPRIEST.CRE~
	WRITE_LONG 0x28 0xC910          // PEASANT_WOMAN: a priestess in emerald (John 2026-10-24)
	PATCH_IF sq_voice_priest BEGIN FOR (i = 0; i < 100; i += 1) BEGIN WRITE_LONG (0xa4 + i * 4) EVAL ~%sq_vp_%i%%~ END END
	WRITE_BYTE 0x2c 27               // metal
	WRITE_BYTE 0x2d 54               // minor
	WRITE_BYTE 0x2e 54               // major
	WRITE_BYTE 0x2f 13               // skin
	WRITE_BYTE 0x30 54               // leather
	WRITE_BYTE 0x31 54               // armor
	WRITE_BYTE 0x32 115               // hair
	SAY NAME1 @1113
	SAY NAME2 @1113
	WRITE_ASCII SCRIPT_OVERRIDE ~~ #8
	WRITE_ASCII SCRIPT_CLASS ~~ #8
	WRITE_ASCII SCRIPT_RACE ~~ #8
	WRITE_ASCII SCRIPT_GENERAL ~~ #8
	WRITE_ASCII SCRIPT_DEFAULT ~~ #8
	WRITE_ASCII DEATHVAR ~SQPRIEST~ #32
	WRITE_ASCII DIALOG ~SQPRIEST~ #8
COMPILE ~SadoEE/camp/dlg/SQPRIEST.d~ USING ~SadoEE/tra/%LANGUAGE%/qol.tra~
// her two services (John 2026-10-24): reputation donation + healing the whole party, no store reply any more
OUTER_SET pr_raise = RESOLVE_STR_REF (@1291)
OUTER_SET pr_wounds = RESOLVE_STR_REF (@1292)
OUTER_SET pr_drain = RESOLVE_STR_REF (@1293)
OUTER_SET pr_curse = RESOLVE_STR_REF (@1294)
OUTER_SET pr_poison = RESOLVE_STR_REF (@1295)
OUTER_SET pr_disease = RESOLVE_STR_REF (@1296)
OUTER_SET pr_rest = RESOLVE_STR_REF (@1342)
OUTER_SET pr_freemsg = RESOLVE_STR_REF (@1343)
COPY ~SadoEE/camp/M_SQPRST.lua~ ~override~
	REPLACE_TEXTUALLY EXACT_MATCH ~SQ_PR_RAISE~ ~%pr_raise%~
	REPLACE_TEXTUALLY EXACT_MATCH ~SQ_PR_WOUNDS~ ~%pr_wounds%~
	REPLACE_TEXTUALLY EXACT_MATCH ~SQ_PR_DRAIN~ ~%pr_drain%~
	REPLACE_TEXTUALLY EXACT_MATCH ~SQ_PR_CURSE~ ~%pr_curse%~
	REPLACE_TEXTUALLY EXACT_MATCH ~SQ_PR_POISON~ ~%pr_poison%~
	REPLACE_TEXTUALLY EXACT_MATCH ~SQ_PR_DISEASE~ ~%pr_disease%~
	REPLACE_TEXTUALLY EXACT_MATCH ~SQ_PR_REST~ ~%pr_rest%~
	REPLACE_TEXTUALLY EXACT_MATCH ~SQ_PR_FREEMSG~ ~%pr_freemsg%~
// the camp merchant is component #11: until then his spot by the fire stays empty (actor schedule 0 = never there)
COPY_EXISTING ~SQCAMP.ARE~ ~override~
	READ_LONG 0x54 off
	READ_SHORT 0x58 cnt
	FOR (i = 0; i < cnt; ++i) BEGIN
		READ_ASCII (off + i * 0x110 + 0x80) cre (8) NULL
		PATCH_IF ~%cre%~ STRING_EQUAL_CASE ~SQMERCH~ BEGIN WRITE_LONG (off + i * 0x110 + 0x40) 0 END
	END
COMPILE ~SadoEE/camp/dlg/SQMERCH0.d~ USING ~SadoEE/tra/%LANGUAGE%/qol.tra~

// #11 Camp merchant (grand marchand, John 2026-10-23): the store PSXCAMP sells every item seen at the stores already
// visited (best price seen, infinite stock, uniques once). M_PSXGM.lua records the stores and draws the page
// (PSXGM.menu); a camp creature opens it with StartStore("PSXCAMP", LastTalkedToBy()) (SadoQoL's camp).
BEGIN @2012 DESIGNATED 11
GROUP @2001
LABEL ~SADOEE-CAMP-MERCHANT~
REQUIRE_PREDICATE MOD_IS_INSTALLED ~SadoEE.tp2~ (ID_OF_LABEL ~SadoEE.tp2~ ~SADOEE-CAMP~) @2011
REQUIRE_PREDICATE (MOD_IS_INSTALLED ~SadoEE.tp2~ 0 OR MOD_IS_INSTALLED ~SadoEE.tp2~ 2 OR MOD_IS_INSTALLED ~SadoEE.tp2~ 3 OR MOD_IS_INSTALLED ~SadoEE.tp2~ 4) @2013
COPY ~SadoEE/PSXCAMP.STO~ ~override~
	SAY 0x0C @19
COPY ~SadoEE/M_PSXGM.lua~ ~override~
COPY ~SadoEE/PSXGM.menu~ ~override~
	// the item slots follow the stash's look (John 2026-10-23): BG2 look on BGEE (#4) -> BG2 slots, BG1 look on
	// BG2EE (#3) -> BG1 slots; the game's own look keeps PSSLOT (the game's slot, lib/main.tpa)
	PATCH_IF MOD_IS_INSTALLED ~SadoEE.tp2~ 4 BEGIN
		REPLACE_TEXTUALLY ~\bbam PSSLOT\b~ ~bam PSTSLOT2~
	END ELSE PATCH_IF MOD_IS_INSTALLED ~SadoEE.tp2~ 3 BEGIN
		REPLACE_TEXTUALLY ~\bbam PSSLOT\b~ ~bam PSTSLOT1~
	END
// the page in the install language (build_gm_strings.py; English is M_PSXGM.lua's own)
ACTION_IF FILE_EXISTS ~SadoEE/tra/%LANGUAGE%/M_PSXGT.lua~ BEGIN
	COPY ~SadoEE/tra/%LANGUAGE%/M_PSXGT.lua~ ~override~
END
// The camp chest (2026-10-23): its store (the stash + what the known stores sell, taken / bought there), the hidden
// bag of the items seen (the save's log), and its encyclopedia built from the player's own game and language: every
// item the player can come across (see below), and the world map's area names (build_gm_catalog.py = the same, dev).
COPY ~SadoEE/PSXCHEST.STO~ ~override~
     ~SadoEE/PSXSEEN.STO~ ~override~
OUTER_TEXT_SPRINT gm_areas ~~
ACTION_CLEAR_ARRAY gm_wmp
// every world map (EET, SoD: several): area -> caption
COPY_EXISTING_REGEXP GLOB ~^.+\.wmp$~ ~override~
	READ_ASCII 0 gm_sig (8)
	PATCH_IF ~%gm_sig%~ STRING_EQUAL ~WMAPV1.0~ BEGIN
		READ_LONG 0x08 gm_maps
		READ_LONG 0x0c gm_moff
		FOR (m = 0; m < gm_maps; ++m) BEGIN
			READ_LONG (gm_moff + m * 0xb8 + 0x20) gm_na
			READ_LONG (gm_moff + m * 0xb8 + 0x24) gm_ao
			FOR (a = 0; a < gm_na AND gm_ao + a * 0xf0 + 0xf0 <= SOURCE_SIZE; ++a) BEGIN
				READ_ASCII (gm_ao + a * 0xf0) gm_area (8) NULL
				READ_LONG (gm_ao + a * 0xf0 + 0x40) gm_cap
				TO_UPPER gm_area
				PATCH_IF gm_cap > 0 AND gm_cap < 0x7fffffff AND NOT VARIABLE_IS_SET $gm_wmp(~%gm_area%~) BEGIN
					GET_STRREF gm_cap gm_text
					PATCH_IF STRING_LENGTH ~%gm_text%~ > 0 BEGIN
						TEXT_SPRINT $gm_wmp(~%gm_area%~) ~%gm_text%~
						TEXT_SPRINT gm_areas ~%gm_areas%["%gm_area%"] = [[%gm_text%]],~
					END
				END
			END
		END
	END
BUT_ONLY
// EET's world map has no caption for the Baldur's Gate districts and Candlekeep (BG1's AR0100... renamed BG0100...),
// nor BG2 for Irenicus' dungeon, Hell and the Pocket Plane
ACTION_DEFINE_ASSOCIATIVE_ARRAY gm_unnamed_en BEGIN
	BG0100 => ~Baldur's Gate, North-West~  BG0200 => ~Baldur's Gate, North~  BG0300 => ~Baldur's Gate, North-East~
	BG0600 => ~Baldur's Gate, West~  BG0700 => ~Baldur's Gate, Center~  BG0800 => ~Baldur's Gate, East~
	BG1100 => ~Baldur's Gate, South-West~  BG1200 => ~Baldur's Gate, South~  BG1300 => ~Baldur's Gate, South-East~
	BG2600 => ~Candlekeep~
	AR0601 => ~Irenicus' Dungeon~
	AR0602 => ~Irenicus' Dungeon~
	AR0603 => ~Irenicus' Dungeon~
	AR2900 => ~Hell~
	AR2901 => ~Hell~
	AR2902 => ~Hell~
	AR2903 => ~Hell~
	AR2904 => ~Hell~
	AR2905 => ~Hell~
	AR4500 => ~Pocket Plane~
END
ACTION_DEFINE_ASSOCIATIVE_ARRAY gm_unnamed_fr BEGIN
	BG0100 => ~Porte de Baldur, nord-ouest~  BG0200 => ~Porte de Baldur, nord~  BG0300 => ~Porte de Baldur, nord-est~
	BG0600 => ~Porte de Baldur, ouest~  BG0700 => ~Porte de Baldur, centre~  BG0800 => ~Porte de Baldur, est~
	BG1100 => ~Porte de Baldur, sud-ouest~  BG1200 => ~Porte de Baldur, sud~  BG1300 => ~Porte de Baldur, sud-est~
	BG2600 => ~Château-Suif~
	AR0601 => ~Donjon d'Irenicus~
	AR0602 => ~Donjon d'Irenicus~
	AR0603 => ~Donjon d'Irenicus~
	AR2900 => ~Enfer~
	AR2901 => ~Enfer~
	AR2902 => ~Enfer~
	AR2903 => ~Enfer~
	AR2904 => ~Enfer~
	AR2905 => ~Enfer~
	AR4500 => ~Plan de poche~
END
ACTION_PHP_EACH gm_unnamed_en AS gm_a => gm_en BEGIN
	ACTION_IF NOT VARIABLE_IS_SET $gm_wmp(~%gm_a%~) AND FILE_EXISTS_IN_GAME ~%gm_a%.are~ BEGIN
		OUTER_TEXT_SPRINT gm_text ~%gm_en%~
		ACTION_IF ~%LANGUAGE%~ STRING_EQUAL_CASE ~french~ BEGIN OUTER_TEXT_SPRINT gm_text $gm_unnamed_fr(~%gm_a%~) END
		OUTER_TEXT_SPRINT $gm_wmp(~%gm_a%~) ~%gm_text%~
		OUTER_TEXT_SPRINT gm_areas ~%gm_areas%["%gm_a%"] = [[%gm_text%]],~
	END
END
// Where each item comes from at the start of the game (build_gm_catalog.py origins(), the same): the stores that sell
// it (with the area their merchant stands in), the areas' ground piles and containers (with the container type), the
// creatures placed in the areas (their droppable items); at most 4 per kind and 12 per item. Entries
// "kind~name~area" joined by "|" in $gm_from(RES).
ACTION_CLEAR_ARRAY gm_from
ACTION_CLEAR_ARRAY gm_how
ACTION_CLEAR_ARRAY gm_spawn
// What the player can come across in play (John 2026-10-24: the Codex lists only these; build_gm_catalog.py
// obtainable(), the same). $gm_how(RES) bits: 1 found (store, ground, container), 2 carried (placed creature),
// 4 given (a script or a dialogue gives / creates it, adds it to a store), 8 table (random treasure, starting gear),
// 16 spawned (a creature a script, a dialogue, a spawn point, a rest encounter, a spawn INI or table creates carries it).
DEFINE_PATCH_MACRO ~gm_mark~ BEGIN
	TO_UPPER gm_r
	PATCH_IF NOT VARIABLE_IS_SET $gm_how(~%gm_r%~) BEGIN SET $gm_how(~%gm_r%~) = 0 END
	SET $gm_how(~%gm_r%~) = $gm_how(~%gm_r%~) BOR gm_bit
END
ACTION_CLEAR_ARRAY gm_kinds
ACTION_DEFINE_ARRAY gm_kinds BEGIN S G C K END
// the campaign of an origin's area (M_PSXGM.lua campaign(), build_gm_catalog.py area_camp): $gm_cs(RES) = the
// bitmask of ALL the item's origins (the list shown is cut at 12: the Codex filters need them all)
ACTION_CLEAR_ARRAY gm_cs
DEFINE_PATCH_MACRO ~gm_note_camp~ BEGIN
	SET gm_ac = 7
	PATCH_IF ~%gm_area%~ STRING_MATCHES_REGEXP ~^#[0-9]$~ = 0 BEGIN
		INNER_PATCH ~%gm_area%~ BEGIN READ_ASCII 1 gm_x (1) END
		SET gm_ac = gm_x
	END ELSE PATCH_IF ~%gm_area%~ STRING_MATCHES_REGEXP ~^[A-Za-z][A-Za-z][0-9][0-9][0-9][0-9].*~ = 0 BEGIN
		INNER_PATCH ~%gm_area%~ BEGIN READ_ASCII 0 gm_pre (2) READ_ASCII 2 gm_num (4) END
		TO_UPPER gm_pre
		SET gm_num = gm_num
		PATCH_IF ~%gm_pre%~ STRING_EQUAL ~BG~ BEGIN SET gm_ac = 1 END
		ELSE PATCH_IF ~%gm_pre%~ STRING_EQUAL ~BD~ BEGIN SET gm_ac = 2 END
		ELSE PATCH_IF ~%gm_pre%~ STRING_EQUAL ~BP~ BEGIN SET gm_ac = 5 END
		ELSE PATCH_IF ~%gm_pre%~ STRING_EQUAL ~OH~ BEGIN SET gm_ac = (gm_num < 4000 OR (gm_num >= 9300 AND gm_num < 9400)) ? 5 : 6 END
		ELSE PATCH_IF ~%gm_pre%~ STRING_EQUAL ~AR~ BEGIN
			SET gm_ac = (gm_num >= 4000) ? 4 : 3
			PATCH_IF ~%gm_ckind%~ STRING_EQUAL ~bgee~ BEGIN SET gm_ac = 1 END
		END
	END
	PATCH_IF NOT VARIABLE_IS_SET $gm_cs(~%gm_r%~) BEGIN SET $gm_cs(~%gm_r%~) = 0 END
	SET $gm_cs(~%gm_r%~) = $gm_cs(~%gm_r%~) BOR (1 << gm_ac)
END
DEFINE_PATCH_MACRO ~gm_add_from~ BEGIN
	TO_UPPER gm_r
	LAUNCH_PATCH_MACRO ~gm_note_camp~
	SET gm_bit = 1
	PATCH_IF ~%gm_kind%~ STRING_EQUAL ~K~ BEGIN SET gm_bit = 2 END
	PATCH_IF ~%gm_kind%~ STRING_EQUAL ~D~ BEGIN SET gm_bit = 4 END
	PATCH_IF ~%gm_kind%~ STRING_EQUAL ~T~ BEGIN SET gm_bit = 8 END
	PATCH_IF ~%gm_kind%~ STRING_EQUAL ~P~ BEGIN SET gm_bit = 16 END
	LAUNCH_PATCH_MACRO ~gm_mark~
	PATCH_IF NOT VARIABLE_IS_SET $gm_from(~%gm_r%~) BEGIN TEXT_SPRINT $gm_from(~%gm_r%~) ~~ SET $gm_n(~%gm_r%~) = 0 END
	PATCH_IF NOT VARIABLE_IS_SET $gm_k(~%gm_r%~ ~%gm_kind%~) BEGIN SET $gm_k(~%gm_r%~ ~%gm_kind%~) = 0 END
	TEXT_SPRINT gm_old $gm_from(~%gm_r%~)
	TEXT_SPRINT gm_entry "%gm_kind%~%gm_name%~%gm_area%"
	PATCH_IF $gm_k(~%gm_r%~ ~%gm_kind%~) < 4 AND $gm_n(~%gm_r%~) < 12 AND (INDEX (CASE_SENSITIVE EXACT_MATCH ~%gm_entry%|~ ~%gm_old%~) < 0) BEGIN
		TEXT_SPRINT $gm_from(~%gm_r%~) ~%gm_old%%gm_entry%|~
		SET $gm_k(~%gm_r%~ ~%gm_kind%~) += 1
		SET $gm_n(~%gm_r%~) += 1
	END
END
// An origin without an area gets its campaign from its file (John 2026-10-24; build_gm_catalog.py camp_of, the same):
// "#1" BG, "#2" SoD, "#3" SoA, "#4" ToB, "#5" the Black Pits, "#6" the Black Pits II, "" unknown. SoD files start with BD, the Black Pits'
// with BP, the Black Pits II's with OH; in a BIF (chitin.key, read only), ToB's are in 25*.bif, the Black Pits' in BlackPits.bif; EET keeps
// BG1 (and SoD) in its override, BG2 in the BIFs. $gm_bifc(TYPE NAME) = the campaign of the BIF holding it.
OUTER_TEXT_SPRINT gm_ckind ~bgee~
ACTION_IF GAME_IS ~eet~ BEGIN OUTER_TEXT_SPRINT gm_ckind ~eet~ END
ACTION_IF GAME_IS ~bg2ee~ BEGIN OUTER_TEXT_SPRINT gm_ckind ~bg2ee~ END
ACTION_CLEAR_ARRAY gm_bifc
COPY - ~chitin.key~ ~override~
	READ_LONG 0x08 gm_nb
	READ_LONG 0x0c gm_nr
	READ_LONG 0x10 gm_ob
	READ_LONG 0x14 gm_or
	FOR (i = 0; i < gm_nb; ++i) BEGIN
		READ_LONG (gm_ob + i * 12 + 4) gm_no
		READ_SHORT (gm_ob + i * 12 + 8) gm_nl
		READ_ASCII gm_no gm_bn (gm_nl) NULL
		TO_UPPER gm_bn
		SET gm_cc = 3
		PATCH_IF ~%gm_ckind%~ STRING_EQUAL ~bgee~ BEGIN SET gm_cc = 1 END
		ELSE PATCH_IF ~%gm_bn%~ STRING_MATCHES_REGEXP ~^\(DATA[/\\]\)?25.*~ = 0 BEGIN SET gm_cc = 4 END
		ELSE PATCH_IF ~%gm_bn%~ STRING_MATCHES_REGEXP ~^\(DATA[/\\]\)?BLACKP.*~ = 0 BEGIN SET gm_cc = 6 END
		ELSE PATCH_IF ~%gm_bn%~ STRING_MATCHES_REGEXP ~^\(DATA[/\\]\)?EET.*~ = 0 BEGIN SET gm_cc = (~%gm_ckind%~ STRING_EQUAL ~eet~) ? 1 : 0 END
		SET $gm_bifn(~%i%~) = gm_cc
	END
	FOR (i = 0; i < gm_nr; ++i) BEGIN
		READ_SHORT (gm_or + i * 14 + 8) gm_t
		PATCH_IF gm_t = 0x3f1 OR gm_t = 0x3f3 OR gm_t = 0x3f6 OR gm_t = 0x3ef OR gm_t = 0x3f4 BEGIN
			READ_ASCII (gm_or + i * 14) gm_n (8) NULL
			TO_UPPER gm_n
			READ_LONG (gm_or + i * 14 + 10) gm_loc
			SET gm_b = gm_loc >> 20
			SET $gm_bifc(~%gm_t%~ ~%gm_n%~) = $gm_bifn(~%gm_b%~)
		END
	END
BUT_ONLY
// gm_cn (resref) + gm_ctyp (0x3f1 CRE, 0x3f3 DLG, 0x3f6 STO, 0x3ef BCS, 0x3f4 2DA) -> gm_cmp ("#2", or "")
DEFINE_PATCH_MACRO ~gm_camp~ BEGIN
	TO_UPPER gm_cn
	SET gm_cc = 0
	PATCH_IF ~%gm_cn%~ STRING_MATCHES_REGEXP ~^BD.*~ = 0 BEGIN SET gm_cc = 2 END
	ELSE PATCH_IF ~%gm_cn%~ STRING_MATCHES_REGEXP ~^BP.*~ = 0 BEGIN SET gm_cc = 5 END
	ELSE PATCH_IF ~%gm_cn%~ STRING_MATCHES_REGEXP ~^OH.*~ = 0 BEGIN SET gm_cc = 6 END
	ELSE PATCH_IF VARIABLE_IS_SET $gm_bifc(~%gm_ctyp%~ ~%gm_cn%~) BEGIN SET gm_cc = $gm_bifc(~%gm_ctyp%~ ~%gm_cn%~) END
	ELSE PATCH_IF ~%gm_ckind%~ STRING_EQUAL ~bgee~ OR ~%gm_ckind%~ STRING_EQUAL ~eet~ BEGIN SET gm_cc = 1 END
	TEXT_SPRINT gm_cmp ~~
	PATCH_IF gm_cc > 0 BEGIN TEXT_SPRINT gm_cmp ~#%gm_cc%~ END
END
// the dialogues that open a store: $gm_dlgsto(DLG) = "STORE1,STORE2,"
ACTION_CLEAR_ARRAY gm_dlgsto
COPY_EXISTING_REGEXP GLOB ~^.+\.dlg$~ ~override~
	TEXT_SPRINT gm_d ~%SOURCE_RES%~
	TO_UPPER gm_d
	READ_ASCII 0 gm_buf (SOURCE_SIZE)
	INNER_PATCH ~%gm_buf%~ BEGIN
	REPLACE_EVALUATE CASE_INSENSITIVE ~StartStore[ %TAB%]*([ %TAB%]*"\([^"]+\)"~ BEGIN
		TEXT_SPRINT gm_s ~%MATCH1%~
		TO_UPPER gm_s
		PATCH_IF NOT VARIABLE_IS_SET $gm_dlgsto(~%gm_d%~) BEGIN TEXT_SPRINT $gm_dlgsto(~%gm_d%~) ~~ END
		TEXT_SPRINT gm_old $gm_dlgsto(~%gm_d%~)
		TEXT_SPRINT $gm_dlgsto(~%gm_d%~) ~%gm_old%%gm_s%,~
	END ~%MATCH0%~
	END
BUT_ONLY
// each creature's dialogue, name and droppable items
ACTION_CLEAR_ARRAY gm_cre
ACTION_CLEAR_ARRAY gm_credlg
ACTION_CLEAR_ARRAY gm_crenm
ACTION_CLEAR_ARRAY gm_cresc
COPY_EXISTING_REGEXP GLOB ~^.+\.cre$~ ~override~
	PATCH_IF SOURCE_SIZE > 0x2d4 BEGIN
		READ_ASCII 0 gm_sig (8)
		PATCH_IF ~%gm_sig%~ STRING_EQUAL ~CRE V1.0~ BEGIN
			TEXT_SPRINT gm_c ~%SOURCE_RES%~
			TO_UPPER gm_c
			READ_ASCII 0x2cc gm_d (8) NULL
			TO_UPPER gm_d
			TEXT_SPRINT $gm_credlg(~%gm_c%~) ~%gm_d%~
			READ_LONG 0x08 gm_s
			TEXT_SPRINT gm_text ~?~
			PATCH_IF gm_s > 0 AND gm_s < 0x7fffffff BEGIN GET_STRREF gm_s gm_text END
			TEXT_SPRINT $gm_crenm(~%gm_c%~) ~%gm_text%~
			TEXT_SPRINT gm_list ~~
			FOR (i = 0; i < 5; ++i) BEGIN
				READ_ASCII (0x248 + i * 8) gm_sc (8) NULL
				PATCH_IF STRING_LENGTH ~%gm_sc%~ > 0 BEGIN TEXT_SPRINT gm_list ~%gm_list%%gm_sc%,~ END
			END
			TEXT_SPRINT $gm_cresc(~%gm_c%~) ~%gm_list%~
			READ_LONG 0x2bc gm_io
			READ_LONG 0x2c0 gm_ic
			TEXT_SPRINT gm_list ~~
			FOR (i = 0; i < gm_ic AND gm_io + i * 0x14 + 0x14 <= SOURCE_SIZE; ++i) BEGIN
				READ_LONG (gm_io + i * 0x14 + 0x10) gm_fl
				PATCH_IF NOT (gm_fl BAND 8) BEGIN
					READ_ASCII (gm_io + i * 0x14) gm_r (8) NULL
					TEXT_SPRINT gm_list ~%gm_list%%gm_r%,~
				END
			END
			PATCH_IF NOT ~%gm_list%~ STRING_EQUAL ~~ BEGIN
				TEXT_SPRINT $gm_cre(~%gm_c%~) ~%gm_list%~
				TEXT_SPRINT $gm_cren(~%gm_c%~) ~%gm_text%~
			END
		END
	END
BUT_ONLY
// the areas: piles, containers (with their type), actors (their items; the store their dialogue opens stands here),
// travel regions (type 2: $gm_adj(AREA) = "NEIGHBOUR1,NEIGHBOUR2,", both ways)
ACTION_CLEAR_ARRAY gm_adj
ACTION_CLEAR_ARRAY gm_storeat
// who runs a dialogue (D) or a script (B), for the given / spawned origins: $gm_ownn(T KEY) its name, $gm_owna(T KEY)
// its area; more than 2 different owners = a generic one (no name, no area)
ACTION_CLEAR_ARRAY gm_ownn
ACTION_CLEAR_ARRAY gm_owna
ACTION_CLEAR_ARRAY gm_ownk
ACTION_CLEAR_ARRAY gm_placed
DEFINE_PATCH_MACRO ~gm_own~ BEGIN
	TO_UPPER gm_ok
	PATCH_IF STRING_LENGTH ~%gm_ok%~ > 0 BEGIN
		PATCH_IF NOT VARIABLE_IS_SET $gm_ownk(~%gm_ot%~ ~%gm_ok%~) BEGIN
			SET $gm_ownk(~%gm_ot%~ ~%gm_ok%~) = 1
			TEXT_SPRINT $gm_ownn(~%gm_ot%~ ~%gm_ok%~) ~%gm_on%~
			TEXT_SPRINT $gm_owna(~%gm_ot%~ ~%gm_ok%~) ~%gm_oa%~
		END ELSE BEGIN
			TEXT_SPRINT gm_x1 $gm_ownn(~%gm_ot%~ ~%gm_ok%~)
			TEXT_SPRINT gm_x2 $gm_owna(~%gm_ot%~ ~%gm_ok%~)
			PATCH_IF NOT (~%gm_x1%~ STRING_EQUAL ~%gm_on%~ AND ~%gm_x2%~ STRING_EQUAL ~%gm_oa%~) BEGIN
				SET $gm_ownk(~%gm_ot%~ ~%gm_ok%~) += 1
			END
		END
	END
END
DEFINE_PATCH_MACRO ~gm_owner~ BEGIN
	TO_UPPER gm_ok
	TEXT_SPRINT gm_who ~~
	TEXT_SPRINT gm_wa ~~
	PATCH_IF VARIABLE_IS_SET $gm_ownk(~%gm_ot%~ ~%gm_ok%~) BEGIN
		PATCH_IF $gm_ownk(~%gm_ot%~ ~%gm_ok%~) <= 2 BEGIN
			TEXT_SPRINT gm_who $gm_ownn(~%gm_ot%~ ~%gm_ok%~)
			TEXT_SPRINT gm_wa $gm_owna(~%gm_ot%~ ~%gm_ok%~)
		END
	END
END
DEFINE_PATCH_MACRO ~gm_link~ BEGIN
	PATCH_IF NOT VARIABLE_IS_SET $gm_adj(~%gm_x%~) BEGIN TEXT_SPRINT $gm_adj(~%gm_x%~) ~~ END
	TEXT_SPRINT gm_old $gm_adj(~%gm_x%~)
	PATCH_IF INDEX (CASE_SENSITIVE EXACT_MATCH ~,%gm_y%,~ ~,%gm_old%~) < 0 BEGIN TEXT_SPRINT $gm_adj(~%gm_x%~) ~%gm_old%%gm_y%,~ END
END
COPY_EXISTING_REGEXP GLOB ~^.+\.are$~ ~override~
	PATCH_IF SOURCE_SIZE >= 0x11c BEGIN
		TEXT_SPRINT gm_area ~%SOURCE_RES%~
		TO_UPPER gm_area
		READ_ASCII 0x94 gm_ok (8) NULL
		TEXT_SPRINT gm_ot ~B~ TEXT_SPRINT gm_on ~~ TEXT_SPRINT gm_oa ~%gm_area%~
		LAUNCH_PATCH_MACRO ~gm_own~
		READ_LONG 0x70 gm_co
		READ_SHORT 0x74 gm_cc
		READ_LONG 0x78 gm_io
		FOR (c = 0; c < gm_cc AND gm_co + c * 0xc0 + 0xc0 <= SOURCE_SIZE; ++c) BEGIN
			READ_SHORT (gm_co + c * 0xc0 + 0x24) gm_ct
			READ_LONG (gm_co + c * 0xc0 + 0x40) gm_first
			READ_LONG (gm_co + c * 0xc0 + 0x44) gm_cnt
			PATCH_IF gm_ct = 4 BEGIN TEXT_SPRINT gm_kind ~G~ TEXT_SPRINT gm_name ~~ END
			ELSE BEGIN TEXT_SPRINT gm_kind ~C~ TEXT_SPRINT gm_name ~%gm_ct%~ END
			FOR (i = gm_first; i < gm_first + gm_cnt AND gm_io + i * 0x14 + 0x14 <= SOURCE_SIZE; ++i) BEGIN
				READ_ASCII (gm_io + i * 0x14) gm_r (8) NULL
				LAUNCH_PATCH_MACRO ~gm_add_from~
			END
		END
		READ_SHORT 0x5a gm_rc
		READ_LONG 0x5c gm_roff
		FOR (r = 0; r < gm_rc AND gm_roff + r * 0xc4 + 0xc4 <= SOURCE_SIZE; ++r) BEGIN
			READ_SHORT (gm_roff + r * 0xc4 + 0x20) gm_rt
			READ_ASCII (gm_roff + r * 0xc4 + 0x38) gm_dest (8) NULL
			TO_UPPER gm_dest
			PATCH_IF gm_rt = 2 AND STRING_LENGTH ~%gm_dest%~ > 0 AND NOT ~%gm_dest%~ STRING_EQUAL ~%gm_area%~ BEGIN
				TEXT_SPRINT gm_x ~%gm_area%~ TEXT_SPRINT gm_y ~%gm_dest%~ LAUNCH_PATCH_MACRO ~gm_link~
				TEXT_SPRINT gm_x ~%gm_dest%~ TEXT_SPRINT gm_y ~%gm_area%~ LAUNCH_PATCH_MACRO ~gm_link~
			END
		END
		READ_LONG 0x54 gm_ao
		READ_SHORT 0x58 gm_ac
		FOR (a = 0; a < gm_ac AND gm_ao + a * 0x110 + 0x110 <= SOURCE_SIZE; ++a) BEGIN
			READ_ASCII (gm_ao + a * 0x110 + 0x80) gm_c (8) NULL
			TO_UPPER gm_c
			READ_ASCII (gm_ao + a * 0x110 + 0x48) gm_d (8) NULL
			TO_UPPER gm_d
			PATCH_IF STRING_LENGTH ~%gm_d%~ = 0 AND VARIABLE_IS_SET $gm_credlg(~%gm_c%~) BEGIN TEXT_SPRINT gm_d $gm_credlg(~%gm_c%~) END
			SET $gm_placed(~%gm_c%~) = 1
			TEXT_SPRINT gm_on ~~
			PATCH_IF VARIABLE_IS_SET $gm_crenm(~%gm_c%~) BEGIN TEXT_SPRINT gm_on $gm_crenm(~%gm_c%~) END
			TEXT_SPRINT gm_oa ~%gm_area%~
			TEXT_SPRINT gm_ot ~D~ TEXT_SPRINT gm_ok ~%gm_d%~
			LAUNCH_PATCH_MACRO ~gm_own~
			TEXT_SPRINT gm_ot ~B~
			FOR (k = 0; k < 6; ++k) BEGIN
				READ_ASCII (gm_ao + a * 0x110 + 0x50 + k * 8) gm_ok (8) NULL
				LAUNCH_PATCH_MACRO ~gm_own~
			END
			PATCH_IF VARIABLE_IS_SET $gm_cresc(~%gm_c%~) BEGIN
				TEXT_SPRINT gm_list $gm_cresc(~%gm_c%~)
				INNER_PATCH ~%gm_list%~ BEGIN
					REPLACE_EVALUATE ~\([^,]+\),~ BEGIN TEXT_SPRINT gm_ok ~%MATCH1%~ LAUNCH_PATCH_MACRO ~gm_own~ END ~%MATCH0%~
				END
			END
			PATCH_IF STRING_LENGTH ~%gm_d%~ > 0 AND VARIABLE_IS_SET $gm_dlgsto(~%gm_d%~) BEGIN
				TEXT_SPRINT gm_list $gm_dlgsto(~%gm_d%~)
				INNER_PATCH ~%gm_list%~ BEGIN
					REPLACE_EVALUATE ~\([^,]+\),~ BEGIN
						TEXT_SPRINT gm_s ~%MATCH1%~
						PATCH_IF NOT VARIABLE_IS_SET $gm_storeat(~%gm_s%~) BEGIN TEXT_SPRINT $gm_storeat(~%gm_s%~) ~%gm_area%~ END
					END ~%MATCH0%~
				END
			END
			PATCH_IF VARIABLE_IS_SET $gm_cre(~%gm_c%~) BEGIN
				TEXT_SPRINT gm_kind ~K~
				TEXT_SPRINT gm_name $gm_cren(~%gm_c%~)
				TEXT_SPRINT gm_list $gm_cre(~%gm_c%~)
				INNER_PATCH ~%gm_list%~ BEGIN
					REPLACE_EVALUATE ~\([^,]+\),~ BEGIN
						TEXT_SPRINT gm_r ~%MATCH1%~
						LAUNCH_PATCH_MACRO ~gm_add_from~
					END ~~
				END
			END
		END
	END
BUT_ONLY
// the stores: their items (S entries with the merchant's area), their type and name (an inn / tavern / temple names
// the building it stands in)
ACTION_CLEAR_ARRAY gm_bld
COPY_EXISTING_REGEXP GLOB ~^.+\.sto$~ ~override~
	PATCH_IF SOURCE_SIZE >= 0x9c BEGIN
		READ_LONG 0x08 gm_t
		READ_LONG 0x0c gm_s
		PATCH_IF gm_t <= 3 BEGIN
			TEXT_SPRINT gm_sres ~%SOURCE_RES%~
			TO_UPPER gm_sres
			TEXT_SPRINT gm_name ~%gm_sres%~
			PATCH_IF gm_s > 0 AND gm_s < 0x7fffffff BEGIN
				GET_STRREF gm_s gm_text
				PATCH_IF STRING_LENGTH ~%gm_text%~ > 0 AND STRING_LENGTH ~%gm_text%~ <= 40 BEGIN TEXT_SPRINT gm_name ~%gm_text%~ END
			END
			TEXT_SPRINT gm_area ~~
			PATCH_IF VARIABLE_IS_SET $gm_storeat(~%gm_sres%~) BEGIN TEXT_SPRINT gm_area $gm_storeat(~%gm_sres%~) END
			ELSE BEGIN TEXT_SPRINT gm_cn ~%gm_sres%~ SET gm_ctyp = 0x3f6 LAUNCH_PATCH_MACRO ~gm_camp~ TEXT_SPRINT gm_bcmp ~%gm_cmp%~ END
			PATCH_IF gm_t >= 1 AND STRING_LENGTH ~%gm_area%~ > 0 BEGIN
				PATCH_IF NOT VARIABLE_IS_SET $gm_wmp(~%gm_area%~) AND NOT VARIABLE_IS_SET $gm_bld(~%gm_area%~) BEGIN
					TEXT_SPRINT $gm_bld(~%gm_area%~) ~%gm_name%~
				END
			END
			READ_LONG 0x34 gm_io
			READ_LONG 0x38 gm_ic
			FOR (i = 0; i < gm_ic AND gm_io + i * 0x1c + 0x1c <= SOURCE_SIZE; ++i) BEGIN
				READ_ASCII (gm_io + i * 0x1c) gm_r (8) NULL
				READ_LONG (gm_io + i * 0x1c + 0x14) gm_st
				READ_LONG (gm_io + i * 0x1c + 0x18) gm_inf
				PATCH_IF gm_st > 0 OR (gm_inf BAND 1) BEGIN
					TEXT_SPRINT gm_kind ~S~
					PATCH_IF STRING_LENGTH ~%gm_area%~ = 0 BEGIN TEXT_SPRINT gm_area ~%gm_bcmp%~ END
					LAUNCH_PATCH_MACRO ~gm_add_from~
				END
			END
		END
	END
BUT_ONLY
// readable places: an area with a world map caption keeps it; another takes the nearest captioned area through the
// travel regions (at most 6 steps), and the building its inn / tavern / temple names ("Beregost - Jovial Juggler")
DEFINE_ACTION_MACRO ~gm_outer~ BEGIN
	OUTER_TEXT_SPRINT gm_out ~~
	OUTER_TEXT_SPRINT gm_queue ~%gm_start%,~
	OUTER_TEXT_SPRINT gm_seenq ~,%gm_start%,~
	OUTER_FOR (gm_depth = 0; gm_depth < 7 AND STRING_LENGTH ~%gm_out%~ = 0 AND STRING_LENGTH ~%gm_queue%~ > 0; ++gm_depth) BEGIN
		OUTER_TEXT_SPRINT gm_next ~~
		OUTER_INNER_PATCH ~%gm_queue%~ BEGIN
			REPLACE_EVALUATE ~\([^,]+\),~ BEGIN
				TEXT_SPRINT gm_q ~%MATCH1%~
				PATCH_IF STRING_LENGTH ~%gm_out%~ = 0 BEGIN
					PATCH_IF VARIABLE_IS_SET $gm_wmp(~%gm_q%~) BEGIN
						TEXT_SPRINT gm_out $gm_wmp(~%gm_q%~)
					END ELSE PATCH_IF VARIABLE_IS_SET $gm_adj(~%gm_q%~) BEGIN
						TEXT_SPRINT gm_nb $gm_adj(~%gm_q%~)
						INNER_PATCH ~%gm_nb%~ BEGIN
							REPLACE_EVALUATE ~\([^,]+\),~ BEGIN
								TEXT_SPRINT gm_z ~%MATCH1%~
								PATCH_IF INDEX (CASE_SENSITIVE EXACT_MATCH ~,%gm_z%,~ ~%gm_seenq%~) < 0 BEGIN
									TEXT_SPRINT gm_seenq ~%gm_seenq%%gm_z%,~
									TEXT_SPRINT gm_next ~%gm_next%%gm_z%,~
								END
							END ~%MATCH0%~
						END
					END
				END
			END ~%MATCH0%~
		END
		OUTER_TEXT_SPRINT gm_queue ~%gm_next%~
	END
END
ACTION_CLEAR_ARRAY gm_todo
ACTION_PHP_EACH gm_adj AS gm_a => gm_v BEGIN OUTER_SET $gm_todo(~%gm_a%~) = 1 END
ACTION_PHP_EACH gm_wmp AS gm_a => gm_v BEGIN OUTER_SET $gm_todo(~%gm_a%~) = 1 END
ACTION_PHP_EACH gm_storeat AS gm_s => gm_a BEGIN OUTER_SET $gm_todo(~%gm_a%~) = 1 END
OUTER_TEXT_SPRINT gm_places ~~
ACTION_PHP_EACH gm_todo AS gm_a => gm_v BEGIN
	OUTER_TEXT_SPRINT gm_label ~~
	ACTION_IF VARIABLE_IS_SET $gm_wmp(~%gm_a%~) BEGIN
		OUTER_TEXT_SPRINT gm_label $gm_wmp(~%gm_a%~)
	END ELSE BEGIN
		OUTER_TEXT_SPRINT gm_start ~%gm_a%~
		LAUNCH_ACTION_MACRO ~gm_outer~
		OUTER_TEXT_SPRINT gm_label ~%gm_out%~
		ACTION_IF VARIABLE_IS_SET $gm_bld(~%gm_a%~) BEGIN
			OUTER_TEXT_SPRINT gm_b $gm_bld(~%gm_a%~)
			ACTION_IF STRING_LENGTH ~%gm_label%~ > 0 BEGIN OUTER_TEXT_SPRINT gm_label ~%gm_label% - %gm_b%~ END
			ELSE BEGIN OUTER_TEXT_SPRINT gm_label ~%gm_b%~ END
		END
	END
	ACTION_IF STRING_LENGTH ~%gm_label%~ > 0 BEGIN
		OUTER_TEXT_SPRINT gm_places ~%gm_places%["%gm_a%"] = [[%gm_label%]],~
	END
END
OUTER_TEXT_SPRINT gm_storeats ~~
ACTION_PHP_EACH gm_storeat AS gm_s => gm_a BEGIN
	OUTER_TEXT_SPRINT gm_storeats ~%gm_storeats%["%gm_s%"] = "%gm_a%",~
END
// the creatures with no area (joinable NPCs, created ones) own the dialogues and scripts nobody placed runs
ACTION_PHP_EACH gm_crenm AS gm_c => gm_n BEGIN
	ACTION_IF NOT VARIABLE_IS_SET $gm_placed(~%gm_c%~) BEGIN
		OUTER_PATCH ~~ BEGIN
			TEXT_SPRINT gm_on ~%gm_n%~ TEXT_SPRINT gm_oa ~~
			TEXT_SPRINT gm_ok $gm_credlg(~%gm_c%~) TEXT_SPRINT gm_ot ~D~
			PATCH_IF NOT VARIABLE_IS_SET $gm_ownk(~D~ ~%gm_ok%~) BEGIN LAUNCH_PATCH_MACRO ~gm_own~ END
			TEXT_SPRINT gm_list $gm_cresc(~%gm_c%~) TEXT_SPRINT gm_ot ~B~
			INNER_PATCH ~%gm_list%~ BEGIN
				REPLACE_EVALUATE ~\([^,]+\),~ BEGIN
					TEXT_SPRINT gm_ok ~%MATCH1%~
					TO_UPPER gm_ok
					PATCH_IF NOT VARIABLE_IS_SET $gm_ownk(~B~ ~%gm_ok%~) BEGIN LAUNCH_PATCH_MACRO ~gm_own~ END
				END ~%MATCH0%~
			END
		END
	END
END
// a created creature and the area it appears in: $gm_spawn(CRE) = "AREA1,AREA2," ("-" = not known)
DEFINE_PATCH_MACRO ~gm_spawn_add~ BEGIN
	TO_UPPER gm_c
	PATCH_IF STRING_LENGTH ~%gm_sa%~ = 0 BEGIN TEXT_SPRINT gm_sa ~-~ END
	PATCH_IF NOT VARIABLE_IS_SET $gm_spawn(~%gm_c%~) BEGIN TEXT_SPRINT $gm_spawn(~%gm_c%~) ~~ END
	TEXT_SPRINT gm_old $gm_spawn(~%gm_c%~)
	PATCH_IF INDEX (CASE_SENSITIVE EXACT_MATCH ~,%gm_sa%,~ ~,%gm_old%~) < 0 BEGIN TEXT_SPRINT $gm_spawn(~%gm_c%~) ~%gm_old%%gm_sa%,~ END
END
// compiled scripts: AC <id> + 3 objects + the action's own strings ([^ -}] = the line break)
// Only the item / creature actions below are matched, and only in scripts that hold one: matching every action
// of every script cost 19 minutes on a big EET install (REPLACE_EVALUATE rebuilds the buffer at each match).
OUTER_TEXT_SPRINT gm_acts ~\(7\|82\|140\|227\|228\|231\|232\|233\|238\|246\|250\|252\|256\|295\|323\|363\)~
COPY_EXISTING_REGEXP GLOB ~^.+\.bcs$~ ~override~
	SET gm_hit = 0
	PATCH_FOR_EACH gm_i IN 7 82 140 227 228 231 232 233 238 246 250 252 256 295 323 363 BEGIN
		PATCH_IF gm_hit = 0 AND INDEX_BUFFER (CASE_SENSITIVE EXACT_MATCH ~AC%LNL%%gm_i%OB~) >= 0 BEGIN SET gm_hit = 1 END
	END
	PATCH_IF gm_hit BEGIN
	TEXT_SPRINT gm_ok ~%SOURCE_RES%~ TEXT_SPRINT gm_ot ~B~
	LAUNCH_PATCH_MACRO ~gm_owner~
	PATCH_IF STRING_LENGTH ~%gm_wa%~ = 0 BEGIN TEXT_SPRINT gm_cn ~%SOURCE_RES%~ SET gm_ctyp = 0x3ef LAUNCH_PATCH_MACRO ~gm_camp~ TEXT_SPRINT gm_wa ~%gm_cmp%~ END
	READ_ASCII 0 gm_buf (SOURCE_SIZE)
	INNER_PATCH ~%gm_buf%~ BEGIN
	REPLACE_EVALUATE ~AC[^ -}]%gm_acts%OB[^"]*"[^"]*"OB[^"]*"[^"]*"OB[^"]*"[^"]*"OB[^"]*"\([^"]*\)" "\([^"]*\)" AC~ BEGIN
		SET gm_id = MATCH1
		TEXT_SPRINT gm_s1 ~%MATCH2%~
		TEXT_SPRINT gm_s2 ~%MATCH3%~
		PATCH_IF gm_id = 82 OR gm_id = 140 OR gm_id = 256 OR gm_id = 363 BEGIN
			TEXT_SPRINT gm_kind ~D~ TEXT_SPRINT gm_name ~%gm_who%~ TEXT_SPRINT gm_area ~%gm_wa%~
			TEXT_SPRINT gm_r ~%gm_s1%~ PATCH_IF STRING_LENGTH ~%gm_r%~ BEGIN LAUNCH_PATCH_MACRO ~gm_add_from~ END
			TEXT_SPRINT gm_r ~%gm_s2%~ PATCH_IF STRING_LENGTH ~%gm_r%~ BEGIN LAUNCH_PATCH_MACRO ~gm_add_from~ END
		END ELSE PATCH_IF gm_id = 7 OR gm_id = 227 OR gm_id = 228 OR (gm_id >= 231 AND gm_id <= 233) OR gm_id = 238
				OR gm_id = 246 OR gm_id = 250 OR gm_id = 252 OR gm_id = 295 OR gm_id = 323 BEGIN
			TEXT_SPRINT gm_sa ~%gm_wa%~
			TEXT_SPRINT gm_c ~%gm_s1%~ PATCH_IF STRING_LENGTH ~%gm_c%~ BEGIN LAUNCH_PATCH_MACRO ~gm_spawn_add~ END
			TEXT_SPRINT gm_sa ~%gm_wa%~
			TEXT_SPRINT gm_c ~%gm_s2%~ PATCH_IF STRING_LENGTH ~%gm_c%~ BEGIN LAUNCH_PATCH_MACRO ~gm_spawn_add~ END
		END
	END ~%MATCH0%~
	END
	END
BUT_ONLY
// dialogues keep their actions as text (scanned in a copy: nothing is written)
COPY_EXISTING_REGEXP GLOB ~^.+\.dlg$~ ~override~
	TEXT_SPRINT gm_ok ~%SOURCE_RES%~ TEXT_SPRINT gm_ot ~D~
	LAUNCH_PATCH_MACRO ~gm_owner~
	PATCH_IF STRING_LENGTH ~%gm_wa%~ = 0 BEGIN TEXT_SPRINT gm_cn ~%SOURCE_RES%~ SET gm_ctyp = 0x3f3 LAUNCH_PATCH_MACRO ~gm_camp~ TEXT_SPRINT gm_wa ~%gm_cmp%~ END
	READ_ASCII 0 gm_buf (SOURCE_SIZE)
	INNER_PATCH ~%gm_buf%~ BEGIN
	REPLACE_EVALUATE ~\(GiveItemCreate\|CreateItem\|CreateItemGlobal\|AddStoreItem\)[ %TAB%]*(\([^)]*\))~ BEGIN
		INNER_PATCH ~%MATCH2%~ BEGIN
			REPLACE_EVALUATE ~"\([^"]+\)"~ BEGIN
				TEXT_SPRINT gm_r ~%MATCH1%~
				TEXT_SPRINT gm_kind ~D~ TEXT_SPRINT gm_name ~%gm_who%~ TEXT_SPRINT gm_area ~%gm_wa%~
				LAUNCH_PATCH_MACRO ~gm_add_from~
			END ~%MATCH0%~
		END
	END ~%MATCH0%~
	REPLACE_EVALUATE ~CreateCreature[A-Za-z]*[ %TAB%]*(\([^)]*\))~ BEGIN
		INNER_PATCH ~%MATCH1%~ BEGIN
			REPLACE_EVALUATE ~"\([^"]+\)"~ BEGIN TEXT_SPRINT gm_c ~%MATCH1%~ TEXT_SPRINT gm_sa ~%gm_wa%~ LAUNCH_PATCH_MACRO ~gm_spawn_add~ END ~%MATCH0%~
		END
	END ~%MATCH0%~
	END
BUT_ONLY
// random treasure and starting gear tables (items), random spawn and NPC level tables (creatures), spawn INIs
ACTION_FOR_EACH gm_t IN rndtres rndtreas rndscrol rndequip rndwep rndmagic 25stweap mpstweap bdstweap BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%gm_t%.2da~ BEGIN
		COPY_EXISTING ~%gm_t%.2da~ ~override~
			TEXT_SPRINT gm_cn ~%gm_t%~ SET gm_ctyp = 0x3f4 LAUNCH_PATCH_MACRO ~gm_camp~
			READ_ASCII 0 gm_buf (SOURCE_SIZE)
			INNER_PATCH ~%gm_buf%~ BEGIN
			REPLACE_EVALUATE ~[A-Za-z0-9_#!$-]+~ BEGIN
				TEXT_SPRINT gm_r ~%MATCH0%~
				PATCH_IF STRING_LENGTH ~%gm_r%~ <= 8 BEGIN
					PATCH_IF FILE_EXISTS_IN_GAME ~%gm_r%.itm~ BEGIN
						TEXT_SPRINT gm_kind ~T~ TEXT_SPRINT gm_name ~~ TEXT_SPRINT gm_area ~%gm_cmp%~
						LAUNCH_PATCH_MACRO ~gm_add_from~
					END
				END
			END ~%MATCH0%~
			END
		BUT_ONLY
	END
END
ACTION_FOR_EACH gm_t IN spawngrp npclvlds BEGIN
	ACTION_IF FILE_EXISTS_IN_GAME ~%gm_t%.2da~ BEGIN
		COPY_EXISTING ~%gm_t%.2da~ ~override~
			READ_ASCII 0 gm_buf (SOURCE_SIZE)
			INNER_PATCH ~%gm_buf%~ BEGIN
			REPLACE_EVALUATE ~[A-Za-z0-9_#!$-]+~ BEGIN TEXT_SPRINT gm_c ~%MATCH0%~ TEXT_SPRINT gm_sa ~~ LAUNCH_PATCH_MACRO ~gm_spawn_add~ END ~%MATCH0%~
			END
		BUT_ONLY
	END
END
COPY_EXISTING_REGEXP GLOB ~^.+\.ini$~ ~override~
	TEXT_SPRINT gm_ia ~~
	PATCH_IF FILE_EXISTS_IN_GAME ~%SOURCE_RES%.are~ BEGIN TEXT_SPRINT gm_ia ~%SOURCE_RES%~ TO_UPPER gm_ia END
	READ_ASCII 0 gm_buf (SOURCE_SIZE)
	INNER_PATCH ~%gm_buf%~ BEGIN
	REPLACE_EVALUATE ~[A-Za-z0-9_#!$-]+~ BEGIN TEXT_SPRINT gm_c ~%MATCH0%~ TEXT_SPRINT gm_sa ~%gm_ia%~ LAUNCH_PATCH_MACRO ~gm_spawn_add~ END ~%MATCH0%~
	END
BUT_ONLY
// the areas' spawn points and rest encounters
COPY_EXISTING_REGEXP GLOB ~^.+\.are$~ ~override~
	PATCH_IF SOURCE_SIZE >= 0x11c BEGIN
		TEXT_SPRINT gm_ia ~%SOURCE_RES%~
		TO_UPPER gm_ia
		READ_LONG 0x60 gm_so
		READ_SHORT 0x64 gm_sc
		FOR (s = 0; s < gm_sc AND gm_so + s * 0xc8 + 0xc8 <= SOURCE_SIZE; ++s) BEGIN
			READ_SHORT (gm_so + s * 0xc8 + 0x74) gm_n
			FOR (k = 0; k < gm_n AND k < 10; ++k) BEGIN
				READ_ASCII (gm_so + s * 0xc8 + 0x24 + k * 8) gm_c (8) NULL
				PATCH_IF STRING_LENGTH ~%gm_c%~ BEGIN TEXT_SPRINT gm_sa ~%gm_ia%~ LAUNCH_PATCH_MACRO ~gm_spawn_add~ END
			END
		END
		READ_LONG 0xc0 gm_ro
		PATCH_IF gm_ro > 0 AND gm_ro + 0xe4 <= SOURCE_SIZE BEGIN
			FOR (k = 0; k < 10; ++k) BEGIN
				READ_ASCII (gm_ro + 0x48 + k * 8) gm_c (8) NULL
				PATCH_IF STRING_LENGTH ~%gm_c%~ BEGIN TEXT_SPRINT gm_sa ~%gm_ia%~ LAUNCH_PATCH_MACRO ~gm_spawn_add~ END
			END
		END
	END
BUT_ONLY
// what the created creatures carry (their droppable items, read above in $gm_cre)
ACTION_PHP_EACH gm_spawn AS gm_c => gm_v BEGIN
	ACTION_IF VARIABLE_IS_SET $gm_cre(~%gm_c%~) BEGIN
		OUTER_PATCH ~~ BEGIN
			TEXT_SPRINT gm_areas2 ~%gm_v%~
			PATCH_IF NOT ~%gm_areas2%~ STRING_EQUAL ~-,~ BEGIN
				INNER_PATCH_SAVE gm_areas2 ~%gm_areas2%~ BEGIN REPLACE_TEXTUALLY EXACT_MATCH ~-,~ ~~ END
			END
			TEXT_SPRINT gm_list $gm_cre(~%gm_c%~)
			TEXT_SPRINT gm_name $gm_cren(~%gm_c%~)
			TEXT_SPRINT gm_kind ~P~
			INNER_PATCH ~%gm_areas2%~ BEGIN
				REPLACE_EVALUATE ~\([^,]+\),~ BEGIN
					TEXT_SPRINT gm_area ~%MATCH1%~
					PATCH_IF ~%gm_area%~ STRING_EQUAL ~-~ BEGIN
						TEXT_SPRINT gm_cn ~%gm_c%~ SET gm_ctyp = 0x3f1 LAUNCH_PATCH_MACRO ~gm_camp~ TEXT_SPRINT gm_area ~%gm_cmp%~
					END
					INNER_PATCH ~%gm_list%~ BEGIN
						REPLACE_EVALUATE ~\([^,]+\),~ BEGIN TEXT_SPRINT gm_r ~%MATCH1%~ LAUNCH_PATCH_MACRO ~gm_add_from~ END ~%MATCH0%~
					END
				END ~%MATCH0%~
			END
		END
	END
END
// the encyclopedia: every item with an icon and a name (gold left out) that the player can come across; an item only
// a creature carries must be droppable (ITM flag 0x4: no monster weapons, creature immunity rings...)
OUTER_TEXT_SPRINT gm_all ~~
OUTER_TEXT_SPRINT gm_camps ~~
COPY_EXISTING_REGEXP GLOB ~^.+\.itm$~ ~override~
	PATCH_IF SOURCE_SIZE > 0x71 BEGIN
		TEXT_SPRINT gm_res ~%SOURCE_RES%~
		TO_UPPER gm_res
		SET gm_h = 0
		PATCH_IF VARIABLE_IS_SET $gm_how(~%gm_res%~) BEGIN SET gm_h = $gm_how(~%gm_res%~) END
		READ_LONG 0x18 gm_iflags
		READ_SHORT 0x1c gm_type
		READ_ASCII 0x3a gm_icon (8) NULL
		READ_LONG 0x0c gm_name
		PATCH_IF gm_name <= 0 OR gm_name >= 0x7fffffff BEGIN READ_LONG 0x08 gm_name END
		PATCH_IF ((gm_h BAND 13) OR (gm_h AND (gm_iflags BAND 4))) AND gm_type != 33 AND gm_name > 0 AND gm_name < 0x7fffffff AND FILE_EXISTS_IN_GAME ~%gm_icon%.bam~ BEGIN
			GET_STRREF gm_name gm_text
			PATCH_IF NOT ~%gm_text%~ STRING_EQUAL ~~ BEGIN
				TEXT_SPRINT gm_all ~%gm_all%'%gm_res%',~
				PATCH_IF VARIABLE_IS_SET $gm_cs(~%gm_res%~) BEGIN
					SET gm_m = $gm_cs(~%gm_res%~)
					TEXT_SPRINT gm_camps ~%gm_camps%["%gm_res%"] = %gm_m%,~
				END
			END
		END
	END
BUT_ONLY
OUTER_TEXT_SPRINT gm_froms ~~
ACTION_PHP_EACH gm_from AS gm_r => gm_v BEGIN
	OUTER_TEXT_SPRINT gm_froms ~%gm_froms%["%gm_r%"] = [[%gm_v%]],~
END
// the game: on BGEE the AR areas are BG1's, on BG2EE and EET BG2's (the origins' campaigns)
OUTER_TEXT_SPRINT gm_game ~bgee~
ACTION_IF GAME_IS ~eet~ BEGIN OUTER_TEXT_SPRINT gm_game ~eet~ END
ACTION_IF GAME_IS ~bg2ee~ BEGIN OUTER_TEXT_SPRINT gm_game ~bg2ee~ END
<<<<<<<< .../SadoEE-inlined/M_PSXCAT.lua
-- Written by the installer (SadoEE.tp2 #8): the camp chest encyclopedia and the area names.
PSXGM_ALL = { GM_ALL_LIST }
PSXGM_AREAS = { GM_AREA_LIST }
PSXGM_FROM = { GM_FROM_LIST }
PSXGM_PLACES = { GM_PLACE_LIST }
PSXGM_STOREAT = { GM_STOREAT_LIST }
PSXGM_GAME = "GAMEKIND_VALUE"
PSXGM_CAMPS = { CAMPMASK_LIST_VALUE }
>>>>>>>>
COPY ~.../SadoEE-inlined/M_PSXCAT.lua~ ~override~
	REPLACE_TEXTUALLY EXACT_MATCH ~GM_ALL_LIST~ ~%gm_all%~
	REPLACE_TEXTUALLY EXACT_MATCH ~GM_AREA_LIST~ ~%gm_areas%~
	REPLACE_TEXTUALLY EXACT_MATCH ~GM_FROM_LIST~ ~%gm_froms%~
	REPLACE_TEXTUALLY EXACT_MATCH ~GM_PLACE_LIST~ ~%gm_places%~
	REPLACE_TEXTUALLY EXACT_MATCH ~GM_STOREAT_LIST~ ~%gm_storeats%~
	REPLACE_TEXTUALLY EXACT_MATCH ~GAMEKIND_VALUE~ ~%gm_game%~
	REPLACE_TEXTUALLY EXACT_MATCH ~CAMPMASK_LIST_VALUE~ ~%gm_camps%~
// the page's two notice board backgrounds (art/build_gm_board.py), swapped in game
COPY ~SadoEE/PSXGMBA.MOS~ ~override~
     ~SadoEE/PSXGMBB.MOS~ ~override~
// paper ticket buttons and the pencil circle of the chosen category
COPY ~SadoEE/PSXGMBN1.BAM~ ~override~
     ~SadoEE/PSXGMBN2.BAM~ ~override~
     ~SadoEE/PSXGMBN3.BAM~ ~override~
     ~SadoEE/PSXGMBN4.BAM~ ~override~
     ~SadoEE/PSXGMCIR.BAM~ ~override~
// the title in charcoal is drawn, not typed: French or English lettering (other languages: English for now)
ACTION_IF ~%LANGUAGE%~ STRING_EQUAL_CASE ~french~ BEGIN
	COPY ~SadoEE/PSXGMTFR.BAM~ ~override/PSXGMTT.BAM~
END ELSE BEGIN
	COPY ~SadoEE/PSXGMTEN.BAM~ ~override/PSXGMTT.BAM~
END
// Decard's Codex page (the chest mode, John 2026-10-24): the same word in every language
COPY ~SadoEE/PSXGMTC.BAM~ ~override~

// the camp merchant himself (was in SadoQoL #10), from Belegarm's creature (SoD's quartermaster)
// the camp merchant's voice: the BG1 merchants' (MERCHA), read here: SadoEE installs the merchant as its own component
// (BG2EE has neither MERCHA nor Belegarm: the Athkatla merchant's AEMERCH for both, John 2026-10-25)
OUTER_SET sq_voice_merch = 0
OUTER_SPRINT sq_vm_cre ~MERCHA~
ACTION_IF !FILE_EXISTS_IN_GAME ~mercha.cre~ BEGIN OUTER_SPRINT sq_vm_cre ~AEMERCH~ END
ACTION_IF FILE_EXISTS_IN_GAME ~%sq_vm_cre%.cre~ BEGIN
	OUTER_SET sq_voice_merch = 1
	COPY_EXISTING ~%sq_vm_cre%.CRE~ ~override~
		FOR (i = 0; i < 100; i += 1) BEGIN READ_LONG (0xa4 + i * 4) EVAL ~sq_vm_%i%~ END
	BUT_ONLY
END
OUTER_SPRINT sq_merch_base ~BDBELEGA~
ACTION_IF !FILE_EXISTS_IN_GAME ~bdbelega.cre~ BEGIN OUTER_SPRINT sq_merch_base ~AEMERCH~ END
COPY_EXISTING ~%sq_merch_base%.CRE~ ~override/SQMERCH.CRE~
	WRITE_LONG 0x28 0xC800          // FAT_MAN: the grand merchant (John 2026-10-24)
	PATCH_IF sq_voice_merch BEGIN FOR (i = 0; i < 100; i += 1) BEGIN WRITE_LONG (0xa4 + i * 4) EVAL ~%sq_vm_%i%%~ END END
	WRITE_BYTE 0x2c 27               // metal
	WRITE_BYTE 0x2d 40               // minor
	WRITE_BYTE 0x2e 9               // major
	WRITE_BYTE 0x2f 12               // skin
	WRITE_BYTE 0x30 8               // leather
	WRITE_BYTE 0x31 24               // armor
	WRITE_BYTE 0x32 0               // hair
	SAY NAME1 @1115
	SAY NAME2 @1115
	WRITE_ASCII SCRIPT_OVERRIDE ~~ #8
	WRITE_ASCII SCRIPT_CLASS ~~ #8
	WRITE_ASCII SCRIPT_RACE ~~ #8
	WRITE_ASCII SCRIPT_GENERAL ~~ #8
	WRITE_ASCII SCRIPT_DEFAULT ~~ #8
	WRITE_ASCII DEATHVAR ~SQMERCH~ #32
	WRITE_ASCII DIALOG ~SQMERCH~ #8
COMPILE ~SadoEE/camp/dlg/SQMERCH.d~ USING ~SadoEE/tra/%LANGUAGE%/qol.tra~
// back by the fire: the area's actor (schedule: every hour) and the respawn line of old saves
COPY_EXISTING ~SQCAMP.ARE~ ~override~
	READ_LONG 0x54 off
	READ_SHORT 0x58 cnt
	FOR (i = 0; i < cnt; ++i) BEGIN
		READ_ASCII (off + i * 0x110 + 0x80) cre (8) NULL
		PATCH_IF ~%cre%~ STRING_EQUAL_CASE ~SQMERCH~ BEGIN WRITE_LONG (off + i * 0x110 + 0x40) 0xFFFFFFFF END
	END
COPY ~override/M_SQCAMP.lua~ ~override~
	REPLACE_TEXTUALLY EXACT_MATCH ~-- SADOEE-MERCHANT ~ ~~

