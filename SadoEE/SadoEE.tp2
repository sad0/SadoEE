// Endless ammo: party members never use up arrows, bolts, bullets, darts or stackable throwing weapons, except
// the too-strong ones listed in M_SQAMMO.lua (slaying, polymorph, dispelling, antimagic, stunning, detonation).
BEGIN @1060 DESIGNATED 24
GROUP @2002
LABEL ~SADOEE-QOL-ENDLESS-AMMO~
REQUIRE_PREDICATE MOD_IS_INSTALLED ~EEex.tp2~ (ID_OF_LABEL ~EEex.tp2~ ~B3-EEex-Main~) @1002

COPY ~SadoEE/qol/M_SQ0BLD.lua~ ~override~   // engine build address table (v2.7.3 / v2.6.6)
COPY ~SadoEE/qol/M_SQAMMO.lua~ ~override~
// The quiver part (M_SQQUIV.lua, John 2026-10-24): basic ammo in the first empty quiver slot while a launcher is
// equipped, like the fist. Weightless, worthless, not droppable (flag 0x4 cleared), own icons.
ACTION_FOR_EACH pair IN ~AROW01:SQAROW~ ~BOLT01:SQBOLT~ ~BULL01:SQBULL~ BEGIN
	OUTER_PATCH_SAVE src ~%pair%~ BEGIN REPLACE_TEXTUALLY ~:.*~ ~~ END
	OUTER_PATCH_SAVE dst ~%pair%~ BEGIN REPLACE_TEXTUALLY ~.*:~ ~~ END
	COPY_EXISTING ~%src%.ITM~ ~override/%dst%.ITM~
		WRITE_LONG 0x18 (THIS BAND (BNOT 0x4))
		WRITE_LONG 0x34 0
		WRITE_LONG 0x4c 0
		WRITE_SHORT 0x38 1                 // max stack 1: no stack number on the icon (endless ammo keeps it at 1)
		WRITE_ASCIIE 0x3a ~%dst%I~ #8      // our painted quiver / pouch (tools/make_quiver_icons.py)
		WRITE_ASCIIE 0x44 ~%dst%G~ #8
		WRITE_ASCIIE 0x58 ~%dst%C~ #8
END
COPY ~SadoEE/qol/quiver~ ~override~
COPY ~SadoEE/qol/M_SQQUIV.lua~ ~override~
COPY ~SadoEE/qol/SQQUIV.menu~ ~override~

