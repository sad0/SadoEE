menu
{
	name 'INVENTORY'
	align center center
	ignoreEsc
	size 1120 710
	onOpen
	"
		Infinity_ActivateInventory()
		pushSidebars()
		doubleClickEventScheduled = nil
		PStash_OnInventoryOpen()
	"
	onClose
	"
		Infinity_PopMenu('CHARACTER_COLOR')
		Infinity_PopMenu('ITEM_DESCRIPTION')
		Infinity_PopMenu('ITEM_IDENTIFY')
		popSidebars()
		PStash_OnInventoryClose()
	"
	label
	{
		area 0 0 1120 710
		mosaic INVPSTSH
	}
	label
	{
		area 0 0 0 0
		enabled "PStash_DecorateTooltips()"
	}
	button
	{
		area 299 177 128 160
		paperdoll 1
		actiondrag "Infinity_SwapWithAppearance()"
	}
	label
	{
		area 84 55 210 32
		text lua "characters[id].name"
		text style "label"
	}
	label
	{
		area 82 6 700 44
		text "INVENTORY_TITLE"
		text style "title"
	}
