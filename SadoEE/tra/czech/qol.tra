// ex-SadoQoL strings (GENERATED by build_sadoee.py from SadoQoL/tra; @N there = @1000 + N here)
@1001 = ~Pasivní hledání pastí: zloději odhalí pasti i bez režimu Hledat pasti (vyžaduje EEex)~
@1002 = ~Vyžaduje EEex.~
@1003 = ~Nalezena past~
@1004 = ~Cenné kontejnery: kontejnery s něčím cenným (vysoká cena/váha, magie, šperk, drahokam, svitek) mají trvalý zlatý obrys (vyžaduje EEex)~
@1020 = ~Automatické zneškodňování pastí: mimo boj každý nečinný zloděj se zapnutým hledáním pastí zneškodní nalezené pasti, na které stačí (vyžaduje EEex)~
@1021 = ~Postarám se o tu past~
@1022 = ~Odemknu ten zámek paklíčem~
@1023 = ~Vyrazím to~
@1024 = ~Nikdo tu neumí zneškodnit tuto past (klikněte znovu a otevřete ji i tak)~
@1025 = ~Nikdo tu neumí otevřít tento zámek~
@1030 = ~Seřazená kořist: na zemi, v kontejnerech a v liště rychlé kořisti nejprve úkolové předměty, pak předměty bez váhy, pak zbytek podle ceny/váhy (vyžaduje EEex)~
@1040 = ~Poloviční osobní prostor: každý tvor zabírá o polovinu méně místa, družina se už nezasekává v chodbách (vyžaduje EEex)~
@1042 = ~Poloviční osobní prostor byl odebrán: rozbíjel dosah boje zblízka.~
@1050 = ~Počítadlo FPS: snímky za sekundu a nejpomalejší snímek nahoře na herní obrazovce, F12 jej zobrazí / skryje (vyžaduje EEex)~
@1060 = ~Nekonečná munice: šípy, šipky do kuše, kuličky do praku, vrhací šipky a vrhací zbraně družiny se nikdy nespotřebují, kromě těch nejmocnějších (vyžaduje EEex)~
@1070 = ~Menší rozměry družiny: družina se už nezasekává v chodbách, dosah boje zblízka se nemění (vyžaduje EEex)~
@1071 = ~1 pole na postavu~
@1072 = ~Žádné pole: družina prochází všemi a všichni procházejí jí~
@1090 = ~Trvalé režimy: bardova píseň, odvrácení nemrtvých, plížení a šamanský tanec zůstávají zapnuté, i když postava jedná; tlačítko Hledat pasti zapíná či vypíná pasivní hledání pastí (vyžaduje EEex)~
@1091 = ~Hledání pastí: zapnuto~
@1092 = ~Hledání pastí: vypnuto~
@1100 = ~Odpočinkový tábor: pergamen nad tlačítkem Cestovat na mapě světa vede do klidného tábora (0 h tam i zpět, odpočinek bez přepadení) (vyžaduje EEex)~
@1101 = ~Tábor~
@1102 = ~Zpět~
@1110 = ~Kéž světlo bdí nad vaším táborem, poutníci. Ranění, prokletí i ti, kdo ztratili druha, zde naleznou útěchu. Jak vám mohu pomoci?~
@1111 = ~Ukaž mi, co nabízíš.~
@1112 = ~Teď ne, děkuji.~
@1113 = ~Potulný kněz~
@1114 = ~Služby potulného kněze~
@1115 = ~Velký kupec~
@1116 = ~Vítejte v táboře! Cokoli jste viděli v obchodech na Pobřeží, vám mohu sehnat, a za nejlepší cenu.~
@1117 = ~Ukaž, co máš.~
@1118 = ~Teď ne.~
@1119 = ~Mé vozy ještě nedorazily, vraťte se později.~
@1120 = ~Útok v pohybu: vybraná družina jde ke kurzoru a bojuje s každým nepřítelem, kterého cestou spatří, jako v RTS; přiřazuje se v komponentě Tlačítka myši (výchozí je tlačítko 4) (vyžaduje EEex)~
@1130 = ~Tlačítka myši: prostřední tlačítko, tlačítka 4 až 8 a kolečko, samotná nebo se Shift / Ctrl / Alt, spouštějí libovolnou akci z klávesových zkratek hry nebo útok v pohybu (výchozí tlačítko 4), nastavené na stránce možností SadoEE (vyžaduje EEex)~
@1131 = ~SadoEE~
@1132 = ~Nic~
@1133 = ~Útok v pohybu~
@1134 = ~Aura pastí~
@1135 = ~Počítadlo FPS~
@1136 = ~Akce spouštěná tímto vstupem. Nic: hra se chová jako obvykle.~
@1137 = ~Prostřední tlačítko~
@1138 = ~Tlačítko 4~
@1139 = ~Tlačítko 5~
@1140 = ~Tlačítko 6~
@1141 = ~Tlačítko 7~
@1142 = ~Tlačítko 8~
@1143 = ~Shift + kolečko nahoru~
@1144 = ~Shift + kolečko dolů~
@1145 = ~Ctrl + kolečko nahoru~
@1146 = ~Ctrl + kolečko dolů~
@1150 = ~Družina si po smrti ponechá výbavu~
@1151 = ~Truhly v liště předmětů na zemi~
@1160 = ~Starý učenec v táboře (identifikuje vše, 80 zl za předmět)~
@1161 = ~Ach, poutníci! Pojďte, posaďte se chvíli k ohni a poslouchejte. Tyto staré oči přečetly víc run, než je dnes v noci hvězd. Ukažte mi, co nesete, a já vám povím, co to doopravdy je.~
@1162 = ~Nechceš radši identifikovat naše věci? (<SQCAINC> zl)~
@1163 = ~Ukažte... <SQCAINN> z vašich věcí si střeží svá tajemství. Za <SQCAINC> zlatých pojmenuji každou z nich.~
@1164 = ~Do toho.~
@1165 = ~Hotovo. Každá mi vyprávěla svůj příběh a teď jej znáte i vy. Užívejte je moudře, příteli.~
@1166 = ~Teď ne.~
@1167 = ~Vše, co nesete, už znáte. Vraťte se, až vám cesta přinese nové hádanky.~
@1168 = ~Běda, váš měšec je příliš lehký: <SQCAINC> zlatých, ani o minci méně. I starý učenec musí jíst.~
@1169 = ~Dobrá tedy, podívejme se na vaše poklady.~
@1170 = ~Pověz nám příběh, starče.~
@1171 = ~Před dávnými časy učenci mého řádu uzavřeli strašlivé věci do kamene a ty kameny hluboko zakopali. Obávám se, že ne každý kámen vydržel. Najdete-li drahokam, který v noci šeptá... přineste ho nejdřív mně.~
@1172 = ~Sbohem.~
@1173 = ~Starý učenec~
@1174 = ~Čekání v táboře: člen, který opustí družinu, na vás může počkat v odpočinkovém táboře u ohně~
@1175 = ~Withers v táboře: lich, který zcela znovu vytvoří člena družiny (rasa, povolání, specializace, vlastnosti...), zdarma~
@1176 = ~Withers~
@1177 = ~%s: předmět %s putuje do truhly (batoh plný)~
@1178 = ~Pokračovat~
@1179 = ~Dokončit~
@1180 = ~Mám na tebe počkat v táboře?~
@1181 = ~Ano, počkej na mě v táboře.~
@1182 = ~Ne, zůstaň tady.~
@1183 = ~Vyrazíme zase na cestu?~
@1184 = ~Přidej se k nám.~
@1185 = ~Ještě ne.~
@1186 = ~Potvrdit~
@1187 = ~Bez dvojího povolání~
@1188 = ~%s: vráceno %d ZK po přechodu na dvojí povolání~
@1190 = ~Smrtelníku. Neseš podobu, kterou ti dal svět. Mohu ji rozplést a ty si zvolíš jinou... ještě jednou, od samého začátku.~
@1191 = ~Přetvoř mě.~
@1192 = ~Dnes ne.~
@1193 = ~Věz toto: jakmile začnu, není cesty zpět. Rasa, poslání, mysl i tělo, vše bude zvoleno znovu. Tvé vzpomínky a majetek zůstanou. Mám začít?~
@1194 = ~Začni.~
@1195 = ~Rozmyslím si to.~
@1196 = ~Táborová truhla~
@1197 = ~*Víko se se skřípěním otevírá.*~
@1198 = ~Úroveň před dvojím povoláním~
@1199 = ~Úroveň %d: nyní %d ZK, %d ZK po dvojím povolání~
@1200 = ~%s: %d kouzel putovalo do grimoáru~
@1201 = ~%s se učí: %s~
@1202 = ~%s (úroveň %d)~
@1203 = ~Grimoár - čte %s~
@1204 = ~Otevřít grimoár~
@1205 = ~Naučit~
@1206 = ~Zavřít~
@1207 = ~Grimoár ztracených kouzel~
@1208 = ~Na těchto stránkách spočívají kouzla, která mág zapomněl, když jej Withers přetvořil. Otevři jej a každý, kdo umí zapisovat kouzla mágů do své knihy, se je znovu naučí (ta, která dokáže seslat).~
@1209 = ~Auto-Roller: tlačítko Auto-Roll při tvorbě postavy ponechá nejlepší z mnoha hodů (s ohledem na sílu 18/xx)~
@1210 = ~Nechceš radši identifikovat naše věci?~
@1211 = ~Chci se dozvědět víc o tomto světě.~
@1212 = ~Ach, podívejme se, co říkají mé poznámky...~
@1250 = ~Přiveď mi nového společníka.~
@1251 = ~Další duše pro tvou družinu? Mohu ji utvořit z ničeho... nebo přivolat někoho, koho jsi znal jinde. Půjde s vámi, stejně zkušená jako tvůj vůdce.~
@1252 = ~Utvoř ho přede mnou.~
@1253 = ~Přivolej někoho, koho jsem znal (import).~
@1254 = ~Jindy.~
@1255 = ~Withers: nový společník~
@1256 = ~Pokračovat~
@1257 = ~Zrušit~
@1258 = ~Ponechá si předměty, které nesl?~
@1259 = ~Ponechá si je~
@1260 = ~Zanechat je~
@1261 = ~Ponechá si vlastní zkušenosti, nebo převezme zkušenosti vůdce družiny?~
@1262 = ~Vlastní~
@1263 = ~Vůdcovy~
@1264 = ~%s se přidává k družině.~
@1265 = ~Družina je plná (členů: %d).~
@1266 = ~Withers verbuje: nový společník vytvořený na herních obrazovkách tvorby postavy nebo importovaný, zdarma~
@1267 = ~Výbava nového společníka~
@1268 = ~Potvrdit~
@1269 = ~Nákupy u Velkého kupce: %d zl (zlato družiny: %d zl)~
@1270 = ~Truhla~
@1271 = ~%d gp~
@1272 = ~zdarma~
@1273 = ~Zbraň na blízko~
@1274 = ~Druhá ruka~
@1275 = ~Zbraň na dálku~
@1276 = ~Munice~
@1277 = ~Zbroj~
@1278 = ~Přilba~
@1279 = ~Amulet~
@1280 = ~Prsteny (dva)~
@1281 = ~Náramky / rukavice~
@1282 = ~Opasek~
@1283 = ~Boty~
@1284 = ~Plášť~
@1285 = ~Withers nabízí~
@1286 = ~Přijmi náš dar pro svůj chrám: <SQPRRC> zl (reputace <SQPRREP> -> <SQPRNEXT>).~
@1287 = ~Uzdrav celou družinu: <SQPRHL>. Celkem: <SQPRHC> zl.~
@1288 = ~Buďte požehnáni. Chudí na Pobřeží budou vaše jména vyslovovat s vděčností.~
@1289 = ~Je dokonáno. Povstaňte, vy všichni, a kráčejte ve světle.~
@1290 = ~Běda, váš měšec je na to příliš lehký. Vraťte se, až budete moci.~
@1291 = ~vzkříšení~
@1292 = ~zranění~
@1293 = ~ztracené úrovně~
@1294 = ~prokletí~
@1295 = ~jed~
@1296 = ~nemoc~
@1297 = ~Nekromant~
@1298 = ~Mrtví nemají nic lepšího na práci než pomáhat živým s výcvikem. Jmenujte protivníka a povstane před vámi... neškodný, pokud si nepřejete jinak.~
@1299 = ~Oživ pro nás tvora.~
@1300 = ~Rozpoutej je: ať bojují a umírají.~
@1301 = ~Uklidni je: ať jsou zase nesmrtelnými loutkami.~
@1302 = ~Ukliď to tu: ať všichni padnou.~
@1303 = ~Sbohem.~
@1304 = ~Kolik má povstat: <SQNECRN>?~
@1305 = ~Jeden.~
@1306 = ~Dva.~
@1307 = ~Tři.~
@1308 = ~Pět.~
@1309 = ~Deset.~
@1310 = ~Žádného, rozmyslel jsem si to.~
@1311 = ~Připoutej je k nám: ať se přidají k naší družině.~
@1312 = ~Hotovo.~
@1313 = ~Bestiář~
@1314 = ~Nestvůry~
@1315 = ~Lidé~
@1316 = ~Hledat~
@1317 = ~Oživit~
@1318 = ~Zavřít~
@1319 = ~Úroveň~
@1320 = ~HP~
@1321 = ~AC~
@1322 = ~Zranění~
@1323 = ~Celkem~
@1324 = ~Vynulovat~
@1325 = ~Tvorové: %d~
@1326 = ~Nekromant v táboře: cvičné figuríny z celého bestiáře, měřič zranění (vyžaduje odpočinkový tábor)~
@1340 = ~Ošetři naše zranění, prosím.~
@1341 = ~Tak. Buďte klidní: světlo za to nic nežádá.~
@1342 = ~Kněžka ošetřila vaše zranění, zatímco jste spali.~
@1343 = ~Kněžka ošetřuje zranění družiny.~
@1344 = ~Ceny táborové kněžky~
@1345 = ~Ceny táborové kněžky: 75 %~
@1346 = ~Ceny táborové kněžky: 50 %~
@1347 = ~Ceny táborové kněžky: 25 %~
@1348 = ~Ceny táborové kněžky: zdarma~
@1540 = ~SadoEE~
@1541 = ~Funkce SadoEE zapínané či vypínané ve hře. Vypnutí funkci jen zastaví: co už udělala, zůstává.~
@1542 = ~Nápovědy truhly: předměty červené / modré~
@1543 = ~Stránka truhly družiny: nepoužitelné předměty červeně, neidentifikované modře.~
@1544 = ~Nápovědy truhly: značka + pro vylepšení~
@1545 = ~Stránka truhly družiny: + u předmětů, které jsou vylepšením pro zobrazenou postavu, nebo u svitku mága, který se člen družiny ještě může naučit.~
@1546 = ~Řádek DPS v popiscích zbraní~
@1547 = ~Zranění za kolo a THAC0 nasazených zbraní, přidané do jejich popisků.~
@1548 = ~Pasivní hledání pastí~
@1549 = ~Zloději odhalí pasti kolem sebe i bez režimu Hledat pasti.~
@1550 = ~Automatické zneškodňování pastí~
@1551 = ~Mimo boj nečinní zloději zneškodní nalezené pasti.~
@1552 = ~Auto otevírání / odemykání / vyrážení~
@1553 = ~Kliknutí na kontejner s pastí nebo zamčený pošle toho, kdo nejlépe zneškodní past, odemkne zámek nebo jej vyrazí.~
@1554 = ~Zlatý obrys cenných kontejnerů~
@1555 = ~Kontejnery s něčím cenným dostanou zlatý obrys.~
@1556 = ~Nekonečná munice~
@1557 = ~Šípy, šipky do kuše, kuličky do praku, vrhací šipky a vrhací zbraně se nikdy nespotřebují, kromě těch nejmocnějších.~
@1558 = ~Základní munice v toulci~
@1559 = ~S nasazeným lukem, kuší nebo prakem čeká základní munice v prvním volném místě toulce.~
@1560 = ~Útok v pohybu~
@1561 = ~Akce útoku v pohybu (přiřazuje se na kartě tlačítek myši SadoEE).~
@1562 = ~Bez opakování bardovy písně / odvrácení nemrtvých~
@1563 = ~Skripty AI družiny už znovu nespouštějí režim, který je již zapnutý (žádný opakovaný řádek zpráv).~
@1564 = ~Seřazená kořist~
@1565 = ~Předměty na zemi, v kontejnerech a v liště kořisti jsou seřazené.~
@1566 = ~Truhly v liště předmětů na zemi~
@1567 = ~Blízké kontejnery se zobrazují v liště předmětů na zemi.~
@1568 = ~Čekání v táboře~
@1569 = ~Člen, který opustí družinu, může počkat v odpočinkovém táboře.~
@1570 = ~Počítadlo FPS~
@1571 = ~Snímky za sekundu nahoře na herní obrazovce (F12 je také zobrazí / skryje).~
@1572 = ~Truhla družiny~
@1573 = ~Pasti a kontejnery~
@1574 = ~Boj a munice~
@1575 = ~Kořist a tábor~
@1576 = ~Zobrazení~
@1577 = ~Tlačítka myši~
@1578 = ~Zavřít~
@1579 = ~Útok v pohybu (SadoEE)~
@1580 = ~Nic~
@1581 = ~Zobrazit všechny akce...~
@1582 = ~Zrušit~
@1583 = ~Samotné~
@1584 = ~Shift~
@1585 = ~Ctrl~
@1586 = ~Alt~
@1587 = ~Prostřední tlačítko~
@1588 = ~Kolečko nahoru~
@1589 = ~Kolečko dolů~
@1590 = ~Kolečko doleva~
@1591 = ~Kolečko doprava~
@1592 = ~Otevřít stránku možností SadoEE~
@1593 = ~Přepínače a tlačítka myši SadoEE mají vlastní stránku: také v nabídce Možnosti hry (Esc) a u Decarda v táboře.~
@1594 = ~Rád bych změnil pár zvyků družiny.~
@1595 = ~Samozřejmě. Takhle se věci mají.~
@1596 = ~Najeďte na řádek a přečtěte si jeho popis.~
@1597 = ~Kliknutí: volba akce. Pravé tlačítko: nic. Boční tlačítka myší MMO posílají klávesy: přiřaďte je v Klávesových zkratkách hry.~
@1600 = ~Dvojice CP se mohou rozdělit: propuštění jednoho už nepropustí i druhého (Jaheira a Khalid, Minsc a Dynaheir, Xzar a Montaron, Eldoth a Skie)~
@1601 = ~Tato komponenta je pro Baldur's Gate (BGEE) a EET.~
@1602 = ~Vyžaduje Witherse v odpočinkovém táboře (jeho komponenta musí být nainstalována dříve).~
@1603 = ~Auto-hod~
@1604 = ~Zastavit (%.1fs)~
@1605 = ~Váha 18/xx: %d~
@1606 = ~Doba: %ds~
@1607 = ~Nejlepší: %d~
@1608 = ~SÍL~
@1609 = ~Hodů: %s~
