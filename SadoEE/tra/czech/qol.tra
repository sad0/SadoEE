// ex-SadoQoL strings (GENERATED by build_sadoee.py from SadoQoL/tra; @N there = @1000 + N here)
@1001 = ~Pasivní hledání pastí: zloději odhalí pasti i bez režimu Hledat pasti (vyžaduje EEex)~
@1002 = ~Vyžaduje EEex.~
@1003 = ~Nalezena past~
@1004 = ~Cenné kontejnery: kontejnery s něčím cenným (vysoká cena/váha, magie, šperk, drahokam, svitek) mají trvalý zlatý obrys (vyžaduje EEex)~
@1020 = ~Automatické zneškodňování pastí: mimo boj každý nečinný zloděj se zapnutým hledáním pastí zneškodní nalezené pasti, na které stačí (vyžaduje EEex)~
@1021 = ~Postarám se o tu past~
@1022 = ~I'll pick the lock~
@1023 = ~I'll force it open~
@1024 = ~Nobody here can disarm this trap (click again to open it anyway)~
@1025 = ~Nobody here can open this lock~
@1030 = ~Seřazená kořist: na zemi, v kontejnerech a v liště rychlé kořisti nejprve úkolové předměty, pak předměty bez váhy, pak zbytek podle ceny/váhy (vyžaduje EEex)~
@1040 = ~Poloviční osobní prostor: každý tvor zabírá o polovinu méně místa, družina se už nezasekává v chodbách (vyžaduje EEex)~
@1042 = ~Poloviční osobní prostor byl odebrán: rozbíjel dosah boje zblízka.~
@1050 = ~Počítadlo FPS: snímky za sekundu a nejpomalejší snímek nahoře na herní obrazovce, F12 jej zobrazí / skryje (vyžaduje EEex)~
@1060 = ~Nekonečná munice: šípy, šipky do kuše, kuličky do praku, vrhací šipky a vrhací zbraně družiny se nikdy nespotřebují, kromě těch nejmocnějších (vyžaduje EEex)~
@1070 = ~Menší rozměry družiny: družina se už nezasekává v chodbách, dosah boje zblízka se nemění (vyžaduje EEex)~
@1071 = ~1 pole na postavu~
@1072 = ~Žádné pole: družina prochází všemi a všichni procházejí jí~
@1090 = ~Trvalé režimy: bardova píseň, odvrácení nemrtvých, plížení a šamanský tanec zůstávají zapnuté, i když postava jedná; tlačítko Hledat pasti zapíná či vypíná pasivní hledání pastí (vyžaduje EEex)~
@1091 = ~Hledání pastí: zapnuto~
@1092 = ~Hledání pastí: vypnuto~
@1100 = ~Odpočinkový tábor: pergamen nad tlačítkem Cestovat na mapě světa vede do klidného tábora (0 h tam i zpět, odpočinek bez přepadení) (vyžaduje EEex)~
@1101 = ~Tábor~
@1102 = ~Zpět~
@1110 = ~Kéž světlo bdí nad vaším táborem, poutníci. Ranění, prokletí i ti, kdo ztratili druha, zde naleznou útěchu. Jak vám mohu pomoci?~
@1111 = ~Ukaž mi, co nabízíš.~
@1112 = ~Teď ne, děkuji.~
@1113 = ~Potulný kněz~
@1114 = ~Služby potulného kněze~
@1115 = ~Velký kupec~
@1116 = ~Vítejte v táboře! Cokoli jste viděli v obchodech na Pobřeží, vám mohu sehnat, a za nejlepší cenu.~
@1117 = ~Ukaž, co máš.~
@1118 = ~Teď ne.~
@1119 = ~Mé vozy ještě nedorazily, vraťte se později.~
@1120 = ~Útok v pohybu: vybraná družina jde ke kurzoru a bojuje s každým nepřítelem, kterého cestou spatří, jako v RTS; přiřazuje se v komponentě Tlačítka myši (výchozí je tlačítko 4) (vyžaduje EEex)~
@1130 = ~Tlačítka myši: prostřední tlačítko, tlačítka 4 až 8 a Shift / Ctrl + kolečko spouštějí akce SadoEE, volené v nabídce Možnosti EEex (vyžaduje EEex)~
@1131 = ~SadoEE~
@1132 = ~Nic~
@1133 = ~Útok v pohybu~
@1134 = ~Aura pastí~
@1135 = ~Počítadlo FPS~
@1136 = ~Akce spouštěná tímto vstupem. Nic: hra se chová jako obvykle.~
@1137 = ~Prostřední tlačítko~
@1138 = ~Tlačítko 4~
@1139 = ~Tlačítko 5~
@1140 = ~Tlačítko 6~
@1141 = ~Tlačítko 7~
@1142 = ~Tlačítko 8~
@1143 = ~Shift + kolečko nahoru~
@1144 = ~Shift + kolečko dolů~
@1145 = ~Ctrl + kolečko nahoru~
@1146 = ~Ctrl + kolečko dolů~
@1150 = ~Družina si po smrti ponechá výbavu~
@1151 = ~Truhly v liště předmětů na zemi~
@1160 = ~Starý učenec v táboře (identifikuje vše, 80 zl za předmět)~
@1161 = ~Ach, poutníci! Pojďte, posaďte se chvíli k ohni a poslouchejte. Tyto staré oči přečetly víc run, než je dnes v noci hvězd. Ukažte mi, co nesete, a já vám povím, co to doopravdy je.~
@1162 = ~Nechceš radši identifikovat naše věci? (<SQCAINC> zl)~
@1163 = ~Ukažte... <SQCAINN> z vašich věcí si střeží svá tajemství. Za <SQCAINC> zlatých pojmenuji každou z nich.~
@1164 = ~Do toho.~
@1165 = ~Hotovo. Každá mi vyprávěla svůj příběh a teď jej znáte i vy. Užívejte je moudře, příteli.~
@1166 = ~Teď ne.~
@1167 = ~Vše, co nesete, už znáte. Vraťte se, až vám cesta přinese nové hádanky.~
@1168 = ~Běda, váš měšec je příliš lehký: <SQCAINC> zlatých, ani o minci méně. I starý učenec musí jíst.~
@1169 = ~Dobrá tedy, podívejme se na vaše poklady.~
@1170 = ~Pověz nám příběh, starče.~
@1171 = ~Před dávnými časy učenci mého řádu uzavřeli strašlivé věci do kamene a ty kameny hluboko zakopali. Obávám se, že ne každý kámen vydržel. Najdete-li drahokam, který v noci šeptá... přineste ho nejdřív mně.~
@1172 = ~Sbohem.~
@1173 = ~Starý učenec~
@1174 = ~Čekání v táboře: člen, který opustí družinu, na vás může počkat v odpočinkovém táboře u ohně~
@1175 = ~Withers v táboře: lich, který zcela znovu vytvoří člena družiny (rasa, povolání, specializace, vlastnosti...), zdarma~
@1176 = ~Withers~
@1177 = ~%s: předmět %s putuje do truhly (batoh plný)~
@1178 = ~Pokračovat~
@1179 = ~Dokončit~
@1180 = ~Mám na tebe počkat v táboře?~
@1181 = ~Ano, počkej na mě v táboře.~
@1182 = ~Ne, zůstaň tady.~
@1183 = ~Vyrazíme zase na cestu?~
@1184 = ~Přidej se k nám.~
@1185 = ~Ještě ne.~
@1186 = ~Potvrdit~
@1187 = ~Bez dvojího povolání~
@1188 = ~%s: vráceno %d ZK po přechodu na dvojí povolání~
@1190 = ~Smrtelníku. Neseš podobu, kterou ti dal svět. Mohu ji rozplést a ty si zvolíš jinou... ještě jednou, od samého začátku.~
@1191 = ~Přetvoř mě.~
@1192 = ~Dnes ne.~
@1193 = ~Věz toto: jakmile začnu, není cesty zpět. Rasa, poslání, mysl i tělo, vše bude zvoleno znovu. Tvé vzpomínky a majetek zůstanou. Mám začít?~
@1194 = ~Začni.~
@1195 = ~Rozmyslím si to.~
@1196 = ~Táborová truhla~
@1197 = ~*Víko se se skřípěním otevírá.*~
@1198 = ~Úroveň před dvojím povoláním~
@1199 = ~Úroveň %d: nyní %d ZK, %d ZK po dvojím povolání~
@1200 = ~%s: %d kouzel putovalo do grimoáru~
@1201 = ~%s se učí: %s~
@1202 = ~%s (úroveň %d)~
@1203 = ~Grimoár - čte %s~
@1204 = ~Otevřít grimoár~
@1205 = ~Naučit~
@1206 = ~Zavřít~
@1207 = ~Grimoár ztracených kouzel~
@1208 = ~Na těchto stránkách spočívají kouzla, která mág zapomněl, když jej Withers přetvořil. Otevři jej a každý, kdo umí zapisovat kouzla mágů do své knihy, se je znovu naučí (ta, která dokáže seslat).~
@1209 = ~Auto-Roller: an Auto-Roll button in character creation keeps the best of many rolls (18/xx strength weighted)~
@1210 = ~Wouldn't you rather identify our items?~
@1211 = ~I'd like to know more about this world.~
@1212 = ~Ah, let's see what my notes say...~
@1250 = ~Bring me a new companion.~
@1251 = ~One more soul for your band? I can shape one from nothing... or call back one you knew elsewhere. He will walk with you, as seasoned as your leader.~
@1252 = ~Shape him before me.~
@1253 = ~Call back someone I knew (import).~
@1254 = ~Another time.~
@1255 = ~Withers: new companion~
@1256 = ~Continue~
@1257 = ~Abandon~
@1258 = ~Does he keep the items he carried?~
@1259 = ~He keeps them~
@1260 = ~Leave them~
@1261 = ~Does he keep his own experience, or take the party leader's?~
@1262 = ~His own~
@1263 = ~The leader's~
@1264 = ~%s joins the party.~
@1265 = ~The party is full (%d members).~
@1266 = ~Withers recruits: a new companion made in the game's own creation screens or imported, free~
@1267 = ~The new companion's gear~
@1268 = ~Validate~
@1269 = ~Bought from the Grand Merchant: %d gp (party gold: %d gp)~
@1270 = ~Stash~
@1271 = ~%d gp~
@1272 = ~free~
@1273 = ~Melee weapon~
@1274 = ~Off hand~
@1275 = ~Ranged weapon~
@1276 = ~Ammunition~
@1277 = ~Armour~
@1278 = ~Helmet~
@1279 = ~Amulet~
@1280 = ~Rings (two)~
@1281 = ~Bracers / gauntlets~
@1282 = ~Belt~
@1283 = ~Boots~
@1284 = ~Cloak~
@1285 = ~Withers offers~
@1286 = ~Accept our gift for your temple: <SQPRRC> gp (reputation <SQPRREP> -> <SQPRNEXT>).~
@1287 = ~Heal the whole party: <SQPRHL>. Total: <SQPRHC> gp.~
@1288 = ~Bless you. The poor of the Coast will speak your names kindly.~
@1289 = ~It is done. Stand up, all of you, and walk in the light.~
@1290 = ~Alas, your purse is too light for that. Come back when you can.~
@1291 = ~resurrection~
@1292 = ~wounds~
@1293 = ~lost levels~
@1294 = ~curse~
@1295 = ~poison~
@1296 = ~disease~
@1297 = ~Necromancer~
@1298 = ~The dead have nothing better to do than help the living train. Name a foe, and it will rise before you... harmless, unless you ask otherwise.~
@1299 = ~Raise a creature for us.~
@1300 = ~Unleash them: let them fight, and die.~
@1301 = ~Calm them: make them undying puppets again.~
@1302 = ~Clean up: let them all fall.~
@1303 = ~Farewell.~
@1304 = ~How many <SQNECRN> shall rise?~
@1305 = ~One.~
@1306 = ~Two.~
@1307 = ~Three.~
@1308 = ~Five.~
@1309 = ~Ten.~
@1310 = ~None, I changed my mind.~
@1311 = ~Bind them to us: let them join our party.~
@1312 = ~It is done.~
@1313 = ~Bestiary~
@1314 = ~Monsters~
@1315 = ~Humans~
