@162 = ~Mod. OČ~ // ab_ac_mods
@163 = ~Střely~ // ab_missile
@164 = ~Dov.~ // ab_prof
@165 = ~Základní THAC0~ // ab_base_thac0
@166 = ~Hlavní~ // ab_main_hand
@167 = ~Druhá~ // ab_off_hand
@168 = ~2 zbraně~ // ab_two_weapon
@169 = ~Vyprázdnit truhlu? Sebrané vaky se vrátí naplněné předměty, které pojmou; vše ostatní spadne na zem. Udělejte to před odinstalováním Party Stash.~ // empty_confirm
@170 = ~Ctrl + levé kliknutí: vysypat truhlu do vaků a na zem (před odinstalováním)\nPravé tlačítko: uložit batoh nebo tuto stránku truhly (kromě cenných a úkolových předmětů) do příští otevřené schránky\n*Panel kontejneru: červené tlačítko vpravo dole dělá totéž~ // bag_tip
@171 = ~Toto je vaše truhla~ // help_stash_title
@172 = ~Kliknutí: vzít předmět (dvojklik: vzít a nasadit)\nCtrl + kliknutí: označit k prodeji (Prodat označené u obchodníka)\nAlt + kliknutí: cenný (zlatý, nikdy neprodán)\nPravé kliknutí: popis. Kolečko myši: posun\n*Karty: filtrování truhly podle kategorie (kolečko nebo šipky pro zobrazení všech)\n*Zbraně: zranění za kolo v popisku~ // help_stash
@173 = ~Toto je inventář vaší postavy (2 horní řady)~ // help_pack_title
@174 = ~Shift + dvojklik nebo přetažení na truhlu: uložit předmět\nMezerník nebo Uložit vše: uložit celý batoh\n*Truhla v posledním místě: vaše truhla; hra počítá její předměty jako nesené (úkoly).\nCtrl + kliknutí: označit k prodeji (jde do truhly)\nAlt + kliknutí: cenný (zlatý, nikdy neprodán)~ // help_pack
@175 = ~Mezerník: uložit celý batoh.\nÚkolové předměty zůstávají v batohu; vaky se ptají na potvrzení.~ // help_storeall
@176 = ~Kliknutí: změnit řazení\nPravé kliknutí: obrátit ho\n*Auto: každá záložka své pořadí (zbraně podle zranění za kolo pro zobrazenou postavu, zbroje podle OČ, svitky podle povolání a úrovně...).\n*Také: Datum, Kvalita, Typ, Cena, zl/lb.~ // help_sort
@177 = ~Uložte vak (Shift + dvojklik nebo Uložit vše): vysype se do truhly a zůstane tady.\nPředměty v truhle, které pojme, nic neváží.~ // help_bags
@178 = ~Prodá se označených předmětů: %d, za %d zl.\nPřeskočeno označených: %d (bez ceny, úkolové nebo je zde nevykupují).~ // help_sell
@179 = ~Truhla družiny: hra počítá její předměty jako nesené (úkoly).~ // stash_slot_tip
@180 = ~%s zranění/kolo, THAC0 %d~ // dps_line
@181 = ~Útoky/kolo: %s~ // st_apr
@182 = ~ (obr.)~ // sort_rev
@183 = ~Cenný předmět nelze položit na zem~ // msg_valuable_ground
@184 = ~Otevřete schránku, která má předměty přijmout (Esc ruší)~ // dump_armed
@185 = ~Uložit do této schránky: batoh (%d předmětů) nebo tuto stránku truhly (%d předmětů)?~ // dump_confirm
@186 = ~Do schránky uloženo %d předmětů~ // dump_done
@187 = ~Není co uložit~ // dump_none
@188 = ~Ukládání zrušeno~ // dump_cancel
@189 = ~Batoh~ // dump_backpack
@190 = ~Stránka truhly~ // dump_stashpage
@191 = ~Vložit batoh nebo naposledy zobrazenou stránku truhly do tohoto kontejneru (kromě cenných a úkolových předmětů)~ // container_tip
@195 = ~Nápověda: co Party Stash přidává na tuto stránku~ // help_btn_tip
@196 = ~Vak váhy~ // bubble_weight_t
@197 = ~Karty~ // bubble_tabs_t
@198 = ~Filtrování truhly podle kategorie\nKolečko nebo šipky: zobrazit všechny karty\n*Vaky: sebrané vaky; předměty truhly, které pojmou, nic neváží~ // bubble_tabs
@199 = ~Řazení~ // bubble_sort_t
@200 = ~Zem~ // bubble_ground_t
@201 = ~Předměty na zemi kolem družiny\nPřetažení: položit nebo sebrat předmět\nCenné předměty sem nelze položit~ // bubble_ground
@202 = ~Kliknutím kamkoli zavřete~ // bubble_close
@203 = ~Poznámky~ // tab_notes
@204 = ~DPS~ // sort_dps
@205 = ~Úroveň~ // sort_level
