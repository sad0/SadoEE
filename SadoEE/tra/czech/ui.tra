@129 = ~Dovednost: %d~ // cmp_skill
@130 = ~Váha družiny + truhly / součet nosností členů. Nad ní jsou všichni zpomaleni. Předměty v truhle, které se vejdou do sebraného vaku (karta Vaky), nic neváží.~ // weight_tip
@131 = ~Vak: Shift + dvojklik nebo Uložit vše~ // msg_bag_hint
@132 = ~Úkolové předměty a vaky zůstávají v batohu~ // msg_quest_bags
@133 = ~Úkolové předměty zůstávají v batohu~ // msg_quest
@134 = ~Ruku nelze vyprázdnit~ // msg_hand
@135 = ~Vaky zůstávají ve sbírce~ // msg_bags_kept
@136 = ~Obsah vaku: ~ // msg_bag_contents
@137 = ~Obnova truhly: uvolněte místo v batohu~ // msg_restore
@138 = ~Pozor: vaše vaky budou vysypány do truhly a odpovídající předměty budou vážit 0.~ // bags_warning
@139 = ~OK~ // bags_ok
@140 = ~Krk~ // slot_neck
@141 = ~Trup OČ~ // slot_torso
