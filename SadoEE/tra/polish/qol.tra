// ex-SadoQoL strings (GENERATED by build_sadoee.py from SadoQoL/tra; @N there = @1000 + N here)
@1001 = ~Pasywne wykrywanie pułapek: złodzieje dostrzegają pułapki bez trybu Wykrywania pułapek (wymaga EEex)~
@1002 = ~Wymaga EEex.~
@1003 = ~Wykryto pułapkę~
@1004 = ~Cenne pojemniki: pojemniki z czymś cennym (wysoka wartość/waga, magia, biżuteria, klejnot, zwój) mają stały złoty obrys (wymaga EEex)~
@1020 = ~Automatyczne rozbrajanie pułapek: poza walką każdy bezczynny złodziej z włączonym wykrywaniem pułapek rozbraja wykryte pułapki, z którymi sobie poradzi (wymaga EEex)~
@1021 = ~Zajmę się tą pułapką~
@1022 = ~I'll pick the lock~
@1023 = ~I'll force it open~
@1024 = ~Nobody here can disarm this trap (click again to open it anyway)~
@1025 = ~Nobody here can open this lock~
@1030 = ~Posortowane łupy: na ziemi, w pojemnikach i na pasku szybkich łupów najpierw przedmioty fabularne, potem przedmioty bez wagi, a reszta według wartości/wagi (wymaga EEex)~
@1040 = ~Połowa przestrzeni osobistej: każda istota zajmuje o połowę mniej miejsca, drużyna nie blokuje się już w korytarzach (wymaga EEex)~
@1042 = ~Usunięto połowę przestrzeni osobistej: psuła zasięg walki wręcz.~
@1050 = ~Licznik FPS: klatki na sekundę i najwolniejsza klatka u góry ekranu gry, F12 pokazuje / ukrywa licznik (wymaga EEex)~
@1060 = ~Niekończąca się amunicja: strzały, bełty, pociski do procy, strzałki i broń miotana drużyny nigdy się nie zużywają, z wyjątkiem najpotężniejszych (wymaga EEex)~
@1070 = ~Mniejsze rozmiary drużyny: drużyna nie blokuje się już w korytarzach, zasięg walki wręcz bez zmian (wymaga EEex)~
@1071 = ~1 pole na postać~
@1072 = ~Brak pola: drużyna przechodzi przez wszystkich, a wszyscy przez nią~
@1090 = ~Trwałe tryby: pieśń barda, odpędzanie nieumarłych, skradanie się i taniec szamana pozostają aktywne, gdy postać działa; przycisk Wykrywanie pułapek włącza lub wyłącza pasywne wykrywanie pułapek (wymaga EEex)~
@1091 = ~Wykrywanie pułapek: włączone~
@1092 = ~Wykrywanie pułapek: wyłączone~
@1100 = ~Obóz odpoczynku: pergamin nad przyciskiem Podróż na mapie świata prowadzi do spokojnego obozu (0 godz. w obie strony, odpoczynek bez zasadzek) (wymaga EEex)~
@1101 = ~Obóz~
@1102 = ~Powrót~
@1110 = ~Niech światło czuwa nad waszym obozem, wędrowcy. Ranni, przeklęci i ci, którzy stracili towarzysza, znajdą tu pocieszenie. Jak mogę wam pomóc?~
@1111 = ~Pokaż, co masz do zaoferowania.~
@1112 = ~Nie teraz, dziękuję.~
@1113 = ~Wędrowny kapłan~
@1114 = ~Usługi wędrownego kapłana~
@1115 = ~Wielki kupiec~
@1116 = ~Witajcie w obozie! Wszystko, co widzieliście w sklepach Wybrzeża, mogę dla was zdobyć, i to w najlepszej cenie.~
@1117 = ~Zobaczmy, co masz.~
@1118 = ~Nie teraz.~
@1119 = ~Moje wozy jeszcze nie dotarły, wróćcie później.~
@1120 = ~Atak w ruchu: wybrana drużyna idzie do kursora, walcząc z każdym wrogiem napotkanym po drodze, jak w grach RTS; przypisywany w komponencie Przyciski myszy (domyślnie przycisk 4) (wymaga EEex)~
@1130 = ~Przyciski myszy: środkowy przycisk, przyciski 4 do 8 oraz Shift / Ctrl + kółko uruchamiają akcje SadoEE, wybierane w menu Opcje EEex (wymaga EEex)~
@1131 = ~SadoEE~
@1132 = ~Nic~
@1133 = ~Atak w ruchu~
@1134 = ~Aura pułapek~
@1135 = ~Licznik FPS~
@1136 = ~Akcja uruchamiana tym przyciskiem. Nic: gra zachowuje się normalnie.~
@1137 = ~Środkowy przycisk~
@1138 = ~Przycisk 4~
@1139 = ~Przycisk 5~
@1140 = ~Przycisk 6~
@1141 = ~Przycisk 7~
@1142 = ~Przycisk 8~
@1143 = ~Shift + kółko w górę~
@1144 = ~Shift + kółko w dół~
@1145 = ~Ctrl + kółko w górę~
@1146 = ~Ctrl + kółko w dół~
@1150 = ~Drużyna zachowuje ekwipunek po śmierci~
@1151 = ~Skrzynie na pasku przedmiotów na ziemi~
@1160 = ~Stary Uczony w obozie (identyfikuje wszystko, 80 szt. złota za przedmiot)~
@1161 = ~Ach, wędrowcy! Chodźcie, usiądźcie na chwilę przy ogniu i posłuchajcie. Te stare oczy przeczytały więcej run, niż jest dziś gwiazd na niebie. Pokażcie mi, co nosicie, a powiem wam, czym to naprawdę jest.~
@1162 = ~A może wolałbyś zidentyfikować nasze przedmioty? (<SQCAINC> szt. złota)~
@1163 = ~Niech no spojrzę... <SQCAINN> z waszych rzeczy skrywa swoje tajemnice. Za <SQCAINC> sztuk złota nazwę każdą z nich.~
@1164 = ~Zrób to.~
@1165 = ~Proszę. Każda opowiedziała mi swoją historię, a teraz znacie ją i wy. Używajcie ich mądrze, przyjacielu.~
@1166 = ~Nie teraz.~
@1167 = ~Wszystko, co nosicie, jest wam już znane. Wróćcie, gdy droga przyniesie wam nowe zagadki.~
@1168 = ~Niestety, wasza sakiewka jest zbyt lekka: <SQCAINC> sztuk złota, ani grosza mniej. Nawet stary uczony musi coś jeść.~
@1169 = ~Dobrze więc, przyjrzyjmy się waszym skarbom.~
@1170 = ~Opowiedz nam jakąś historię, starcze.~
@1171 = ~Dawno temu uczeni z mojego zakonu zamknęli straszliwe rzeczy w kamieniu i zakopali te kamienie głęboko. Obawiam się, że nie każdy kamień wytrzymał. Gdy znajdziecie klejnot, który szepcze nocą... przynieście go najpierw do mnie.~
@1172 = ~Bywajcie.~
@1173 = ~Stary Uczony~
@1174 = ~Czekanie w obozie: członek, który opuszcza drużynę, może zaczekać na ciebie w obozie odpoczynku, przy ognisku~
@1175 = ~Withers w obozie: lisz, który całkowicie odtwarza członka drużyny (rasa, klasa, specjalizacja, atrybuty...), za darmo~
@1176 = ~Withers~
@1177 = ~%s: przedmiot %s trafia do skrzyni (plecak pełny)~
@1178 = ~Dalej~
@1179 = ~Zakończ~
@1180 = ~Mam zaczekać na ciebie w obozie?~
@1181 = ~Tak, zaczekaj na mnie w obozie.~
@1182 = ~Nie, zostań tutaj.~
@1183 = ~Ruszamy znów w drogę?~
@1184 = ~Dołącz do nas.~
@1185 = ~Jeszcze nie.~
@1186 = ~Zatwierdź~
@1187 = ~Bez dwuklasowości~
@1188 = ~%s: zwrócono %d PD po przejściu na dwie klasy~
@1190 = ~Śmiertelniku. Nosisz kształt, który dał ci świat. Mogę go rozplątać, a ty wybierzesz inny... jeszcze raz, od samego początku.~
@1191 = ~Stwórz mnie na nowo.~
@1192 = ~Nie dziś.~
@1193 = ~Wiedz jedno: gdy zacznę, nie będzie odwrotu. Rasa, powołanie, umysł i ciało, wszystko wybrane na nowo. Twoje wspomnienia i dobytek pozostaną. Mam zaczynać?~
@1194 = ~Zaczynaj.~
@1195 = ~Zastanowię się.~
@1196 = ~Skrzynia obozowa~
@1197 = ~*Wieko otwiera się ze skrzypieniem.*~
@1198 = ~Poziom przed dwuklasowością~
@1199 = ~Poziom %d: %d PD teraz, %d PD po dwuklasowości~
@1200 = ~%s: %d czarów trafiło do grymuaru~
@1201 = ~%s uczy się: %s~
@1202 = ~%s (poziom %d)~
@1203 = ~Grymuar - czyta %s~
@1204 = ~Otwórz grymuar~
@1205 = ~Naucz się~
@1206 = ~Zamknij~
@1207 = ~Grymuar utraconych czarów~
@1208 = ~Na tych kartach spoczywają czary, które mag zapomniał, gdy Withers stworzył go na nowo. Otwórz go, a każdy, kto potrafi wpisywać czary maga do swojej księgi, nauczy się ich ponownie (tych, które może rzucać).~
@1209 = ~Auto-Roller: an Auto-Roll button in character creation keeps the best of many rolls (18/xx strength weighted)~
@1210 = ~Wouldn't you rather identify our items?~
@1211 = ~I'd like to know more about this world.~
@1212 = ~Ah, let's see what my notes say...~
@1250 = ~Bring me a new companion.~
@1251 = ~One more soul for your band? I can shape one from nothing... or call back one you knew elsewhere. He will walk with you, as seasoned as your leader.~
@1252 = ~Shape him before me.~
@1253 = ~Call back someone I knew (import).~
@1254 = ~Another time.~
@1255 = ~Withers: new companion~
@1256 = ~Continue~
@1257 = ~Abandon~
@1258 = ~Does he keep the items he carried?~
@1259 = ~He keeps them~
@1260 = ~Leave them~
@1261 = ~Does he keep his own experience, or take the party leader's?~
@1262 = ~His own~
@1263 = ~The leader's~
@1264 = ~%s joins the party.~
@1265 = ~The party is full (%d members).~
@1266 = ~Withers recruits: a new companion made in the game's own creation screens or imported, free~
@1267 = ~The new companion's gear~
@1268 = ~Validate~
@1269 = ~Bought from the Grand Merchant: %d gp (party gold: %d gp)~
@1270 = ~Stash~
@1271 = ~%d gp~
@1272 = ~free~
@1273 = ~Melee weapon~
@1274 = ~Off hand~
@1275 = ~Ranged weapon~
@1276 = ~Ammunition~
@1277 = ~Armour~
@1278 = ~Helmet~
@1279 = ~Amulet~
@1280 = ~Rings (two)~
@1281 = ~Bracers / gauntlets~
@1282 = ~Belt~
@1283 = ~Boots~
@1284 = ~Cloak~
@1285 = ~Withers offers~
@1286 = ~Accept our gift for your temple: <SQPRRC> gp (reputation <SQPRREP> -> <SQPRNEXT>).~
@1287 = ~Heal the whole party: <SQPRHL>. Total: <SQPRHC> gp.~
@1288 = ~Bless you. The poor of the Coast will speak your names kindly.~
@1289 = ~It is done. Stand up, all of you, and walk in the light.~
@1290 = ~Alas, your purse is too light for that. Come back when you can.~
@1291 = ~resurrection~
@1292 = ~wounds~
@1293 = ~lost levels~
@1294 = ~curse~
@1295 = ~poison~
@1296 = ~disease~
@1297 = ~Necromancer~
@1298 = ~The dead have nothing better to do than help the living train. Name a foe, and it will rise before you... harmless, unless you ask otherwise.~
@1299 = ~Raise a creature for us.~
@1300 = ~Unleash them: let them fight, and die.~
@1301 = ~Calm them: make them undying puppets again.~
@1302 = ~Clean up: let them all fall.~
@1303 = ~Farewell.~
@1304 = ~How many <SQNECRN> shall rise?~
@1305 = ~One.~
@1306 = ~Two.~
@1307 = ~Three.~
@1308 = ~Five.~
@1309 = ~Ten.~
@1310 = ~None, I changed my mind.~
@1311 = ~Bind them to us: let them join our party.~
@1312 = ~It is done.~
