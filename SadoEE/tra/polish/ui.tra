@130 = ~Waga drużyny + skrzyni / suma udźwigów członków. Powyżej wszyscy są spowolnieni. Przedmioty w skrzyni, które mieszczą się w zebranej torbie (karta Torby), nic nie ważą.~ // weight_tip
@131 = ~Torba: Shift + podwójne kliknięcie lub Schowaj wszystko~ // msg_bag_hint
@132 = ~Przedmioty fabularne i torby zostają w plecaku~ // msg_quest_bags
@133 = ~Przedmioty fabularne zostają w plecaku~ // msg_quest
@134 = ~Nie można opróżnić ręki~ // msg_hand
@135 = ~Torby zostają w kolekcji~ // msg_bags_kept
@136 = ~Zawartość torby: ~ // msg_bag_contents
@137 = ~Przywracanie skrzyni: zrób miejsce w plecaku~ // msg_restore
@138 = ~Uwaga: twoje torby zostaną opróżnione do skrzyni, a pasujące przedmioty będą ważyć 0.~ // bags_warning
@139 = ~OK~ // bags_ok
