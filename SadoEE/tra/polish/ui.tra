@166 = ~Główna~ // ab_main_hand
@167 = ~Druga~ // ab_off_hand
@168 = ~2 bronie~ // ab_two_weapon
@169 = ~Opróżnić skrzynię? Zebrane torby wracają wypełnione przedmiotami, które mogą pomieścić; cała reszta spada na ziemię. Zrób to przed odinstalowaniem Party Stash.~ // empty_confirm
@170 = ~Ctrl + lewy przycisk: opróżnij skrzynię do toreb i na ziemię (przed odinstalowaniem)\nPrawy przycisk: odłóż plecak lub tę stronę skrzyni (poza cennymi i questowymi przedmiotami) do następnego otwartego pojemnika\n*Panel pojemnika: czerwony przycisk w prawym dolnym rogu robi to samo~ // bag_tip
@171 = ~To twoja skrzynia~ // help_stash_title
@172 = ~Kliknięcie: wyjmij przedmiot (podwójne: wyjmij i załóż)\nCtrl + kliknięcie: zaznacz do sprzedaży (Sprzedaj zazn. u kupca)\nAlt + kliknięcie: cenny (złoty, nigdy nie sprzedawany)\nPrawy przycisk: opis. Kółko myszy: przewijanie\n*Karty: filtrowanie skrzyni według kategorii (kółko lub strzałki, by zobaczyć wszystkie)\n*Broń: obrażenia na rundę w podpowiedzi~ // help_stash
@173 = ~To ekwipunek twojej postaci (2 górne rzędy)~ // help_pack_title
@174 = ~Shift + podwójne kliknięcie lub przeciągnięcie na skrzynię: schowaj przedmiot\nSpacja lub Schowaj wszystko: schowaj cały plecak\n*Skrzynia w ostatnim miejscu: twoja skrzynia; gra liczy jej przedmioty jako noszone (zadania).\nCtrl + kliknięcie: zaznacz do sprzedaży (trafia do skrzyni)\nAlt + kliknięcie: cenny (złoty, nigdy nie sprzedawany)~ // help_pack
@175 = ~Spacja: schowaj cały plecak.\nPrzedmioty fabularne zostają w plecaku; torby wymagają potwierdzenia.~ // help_storeall
@176 = ~Kliknięcie: zmień sortowanie\nPrawy przycisk: odwróć je\n*Auto: każda zakładka własny porządek (broń według obrażeń na rundę dla pokazanej postaci, zbroje według KP, zwoje według klasy i poziomu...).\n*Także: Data, Jakość, Typ, Cena, szt/fnt.~ // help_sort
@177 = ~Schowaj torbę (Shift + podwójne kliknięcie lub Schowaj wszystko): zostaje opróżniona do skrzyni i zachowana tutaj.\nPrzedmioty ze skrzyni, które może pomieścić, nic nie ważą.~ // help_bags
@178 = ~%d zaznaczonych przedmiotów zostanie sprzedanych za %d szt. zł.\n%d zaznaczonych przedmiotów pominięto (bez wartości, fabularne lub tu nieskupowane).~ // help_sell
@179 = ~Skrzynia drużyny: gra liczy jej przedmioty jako noszone (zadania).~ // stash_slot_tip
@180 = ~%s obrażeń/rundę, THAC0 %d~ // dps_line
@181 = ~Ataki/rundę: %s~ // st_apr
@182 = ~ (odwr.)~ // sort_rev
@183 = ~Cennego przedmiotu nie można położyć na ziemi~ // msg_valuable_ground
@184 = ~Otwórz pojemnik, który ma przyjąć przedmioty (Esc anuluje)~ // dump_armed
@185 = ~Odłożyć do tego pojemnika: plecak (%d przedmiotów) czy tę stronę skrzyni (%d przedmiotów)?~ // dump_confirm
@186 = ~Odłożono %d przedmiotów do pojemnika~ // dump_done
@187 = ~Nic do odłożenia~ // dump_none
@188 = ~Odkładanie anulowane~ // dump_cancel
@189 = ~Plecak~ // dump_backpack
@190 = ~Strona skrzyni~ // dump_stashpage
@191 = ~Włóż plecak lub ostatnio pokazaną stronę skrzyni do tego pojemnika (bez cennych i questowych przedmiotów)~ // container_tip
@195 = ~Pomoc: co Party Stash dodaje do tej strony~ // help_btn_tip
@196 = ~Torba wagi~ // bubble_weight_t
@197 = ~Karty~ // bubble_tabs_t
@198 = ~Filtrowanie skrzyni według kategorii\nKółko lub strzałki: zobacz wszystkie karty\n*Torby: zebrane torby; przedmioty skrzyni, które mogą pomieścić, nic nie ważą~ // bubble_tabs
@199 = ~Sortowanie~ // bubble_sort_t
@200 = ~Ziemia~ // bubble_ground_t
@201 = ~Przedmioty na ziemi wokół drużyny\nPrzeciągnij: połóż lub podnieś przedmiot\nCennych przedmiotów nie można tu położyć~ // bubble_ground
@202 = ~Kliknij gdziekolwiek, aby zamknąć~ // bubble_close
@203 = ~Notatki~ // tab_notes
@204 = ~DPS~ // sort_dps
@205 = ~Poziom~ // sort_level
@206 = ~Ten przedmiot nie może tam trafić~ // msg_cannot_equip
@207 = ~Plecak towarzysza jest pełny~ // msg_comp_full
@208 = ~Poziom %d~ // ab_level
@209 = ~Ukryj hełm~ // helm_hide
