@168 = ~2 оружия~ // ab_two_weapon
@169 = ~Опустошить сундук? Собранные сумки вернутся заполненными предметами, которые они вмещают; всё остальное упадёт на землю. Сделайте это перед удалением Party Stash.~ // empty_confirm
@170 = ~Ctrl + левый щелчок: разложить сундук по сумкам и на землю (перед удалением)\nПравый щелчок: положить рюкзак или эту страницу сундука (кроме ценных и квестовых предметов) в следующий открытый контейнер\n*Панель контейнера: красная кнопка справа внизу делает то же самое~ // bag_tip
@171 = ~Это ваш сундук~ // help_stash_title
@172 = ~Щелчок: взять предмет (двойной: взять и надеть)\nCtrl + щелчок: отметить для продажи («Продать отмеч.» у торговца)\nAlt + щелчок: ценный (золотой, не продаётся)\nПравый щелчок: описание. Колесо мыши: прокрутка\n*Вкладки: фильтр сундука по категориям (колесо или стрелки, чтобы увидеть все)\n*Оружие: урон за раунд в подсказке~ // help_stash
@173 = ~Это инвентарь вашего персонажа (2 верхних ряда)~ // help_pack_title
@174 = ~Shift + двойной щелчок или перетаскивание на сундук: убрать предмет\nПробел или «Убрать всё»: убрать весь рюкзак\n*Сундук в последней ячейке: ваш сундук; игра считает его предметы носимыми (квесты).\nCtrl + щелчок: отметить для продажи (уходит в сундук)\nAlt + щелчок: ценный (золотой, не продаётся)~ // help_pack
@175 = ~Пробел: убрать весь рюкзак.\nКвестовые предметы остаются в рюкзаке; сумки требуют подтверждения.~ // help_storeall
@176 = ~Щелчок: сменить сортировку\nПравый щелчок: обратить её\n*Авто: у каждой вкладки свой порядок (оружие по урону за раунд для показанного персонажа, доспехи по КБ, свитки по классу и уровню...).\n*Также: Дата, Качество, Тип, Цена, зм/фнт.~ // help_sort
@177 = ~Уберите сумку (Shift + двойной щелчок или «Убрать всё»): она высыпается в сундук и хранится здесь.\nПредметы сундука, которые она вмещает, ничего не весят.~ // help_bags
@178 = ~Отмеченных предметов будет продано: %d, за %d зм.\nПропущено отмеченных: %d (без цены, квестовые или здесь не покупаются).~ // help_sell
@179 = ~Сундук отряда: игра считает его предметы носимыми (квесты).~ // stash_slot_tip
@180 = ~%s урона/раунд, THAC0 %d~ // dps_line
@181 = ~Атак за раунд: %s~ // st_apr
@182 = ~ (обр.)~ // sort_rev
@183 = ~Ценный предмет нельзя положить на землю~ // msg_valuable_ground
@184 = ~Откройте контейнер, который примет предметы (Esc — отмена)~ // dump_armed
@185 = ~Положить в этот контейнер: рюкзак (%d предметов) или эту страницу сундука (%d предметов)?~ // dump_confirm
@186 = ~%d предметов положено в контейнер~ // dump_done
@187 = ~Нечего убрать~ // dump_none
@188 = ~Укладка отменена~ // dump_cancel
@189 = ~Рюкзак~ // dump_backpack
@190 = ~Страница сундука~ // dump_stashpage
@191 = ~Положить рюкзак или последнюю показанную страницу сундука в этот контейнер (кроме ценных и квестовых предметов)~ // container_tip
@195 = ~Справка: что Party Stash добавляет на эту страницу~ // help_btn_tip
@196 = ~Сумка веса~ // bubble_weight_t
@197 = ~Вкладки~ // bubble_tabs_t
@198 = ~Фильтр сундука по категориям\nКолесо или стрелки: все вкладки\n*Сумки: собранные сумки; предметы сундука, которые они вмещают, ничего не весят~ // bubble_tabs
@199 = ~Сортировка~ // bubble_sort_t
@200 = ~Земля~ // bubble_ground_t
@201 = ~Предметы на земле вокруг отряда\nПеретаскивание: положить или поднять предмет\nЦенные предметы сюда положить нельзя~ // bubble_ground
@202 = ~Щёлкните где угодно, чтобы закрыть~ // bubble_close
@203 = ~Записки~ // tab_notes
