@1 = ~Party Stash: végtelen láda az egész csapatnak (EEex szükséges). Eltávolítás előtt: Ctrl + bal kattintás a súly zsákjára a láda kiürítéséhez~
@2 = ~EEex szükséges.~
@3 = ~Láda~
@4 = ~Minden karakter viseli, hogy a játék a tartalmát viseltnek tekintse (küldetések). Az egész csapat közös ládája a felszerelés oldalon. Kattints egy tárgyra a felvételéhez; Shift + dupla kattintás egy hátizsákban lévő tárgyon vagy Szóköz (Mindet elrak) az elrakáshoz; Ctrl + kattintás megjelöl egy tárgyat eladásra a kereskedő „Jelöltek eladása” gombjával. A ládába tett zsák kiürül bele, és a Zsákok fülön marad: a láda tárgyai, amelyeket befogad, nem nyomnak semmit. A többi a tagok teherbírásának összegébe számít; felette mindenki lelassul.~
@5 = ~Rendezett zsákmány: a földön, a tárolókban és a zsákmánysávon~
@6 = ~Baldur's Gate 1 kinézet (ajánlott)~
@7 = ~Baldur's Gate II kinézet (ajánlott)~
@8 = ~Party Stash: eltávolítás előtt ürítsd ki a ládát a játékban: Ctrl + bal kattintás a súly melletti nagy zsákra a felszerelés oldalon. A gyűjtött zsákjaid visszakerülnek, megtöltve a beléjük férő tárgyakkal; minden más a földre esik. Különben a láda tartalma a mentésekben marad, de a mod újratelepítéséig elérhetetlen.~
@9 = ~Baldur's Gate 1 kinézet~
@10 = ~Baldur's Gate II kinézet~
@11 = ~Party Stash: végtelen láda az egész csapatnak (EEex szükséges). Eltávolítás előtt: Ctrl + bal kattintás a súly zsákjára a láda kiürítéséhez~
@12 = ~Csak a Baldur's Gate: Enhanced Editionhöz.~
@13 = ~Csak a Baldur's Gate II: Enhanced Editionhöz / EET-hez.~
@14 = ~Lehetőség: a láda nem nyom semmit~
@15 = ~Lehetőség: a csapat aranya megmarad a hadjáratváltásoknál (BG1-ből SoD, SoD-ből BG2 az EET-ben)~
@16 = ~Lehetőség (hardcore): a hadjáratváltások a ládát is kiürítik, mint mindent, amit a csapat visz~
@17 = ~Party Stash szükséges.~
@18 = ~Nagykereskedő: mindent árul, ami a már meglátogatott boltok raktárán van (a SadoQoL táborához)~
@19 = ~Nagykereskedő~
@20 = ~Küldetéskrónika: Decard megnyitja a játék összes küldetésének listáját (állapot, napló, tippek, teljes megoldás)~
@21 = ~Decard, a tábor öreg tudósa szükséges (SadoQoL / SadoEE).~
@40 = ~Nagy csapat: 7-32 tag (egy további portrésáv, a játék szkriptjei és párbeszédei kiterjesztve a 7. és további tagokra)~
@41 = ~Csak a Baldur's Gate: Enhanced Editionhöz és az EET-hez.~
