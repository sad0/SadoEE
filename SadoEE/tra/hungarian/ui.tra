@129 = ~Jártasság: %d~ // cmp_skill
@130 = ~A csapat + láda súlya / a tagok teherbírásának összege. Felette mindenki lelassul. A láda tárgyai, amelyek beférnek egy összegyűjtött zsákba (Zsákok fül), nem nyomnak semmit.~ // weight_tip
@131 = ~Zsák: Shift + dupla kattintás vagy Mindet elrak~ // msg_bag_hint
@132 = ~A küldetéstárgyak és a zsákok a hátizsákban maradnak~ // msg_quest_bags
@133 = ~A küldetéstárgyak a hátizsákban maradnak~ // msg_quest
@134 = ~Nem sikerült kiüríteni a kezet~ // msg_hand
@135 = ~A zsákok a gyűjteményben maradnak~ // msg_bags_kept
@136 = ~A zsák tartalma: ~ // msg_bag_contents
@137 = ~Láda visszaállítása: szabadíts fel helyet egy hátizsákban~ // msg_restore
@138 = ~Figyelem: a zsákjaid a ládába ürülnek, és a megfelelő tárgyak súlya 0 lesz.~ // bags_warning
@139 = ~OK~ // bags_ok
@140 = ~Nyak~ // slot_neck
