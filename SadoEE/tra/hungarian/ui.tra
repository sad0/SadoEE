@169 = ~Kiüríted a ládát? A gyűjtött zsákjaid visszakerülnek, megtöltve a beléjük férő tárgyakkal; minden más a földre esik. Ezt a Party Stash eltávolítása előtt tedd meg.~ // empty_confirm
@170 = ~Ctrl + bal kattintás: a láda kiürítése a zsákokba és a földre (eltávolítás előtt)\nJobb kattintás: a hátizsák vagy e ládaoldal (az értékes és küldetéstárgyak kivételével) elrakása a következő megnyitott tárolóba\n*A tároló panelje: a jobb alsó piros gomb ugyanezt teszi~ // bag_tip
@171 = ~Ez a ládád~ // help_stash_title
@172 = ~Kattintás: tárgy kivétele (dupla: kivétel és felvétel)\nCtrl + kattintás: megjelölés eladásra (Jelöltek eladása a kereskedőnél)\nAlt + kattintás: értékes (aranyszínű, sosem adja el)\nJobb kattintás: leírás. Egérgörgő: görgetés\n*Fülek: a láda szűrése kategória szerint (görgő vagy nyilak az összeshez)\n*Fegyverek: körönkénti sebzés a súgóban~ // help_stash
@173 = ~Ez a karaktered felszerelése (a 2 felső sor)~ // help_pack_title
@174 = ~Shift + dupla kattintás, vagy ráhúzás a ládára: tárgy elrakása\nSzóköz vagy Mindet elrak: az egész hátizsák elrakása\n*A láda az utolsó helyen: a ládád; a játék a tárgyait viseltnek tekinti (küldetések).\nCtrl + kattintás: eladásra jelölés (a ládába kerül)\nAlt + kattintás: értékes (aranyszínű, sosem adja el)~ // help_pack
@175 = ~Szóköz: az egész hátizsák elrakása.\nA küldetéstárgyak a hátizsákban maradnak; a zsákok megerősítést kérnek.~ // help_storeall
@176 = ~Kattintás: rendezés váltása\nJobb kattintás: megfordítás\n*Auto: minden fülnek saját sorrendje (fegyverek a mutatott karakter körönkénti sebzése szerint, páncélok VO szerint, tekercsek kaszt és szint szerint...).\n*Továbbá: Dátum, Minőség, Típus, Ár, at/font.~ // help_sort
@177 = ~Rakj el egy zsákot (Shift + dupla kattintás vagy Mindet elrak): kiürül a ládába, és itt marad.\nA láda tárgyai, amelyeket befogad, nem nyomnak semmit.~ // help_bags
@178 = ~Eladásra kerülő jelölt tárgyak: %d, %d aranyért.\nKihagyott jelölt tárgyak: %d (értéktelen, küldetéstárgy vagy itt nem vásárolják).~ // help_sell
@179 = ~A csapat ládája: a játék a tárgyait viseltnek tekinti (küldetések).~ // stash_slot_tip
@180 = ~%s sebzés/kör, THAC0 %d~ // dps_line
@181 = ~Támadás/kör: %s~ // st_apr
@182 = ~ (ford.)~ // sort_rev
@183 = ~Értékes tárgyat nem lehet a földre tenni~ // msg_valuable_ground
@184 = ~Nyisd meg a tárolót, amelybe a tárgyak kerüljenek (Esc: mégse)~ // dump_armed
@185 = ~Mi kerüljön ebbe a tárolóba: a hátizsák (%d tárgy) vagy ez a ládaoldal (%d tárgy)?~ // dump_confirm
@186 = ~%d tárgy a tárolóba téve~ // dump_done
@187 = ~Nincs mit elrakni~ // dump_none
@188 = ~Elrakás megszakítva~ // dump_cancel
@189 = ~Hátizsák~ // dump_backpack
@190 = ~Ládaoldal~ // dump_stashpage
@191 = ~A hátizsák vagy a legutóbb mutatott ládaoldal betétele ebbe a tárolóba (az értékes és küldetéstárgyak kivételével)~ // container_tip
@195 = ~Súgó: mit ad hozzá a Party Stash ehhez az oldalhoz~ // help_btn_tip
@196 = ~Súly zsák~ // bubble_weight_t
@197 = ~Fülek~ // bubble_tabs_t
@198 = ~A láda szűrése kategória szerint\nGörgő vagy nyilak: az összes fül\n*Zsákok: a begyűjtött zsákok; a láda tárgyai, amelyeket befogadnak, nem nyomnak semmit~ // bubble_tabs
@199 = ~Rendezés~ // bubble_sort_t
@200 = ~Föld~ // bubble_ground_t
@201 = ~Tárgyak a földön a csapat körül\nHúzás: tárgy letétele vagy felvétele\nÉrtékes tárgyat nem lehet ide tenni~ // bubble_ground
@202 = ~Kattintson bárhová a bezáráshoz~ // bubble_close
