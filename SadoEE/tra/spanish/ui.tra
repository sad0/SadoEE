@200 = ~Suelo~ // bubble_ground_t
@201 = ~Objetos en el suelo alrededor del grupo\nArrastrar: dejar o recoger objetos\nLos objetos valiosos no se pueden dejar aquí~ // bubble_ground
@202 = ~Haz clic en cualquier sitio para cerrar~ // bubble_close
