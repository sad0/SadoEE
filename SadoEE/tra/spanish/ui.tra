@130 = ~Peso del grupo + baúl / suma de las cargas máximas de los miembros. Por encima, todos van más lentos. Los objetos del baúl que cabe en una bolsa coleccionada (pestaña Bolsas) no pesan nada.~ // weight_tip
@131 = ~Bolsa: Mayús + doble clic o Guardar todo~ // msg_bag_hint
@132 = ~Los objetos de misión y las bolsas se quedan en la mochila~ // msg_quest_bags
@133 = ~Los objetos de misión se quedan en la mochila~ // msg_quest
@134 = ~No se pudo vaciar la mano~ // msg_hand
@135 = ~Las bolsas se quedan en la colección~ // msg_bags_kept
@136 = ~Contenido de la bolsa: ~ // msg_bag_contents
@137 = ~Restaurar el baúl: libera un hueco en una mochila~ // msg_restore
@138 = ~Atención: tus bolsas se vaciarán en el baúl y los objetos correspondientes pesarán 0.~ // bags_warning
