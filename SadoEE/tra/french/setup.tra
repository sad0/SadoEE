@1 = ~Party Stash : un coffre infini partagé par tout le groupe (nécessite EEex). Avant de désinstaller : Ctrl + clic gauche sur le sac du poids pour vider le coffre~
@2 = ~Nécessite EEex.~
@3 = ~Coffre~
@4 = ~Chaque personnage le porte pour que le jeu compte son contenu comme porté (quêtes). Le coffre partagé de tout le groupe, sur la page d'inventaire. Cliquez sur un objet pour le prendre ; Maj + double-clic sur un objet du sac à dos ou Espace (Tout ranger) pour ranger ; Ctrl + clic coche un objet à vendre avec le bouton « Vendre cochés » du marchand. Un sac rangé dans le coffre y est vidé et gardé dans l'onglet Sacs : les objets du coffre qu'il peut contenir ne pèsent rien. Le reste compte dans la somme des charges maximales des membres ; au-delà, tout le monde est ralenti.~
@5 = ~Butin trié : au sol, dans les contenants et dans la barre de butin~
@6 = ~Look Baldur's Gate 1 (recommandé)~
@7 = ~Look Baldur's Gate II (recommandé)~
@8 = ~Party Stash : avant de désinstaller, videz le coffre en jeu : Ctrl + clic gauche sur le gros sac à côté du poids, sur la page d'inventaire. Vos sacs collectionnés reviennent remplis des objets qu'ils peuvent contenir ; tout le reste tombe au sol. Sinon, le contenu du coffre reste dans vos sauvegardes mais devient inaccessible jusqu'à la réinstallation du mod.~
@9 = ~Look Baldur's Gate 1~
@10 = ~Look Baldur's Gate II~
@11 = ~Party Stash : un coffre infini partagé par tout le groupe (nécessite EEex). Avant de désinstaller : Ctrl + clic gauche sur le sac du poids pour vider le coffre~
@12 = ~Uniquement pour Baldur's Gate: Enhanced Edition.~
@13 = ~Uniquement pour Baldur's Gate II: Enhanced Edition / EET.~
@14 = ~Option : le coffre ne pèse rien~
@15 = ~Option : garder l'or du groupe aux changements de campagne (BG1 vers SoD, SoD vers BG2 dans EET)~
@16 = ~Option (hardcore) : les changements de campagne vident aussi le coffre, comme tout ce que porte le groupe~
@17 = ~Nécessite Party Stash.~
@18 = ~Grand marchand du camp : vend tout objet vu chez les marchands déjà visités (pour le camp de SadoQoL)~
@19 = ~Grand marchand~
@20 = ~Chronique des quêtes : Decard ouvre la liste de toutes les quêtes du jeu (statut, journal, indices, solution complète)~
@21 = ~Nécessite le vieil érudit Decard au camp (SadoQoL / SadoEE).~
@40 = ~Grand groupe : de 7 à 32 membres (barre de portraits en plus, scripts et dialogues du jeu étendus aux membres 7+)~
@41 = ~Pour Baldur's Gate: Enhanced Edition et EET uniquement.~
