// ex-SadoQoL strings (GENERATED by build_sadoee.py from SadoQoL/tra; @N there = @1000 + N here)
@1001 = ~Détection passive des pièges : les voleurs repèrent les pièges sans le mode Détection des pièges (nécessite EEex)~
@1002 = ~Nécessite EEex.~
@1003 = ~Piège repéré~
@1004 = ~Contenants précieux : les contenants qui renferment un objet de valeur (valeur/poids élevé, magique, bijou, gemme, parchemin) ont un contour doré permanent (nécessite EEex)~
@1020 = ~Désamorçage automatique : hors combat, chaque voleur inactif dont la détection est active désamorce les pièges repérés qu'il peut désamorcer ; un clic sur un contenant piégé ou verrouillé envoie le meilleur désamorceur, crocheteur ou forceur (nécessite EEex)~
@1021 = ~Je m'occupe du piège~
@1022 = ~Je crochète la serrure~
@1023 = ~Je force la serrure~
@1024 = ~Personne ici ne peut désamorcer ce piège (recliquer pour l'ouvrir quand même)~
@1025 = ~Personne ici ne peut ouvrir cette serrure~
@1030 = ~Butin trié : au sol, dans les contenants et dans la barre de butin, les objets de quête, puis les objets sans poids, puis le reste par valeur/poids (nécessite EEex)~
@1040 = ~Espace personnel réduit de moitié : toutes les créatures prennent deux fois moins de place, le groupe ne se bloque plus dans les couloirs (nécessite EEex)~
@1042 = ~L'espace personnel réduit a été retiré : il cassait la portée de mêlée.~
@1050 = ~Compteur FPS : images par seconde et image la plus lente en haut de l'écran de jeu, F12 l'affiche ou le masque (nécessite EEex)~
@1060 = ~Munitions infinies : les flèches, carreaux, billes, fléchettes et armes de jet du groupe ne s'épuisent jamais, sauf les plus puissantes ; avec un arc, une arbalète ou une fronde équipé, des munitions de base attendent toujours dans le premier emplacement de carquois vide (nécessite EEex)~
@1070 = ~Empreinte réduite du groupe : le groupe ne se bloque plus dans les couloirs, la portée de mêlée ne change pas (nécessite EEex)~
@1071 = ~1 case par personnage~
@1072 = ~Aucune case : le groupe traverse tout le monde, et tout le monde le traverse~
@1090 = ~Modes durables : chant du barde, renvoi des morts-vivants, furtivité et danse du chaman restent actifs pendant que le personnage agit ; le bouton Détection des pièges active ou coupe la détection passive (nécessite EEex)~
@1091 = ~Détection des pièges : activée~
@1092 = ~Détection des pièges : désactivée~
@1100 = ~Camp de repos : un parchemin au-dessus du bouton Voyager de la carte du monde mène à un campement paisible (0 h aller-retour, repos sans embuscade) (nécessite EEex)~
@1101 = ~Camp~
@1102 = ~Retour~
@1110 = ~Que la lumière veille sur votre campement, voyageurs. Les blessés, les maudits et ceux qui ont perdu un compagnon trouveront ici réconfort. Puis-je vous aider ?~
@1111 = ~Montrez-moi ce que vous proposez.~
@1112 = ~Pas pour l'instant, merci.~
@1113 = ~Prêtre itinérant~
@1114 = ~Services du prêtre itinérant~
@1115 = ~Grand marchand~
@1116 = ~Bienvenue au camp ! Tout ce que vous avez vu dans les échoppes de la Côte, je peux vous le procurer, au meilleur prix.~
@1117 = ~Voyons ce que vous avez.~
@1118 = ~Pas maintenant.~
@1119 = ~Mes chariots ne sont pas encore arrivés, revenez plus tard.~
@1120 = ~Attaque-déplacement : le groupe sélectionné marche vers le curseur en combattant chaque ennemi vu en chemin, comme dans un RTS ; raccourci réglé par le composant Boutons de souris (bouton 4 par défaut) (nécessite EEex)~
@1130 = ~Boutons de souris : clic molette, boutons 4 à 8 et Shift / Ctrl + molette lancent des actions SadoEE, au choix dans le menu Options d'EEex (nécessite EEex)~
@1131 = ~SadoEE~
@1132 = ~Rien~
@1133 = ~Attaque-déplacement~
@1134 = ~Aura pièges~
@1135 = ~Compteur FPS~
@1136 = ~Action lancée par ce bouton. Rien : le jeu garde son comportement normal.~
@1137 = ~Clic molette~
@1138 = ~Bouton 4~
@1139 = ~Bouton 5~
@1140 = ~Bouton 6~
@1141 = ~Bouton 7~
@1142 = ~Bouton 8~
@1143 = ~Shift + molette haut~
@1144 = ~Shift + molette bas~
@1145 = ~Ctrl + molette haut~
@1146 = ~Ctrl + molette bas~
@1150 = ~Le groupe garde son équipement à la mort~
@1151 = ~Coffres dans la barre des objets au sol~
@1160 = ~Le Vieux Lettré au camp (identifie tout, 80 po par objet)~
@1161 = ~Ah, voyageurs ! Venez, asseyez-vous un moment près du feu et écoutez. Ces vieux yeux ont lu plus de runes qu'il n'y a d'étoiles ce soir. Montrez-moi ce que vous portez, et je vous dirai ce que c'est vraiment.~
@1162 = ~Tu veux pas identifier nos objets plutôt ? (<SQCAINN> objets × <SQCAINP> po = <SQCAINC> po)~
@1163 = ~Voyons... <SQCAINN> de vos affaires gardent leurs secrets. Pour <SQCAINC> pièces d'or, je les nommerai toutes.~
@1164 = ~Allez-y.~
@1165 = ~Voilà. Chacun m'a conté son histoire, et vous la connaissez à présent. Faites-en bon usage, mon ami.~
@1166 = ~Pas maintenant.~
@1167 = ~Tout ce que vous portez vous est déjà connu. Revenez quand la route vous aura apporté de nouvelles énigmes.~
@1168 = ~Hélas, votre bourse est trop légère : <SQCAINC> pièces d'or, pas moins. Même un vieux savant doit manger.~
@1169 = ~Fort bien, regardons vos trésors.~
@1170 = ~Racontez-nous une histoire, vieil homme.~
@1171 = ~Il y a longtemps, les savants de mon ordre ont enfermé de terribles choses dans la pierre et enfoui ces pierres très profond. Toutes n'ont pas tenu, je le crains. Si vous trouvez une gemme qui murmure la nuit... apportez-la-moi d'abord.~
@1172 = ~Adieu.~
@1173 = ~Le Vieux Lettré~
@1174 = ~Attente au camp : un membre qui quitte le groupe peut t'attendre au camp de repos, autour du feu~
@1175 = ~Withers au camp : une liche qui recrée entièrement un membre du groupe (race, classe, kit, caractéristiques...), gratuitement~
@1176 = ~Withers~
@1177 = ~%s : %s est parti dans le coffre (sac plein)~
@1178 = ~Continuer~
@1179 = ~Terminer~
@1180 = ~Je t'attends au camp ?~
@1181 = ~Oui, attends-moi au camp.~
@1182 = ~Non, reste ici.~
@1183 = ~On repart ?~
@1184 = ~Rejoins-nous.~
@1185 = ~Pas encore.~
@1186 = ~Valider~
@1187 = ~Pas de jumelage~
@1188 = ~%s : %d PX rendus après le jumelage~
@1190 = ~Mortel. Tu portes la forme que le monde t'a donnée. Je peux la défaire, et tu en choisiras une autre... depuis le tout début.~
@1191 = ~Refais-moi.~
@1192 = ~Pas aujourd'hui.~
@1193 = ~Sache ceci : une fois commencé, il n'y a pas de retour. Race, vocation, esprit et corps, tout sera choisi à nouveau. Tes souvenirs et tes biens demeurent. Dois-je commencer ?~
@1194 = ~Commence.~
@1195 = ~J'y réfléchirai.~
@1196 = ~Coffre du camp~
@1197 = ~*Le couvercle s'ouvre en grinçant.*~
@1198 = ~Niveau avant le jumelage~
@1199 = ~Niveau %d : %d PX maintenant, %d PX une fois jumelé~
@1200 = ~%s : %d sorts sont partis dans le grimoire~
@1201 = ~%s apprend %s~
@1202 = ~%s (niveau %d)~
@1203 = ~Grimoire - lu par %s~
@1204 = ~Ouvrir le grimoire~
@1205 = ~Apprendre~
@1206 = ~Fermer~
@1207 = ~Grimoire des sorts perdus~
@1208 = ~Les sorts qu'un mage a oubliés quand Withers l'a refait reposent dans ces pages. Ouvre-le : quiconque sait écrire des sorts de mage dans son grimoire les réapprend (ceux qu'il peut lancer).~
@1209 = ~Auto-Roller : un bouton Auto-Roll à la création de personnage garde le meilleur de nombreux jets (force 18/xx pondérée)~
@1210 = ~Tu veux pas identifier nos objets plutôt ?~
@1211 = ~Je voudrais en savoir plus sur ce monde.~
@1212 = ~Ah, voyons ce que disent mes notes...~
@1250 = ~Amène-moi un nouveau compagnon.~
@1251 = ~Une âme de plus pour ta troupe ? Je peux en façonner une de rien... ou en rappeler une que tu as connue ailleurs. Il marchera avec vous, aussi aguerri que ton chef.~
@1252 = ~Façonne-le devant moi.~
@1253 = ~Rappelle quelqu'un que j'ai connu (importer).~
@1254 = ~Une autre fois.~
@1255 = ~Withers : nouveau compagnon~
@1256 = ~Continuer~
@1257 = ~Abandonner~
@1258 = ~Garde-t-il les objets qu'il portait ?~
@1259 = ~Il les garde~
@1260 = ~Les laisser~
@1261 = ~Garde-t-il sa propre expérience, ou prend-il celle du chef du groupe ?~
@1262 = ~La sienne~
@1263 = ~Celle du chef~
@1264 = ~%s rejoint le groupe.~
@1265 = ~Le groupe est complet (%d membres).~
@1266 = ~Withers recrute : un nouveau compagnon créé dans les écrans de création du jeu ou importé, gratuit~
@1267 = ~Équipement du nouveau compagnon~
@1268 = ~Valider~
@1269 = ~Achats chez le Grand marchand : %d po (or du groupe : %d po)~
@1270 = ~Stash~
@1271 = ~%d po~
@1272 = ~offert~
@1273 = ~Arme de mêlée~
@1274 = ~Main gauche~
@1275 = ~Arme à distance~
@1276 = ~Munitions~
@1277 = ~Armure~
@1278 = ~Casque~
@1279 = ~Amulette~
@1280 = ~Anneaux (deux)~
@1281 = ~Bracelets / gantelets~
@1282 = ~Ceinture~
@1283 = ~Bottes~
@1284 = ~Cape~
@1285 = ~Withers propose~
@1286 = ~Acceptez notre don pour votre temple : <SQPRRC> po (réputation <SQPRREP> -> <SQPRNEXT>).~
@1287 = ~Soignez tout le groupe : <SQPRHL>. Total : <SQPRHC> po.~
@1288 = ~Soyez bénis. Les pauvres de la Côte prononceront vos noms avec gratitude.~
@1289 = ~C'est fait. Relevez-vous, tous, et marchez dans la lumière.~
@1290 = ~Hélas, votre bourse est trop légère pour cela. Revenez quand vous le pourrez.~
@1291 = ~résurrection~
@1292 = ~blessures~
@1293 = ~niveaux perdus~
@1294 = ~malédiction~
@1295 = ~poison~
@1296 = ~maladie~
@1297 = ~Nécromancien~
@1298 = ~Les morts n'ont rien de mieux à faire qu'entraîner les vivants. Nommez un adversaire et il se relèvera devant vous... inoffensif, à moins que vous ne demandiez le contraire.~
@1299 = ~Relevez une créature pour nous.~
@1300 = ~Déchaînez-les : qu'ils se battent, et meurent.~
@1301 = ~Calmez-les : qu'ils redeviennent des pantins immortels.~
@1302 = ~Faites le ménage : qu'ils tombent tous.~
@1303 = ~Adieu.~
@1304 = ~Combien de <SQNECRN> doivent se relever ?~
@1305 = ~Un seul.~
@1306 = ~Deux.~
@1307 = ~Trois.~
@1308 = ~Cinq.~
@1309 = ~Dix.~
@1310 = ~Aucun, j'ai changé d'avis.~
@1311 = ~Liez-les à nous : qu'ils rejoignent notre groupe.~
@1312 = ~C'est fait.~
@1313 = ~Bestiaire~
@1314 = ~Monstres~
@1315 = ~Humains~
@1316 = ~Rechercher~
@1317 = ~Relever~
@1318 = ~Fermer~
@1319 = ~Niveau~
@1320 = ~PV~
@1321 = ~CA~
@1322 = ~Dégâts~
@1323 = ~Total~
@1324 = ~Effacer~
@1325 = ~%d créatures~
@1326 = ~Nécromancien du camp : mannequins d'entraînement tirés de tout le bestiaire, compteur de dégâts (nécessite le campement)~
@1340 = ~Soignez nos blessures, s'il vous plaît.~
@1341 = ~Voilà. Reposez-vous : la lumière ne demande rien pour cela.~
@1342 = ~La prêtresse a pansé vos blessures pendant votre sommeil.~
@1343 = ~La prêtresse soigne les blessures du groupe.~
@1344 = ~Tarifs de la prêtresse du camp~
@1345 = ~Tarifs de la prêtresse du camp : 75 %~
@1346 = ~Tarifs de la prêtresse du camp : 50 %~
@1347 = ~Tarifs de la prêtresse du camp : 25 %~
@1348 = ~Tarifs de la prêtresse du camp : gratuit~
