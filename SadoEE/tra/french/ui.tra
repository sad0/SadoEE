@130 = ~Poids du groupe + coffre / somme des charges maximales des membres. Au-delà, tout le monde est ralenti. Les objets du coffre qu'un sac collectionné peut contenir (onglet Sacs) ne pèsent rien.~ // weight_tip
@131 = ~Sac : Maj + double-clic ou Tout ranger~ // msg_bag_hint
@132 = ~Les objets de quête et les sacs restent dans le sac à dos~ // msg_quest_bags
@133 = ~Les objets de quête restent dans le sac à dos~ // msg_quest
@134 = ~Impossible de vider la main~ // msg_hand
@135 = ~Les sacs restent dans la collection~ // msg_bags_kept
