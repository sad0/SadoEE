@169 = ~Vider le coffre ? Vos sacs collectionnés reviennent remplis des objets qu'ils peuvent contenir ; tout le reste tombe au sol. À faire avant de désinstaller Party Stash.~ // empty_confirm
@170 = ~Ctrl + clic gauche : vider le coffre dans vos sacs et au sol (avant de désinstaller)\nClic droit : déposer le sac à dos ou cette page du coffre (sauf objets précieux et de quête) dans le prochain conteneur ouvert\n*Panneau du conteneur : le bouton rouge en bas à droite fait la même chose~ // bag_tip
@171 = ~Voici votre coffre~ // help_stash_title
@172 = ~Clic : prendre un objet (double-clic : prendre et équiper)\nCtrl + clic : le cocher pour la vente (Vendre cochés chez un marchand)\nAlt + clic : précieux (doré, jamais vendu)\nClic droit : description. Molette : défiler\n*Onglets : filtrer le coffre par catégorie (molette ou flèches pour tous les voir)\n*Armes : dégâts par round dans l'infobulle~ // help_stash
@173 = ~Voici l'inventaire de votre personnage (les 2 lignes du haut)~ // help_pack_title
@174 = ~Maj + double-clic, ou glisser sur le coffre : ranger un objet\nEspace ou Tout ranger : ranger tout le sac à dos\n*Le coffre dans la dernière case : votre coffre ; le jeu compte ses objets comme portés (quêtes).\nCtrl + clic : cocher pour la vente (part au coffre)\nAlt + clic : précieux (doré, jamais vendu)~ // help_pack
@175 = ~Espace : ranger tout le sac à dos.\nLes objets de quête restent dans le sac ; les sacs demandent confirmation.~ // help_storeall
@176 = ~Clic : changer le tri\nClic droit : l'inverser\n*Auto : chaque onglet son ordre (armes par dégâts par round pour le perso affiché, armures par CA, parchemins par classe et niveau...).\n*Aussi : Date, Qualité, Type, Prix, po/lb.~ // help_sort
@177 = ~Rangez un sac (Maj + double-clic ou Tout ranger) : il est vidé dans le coffre et gardé ici.\nLes objets du coffre qu'il peut contenir ne pèsent rien.~ // help_bags
@178 = ~%d objets cochés seront vendus pour %d po.\n%d objets cochés sont ignorés (sans valeur, objet de quête ou non acheté ici).~ // help_sell
@179 = ~Le coffre du groupe : le jeu compte ses objets comme portés (quêtes).~ // stash_slot_tip
@180 = ~%s dégâts/round, TAC0 %d~ // dps_line
@181 = ~Attaques/round : %s~ // st_apr
@182 = ~ (inv.)~ // sort_rev
@183 = ~Un objet précieux ne peut pas être posé au sol~ // msg_valuable_ground
@184 = ~Ouvrez le conteneur qui doit recevoir les objets (Échap annule)~ // dump_armed
@185 = ~Déposer dans ce conteneur : le sac à dos (%d objets) ou cette page du coffre (%d objets) ?~ // dump_confirm
@186 = ~%d objets déposés dans le conteneur~ // dump_done
@187 = ~Rien à déposer~ // dump_none
@188 = ~Dépôt annulé~ // dump_cancel
@189 = ~Sac à dos~ // dump_backpack
@190 = ~Page du coffre~ // dump_stashpage
@191 = ~Déposer le sac à dos ou la dernière page du coffre affichée dans ce conteneur (sauf objets précieux et de quête)~ // container_tip
@195 = ~Aide : ce que Party Stash ajoute à cette page~ // help_btn_tip
@196 = ~Sac du poids~ // bubble_weight_t
@197 = ~Onglets~ // bubble_tabs_t
@198 = ~Filtrer le coffre par catégorie\nMolette ou flèches : voir tous les onglets\n*Sacs : vos sacs collectionnés ; les objets du coffre qu'ils peuvent contenir ne pèsent rien~ // bubble_tabs
@199 = ~Tri~ // bubble_sort_t
@200 = ~Sol~ // bubble_ground_t
@201 = ~Les objets au sol autour du groupe\nGlisser : poser ou ramasser un objet\nLes objets précieux ne peuvent pas être posés ici~ // bubble_ground
@202 = ~Cliquez n'importe où pour fermer~ // bubble_close
