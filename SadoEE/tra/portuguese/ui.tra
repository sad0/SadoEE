@169 = ~Esvaziar o baú? Suas bolsas colecionadas voltam cheias dos itens que comportam; todo o resto cai no chão. Faça isso antes de desinstalar o Party Stash.~ // empty_confirm
@170 = ~Ctrl + clique esquerdo: esvaziar o baú nas suas bolsas e no chão (antes de desinstalar)\nClique direito: guardar a mochila ou esta página do baú (exceto itens valiosos e de missão) no próximo recipiente aberto\n*Painel do contêiner: o botão vermelho no canto inferior direito faz o mesmo~ // bag_tip
@171 = ~Este é o seu baú~ // help_stash_title
@172 = ~Clique: pegar um item (clique duplo: pegar e equipar)\nCtrl + clique: marcar para venda (Vender marcados em um mercador)\nAlt + clique: valioso (dourado, nunca vendido)\nClique direito: descrição. Roda do mouse: rolar\n*Abas: filtrar o baú por categoria (roda ou setas para ver todas)\n*Armas: dano por rodada na dica~ // help_stash
@173 = ~Este é o inventário do seu personagem (as 2 linhas de cima)~ // help_pack_title
@174 = ~Shift + clique duplo, ou arrastar para o baú: guardar um item\nEspaço ou Guardar tudo: guardar a mochila inteira\n*O baú no último espaço: o seu baú; o jogo conta os itens dele como carregados (missões).\nCtrl + clique: marcar para venda (vai para o baú)\nAlt + clique: valioso (dourado, nunca vendido)~ // help_pack
@175 = ~Espaço: guardar a mochila inteira.\nItens de missão ficam na mochila; bolsas pedem confirmação.~ // help_storeall
@176 = ~Clique: mudar a ordenação\nClique direito: invertê-la\n*Auto: cada aba sua ordem (armas por dano por rodada para o personagem mostrado, armaduras por CA, pergaminhos por classe e nível...).\n*Também: Data, Qualidade, Tipo, Preço, po/lb.~ // help_sort
@177 = ~Guarde uma bolsa (Shift + clique duplo ou Guardar tudo): ela é esvaziada no baú e mantida aqui.\nOs itens do baú que ela comporta não pesam nada.~ // help_bags
@178 = ~%d itens marcados serão vendidos por %d po.\n%d itens marcados foram ignorados (sem valor, de missão ou não comprados aqui).~ // help_sell
@179 = ~O baú do grupo: o jogo conta os itens dele como carregados (missões).~ // stash_slot_tip
@180 = ~%s dano/rodada, TAC0 %d~ // dps_line
@181 = ~Ataques/rodada: %s~ // st_apr
@182 = ~ (inv.)~ // sort_rev
@183 = ~Um item valioso não pode ser largado no chão~ // msg_valuable_ground
@184 = ~Abra o recipiente que deve receber os itens (Esc cancela)~ // dump_armed
@185 = ~Guardar neste recipiente: a mochila (%d itens) ou esta página do baú (%d itens)?~ // dump_confirm
@186 = ~%d itens guardados no recipiente~ // dump_done
@187 = ~Nada para guardar~ // dump_none
@188 = ~Guardar cancelado~ // dump_cancel
@189 = ~Mochila~ // dump_backpack
@190 = ~Página do baú~ // dump_stashpage
@191 = ~Colocar a mochila ou a última página do baú mostrada neste contêiner (exceto itens valiosos e de missão)~ // container_tip
@195 = ~Ajuda: o que o Party Stash adiciona a esta página~ // help_btn_tip
@196 = ~Bolsa do peso~ // bubble_weight_t
@197 = ~Abas~ // bubble_tabs_t
@198 = ~Filtrar o baú por categoria\nRoda ou setas: ver todas as abas\n*Bolsas: suas bolsas coletadas; os itens do baú que elas comportam não pesam nada~ // bubble_tabs
@199 = ~Ordenação~ // bubble_sort_t
@200 = ~Chão~ // bubble_ground_t
@201 = ~Itens no chão ao redor do grupo\nArrastar: largar ou pegar itens\nItens valiosos não podem ser largados aqui~ // bubble_ground
@202 = ~Clique em qualquer lugar para fechar~ // bubble_close
