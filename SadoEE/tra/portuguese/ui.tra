@130 = ~Peso do grupo + baú / soma das cargas máximas dos membros. Acima disso, todos ficam lentos. Os itens do baú que cabem em uma bolsa colecionada (aba Bolsas) não pesam nada.~ // weight_tip
@131 = ~Bolsa: Shift + clique duplo ou Guardar tudo~ // msg_bag_hint
@132 = ~Itens de missão e bolsas ficam na mochila~ // msg_quest_bags
@133 = ~Itens de missão ficam na mochila~ // msg_quest
@134 = ~Não foi possível esvaziar a mão~ // msg_hand
@135 = ~As bolsas ficam na coleção~ // msg_bags_kept
@136 = ~Conteúdo da bolsa: ~ // msg_bag_contents
@137 = ~Restaurar o baú: libere um espaço em uma mochila~ // msg_restore
@138 = ~Atenção: suas bolsas serão esvaziadas no baú e os itens correspondentes pesarão 0.~ // bags_warning
