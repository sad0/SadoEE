// ex-SadoQoL strings (GENERATED by build_sadoee.py from SadoQoL/tra; @N there = @1000 + N here)
@1001 = ~Detecção passiva de armadilhas: os ladrões percebem as armadilhas sem o modo Encontrar Armadilhas (requer EEex)~
@1002 = ~Requer EEex.~
@1003 = ~Armadilha encontrada~
@1004 = ~Contêineres valiosos: os contêineres que guardam algo valioso (alto valor/peso, mágico, joia, gema, pergaminho) ganham um contorno dourado permanente (requer EEex)~
@1020 = ~Desarme automático de armadilhas: fora de combate, todo ladrão ocioso com a detecção de armadilhas ativa desarma as armadilhas detectadas que conseguir (requer EEex)~
@1021 = ~Deixa que eu cuido da armadilha~
@1022 = ~I'll pick the lock~
@1023 = ~I'll force it open~
@1024 = ~Nobody here can disarm this trap (click again to open it anyway)~
@1025 = ~Nobody here can open this lock~
@1030 = ~Saque ordenado: no chão, nos contêineres e na barra de saque, os itens de missão, depois os itens sem peso, depois o resto por valor/peso (requer EEex)~
@1040 = ~Metade do espaço pessoal: cada criatura ocupa metade do espaço, o grupo não fica mais preso nos corredores (requer EEex)~
@1042 = ~A metade do espaço pessoal foi removida: ela quebrava o alcance corpo a corpo.~
@1050 = ~Contador de FPS: quadros por segundo e o quadro mais lento no topo da tela de jogo, F12 mostra / oculta (requer EEex)~
@1060 = ~Munição infinita: as flechas, virotes, balas, dardos e armas de arremesso do grupo nunca se esgotam, exceto as mais poderosas (requer EEex)~
@1070 = ~Grupo compacto: o grupo não fica mais preso nos corredores, o alcance corpo a corpo não muda (requer EEex)~
@1071 = ~1 casa por personagem~
@1072 = ~Nenhuma casa: o grupo atravessa todo mundo, e todo mundo o atravessa~
@1090 = ~Modos duradouros: Canção do Bardo, Expulsar Mortos-Vivos, furtividade e dança xamânica continuam ativos enquanto o personagem age; o botão Encontrar Armadilhas liga ou desliga a detecção passiva de armadilhas (requer EEex)~
@1091 = ~Detecção de armadilhas: ligada~
@1092 = ~Detecção de armadilhas: desligada~
@1100 = ~Acampamento de descanso: um pergaminho acima do botão Viajar do mapa-múndi leva a um acampamento tranquilo (0 h na ida e na volta, descanso sem emboscada) (requer EEex)~
@1101 = ~Acampar~
@1102 = ~Voltar~
@1110 = ~Que a luz vele por vosso acampamento, viajantes. Os feridos, os amaldiçoados e os que perderam um companheiro encontram consolo aqui. Em que posso ajudar?~
@1111 = ~Mostre-me o que oferece.~
@1112 = ~Agora não, obrigado.~
@1113 = ~Sacerdote errante~
@1114 = ~Serviços do sacerdote errante~
@1115 = ~Grande mercador~
@1116 = ~Bem-vindos ao acampamento! Tudo o que viram nas lojas da Costa, eu consigo para vocês, pelo melhor preço.~
@1117 = ~Vejamos o que você tem.~
@1118 = ~Agora não.~
@1119 = ~Minhas carroças ainda não chegaram, voltem mais tarde.~
@1120 = ~Atacar e mover: o grupo selecionado anda até o cursor combatendo todo inimigo avistado no caminho, ao estilo RTS; atribuído pelo componente Botões do mouse (botão 4 por padrão) (requer EEex)~
@1130 = ~Botões do mouse: clique do meio, botões 4 a 8 e Shift / Ctrl + roda executam ações do SadoEE, escolhidas no menu Opções do EEex (requer EEex)~
@1131 = ~SadoEE~
@1132 = ~Nada~
@1133 = ~Atacar e mover~
@1134 = ~Aura armadilhas~
@1135 = ~Contador FPS~
@1136 = ~Ação executada por este comando. Nada: o jogo mantém seu comportamento normal.~
@1137 = ~Clique do meio~
@1138 = ~Botão 4~
@1139 = ~Botão 5~
@1140 = ~Botão 6~
@1141 = ~Botão 7~
@1142 = ~Botão 8~
@1143 = ~Shift + roda p/ cima~
@1144 = ~Shift + roda p/ baixo~
@1145 = ~Ctrl + roda p/ cima~
@1146 = ~Ctrl + roda p/ baixo~
@1150 = ~O grupo mantém o equipamento ao morrer~
@1151 = ~Baús na barra de itens do chão~
@1160 = ~O Velho Erudito no acampamento (identifica tudo, 80 po por item)~
@1161 = ~Ah, viajantes! Venham, sentem-se um pouco junto ao fogo e escutem. Estes velhos olhos já leram mais runas do que há estrelas esta noite. Mostrem-me o que carregam, e eu lhes direi o que isso realmente é.~
@1162 = ~Não prefere identificar nossos itens? (<SQCAINC> de ouro)~
@1163 = ~Deixe-me ver... <SQCAINN> de seus pertences guardam segredos. Por <SQCAINC> peças de ouro, nomearei cada um deles.~
@1164 = ~Faça isso.~
@1165 = ~Pronto. Cada um deles me contou sua história, e agora vocês também a conhecem. Usem-nos com sabedoria, meu amigo.~
@1166 = ~Agora não.~
@1167 = ~Tudo o que carregam já lhes é conhecido. Voltem quando a estrada lhes trouxer novos enigmas.~
@1168 = ~Ai de mim, sua bolsa está leve demais: <SQCAINC> peças de ouro, nem uma a menos. Até um velho erudito precisa comer.~
@1169 = ~Muito bem, vejamos seus tesouros.~
@1170 = ~Conte-nos uma história, velho.~
@1171 = ~Há muito tempo, os eruditos da minha ordem aprisionaram coisas terríveis na pedra e enterraram as pedras bem fundo. Nem todas resistiram, receio. Se encontrarem uma gema que sussurra à noite... tragam-na primeiro a mim.~
@1172 = ~Adeus.~
@1173 = ~O Velho Erudito~
@1174 = ~Espera no acampamento: um membro que deixa o grupo pode esperar por você no acampamento de descanso, em volta da fogueira~
@1175 = ~Withers no acampamento: um lich que recria por completo um membro do grupo (raça, classe, kit, atributos...), de graça~
@1176 = ~Withers~
@1177 = ~%s: %s foi para o baú (mochila cheia)~
@1178 = ~Continuar~
@1179 = ~Concluir~
@1180 = ~Quer que eu espere por você no acampamento?~
@1181 = ~Sim, espere por mim no acampamento.~
@1182 = ~Não, fique aqui.~
@1183 = ~Pronto para partir de novo?~
@1184 = ~Junte-se a nós.~
@1185 = ~Ainda não.~
@1186 = ~Confirmar~
@1187 = ~Sem classe dupla~
@1188 = ~%s: %d XP devolvidos após a classe dupla~
@1190 = ~Mortal. Você veste uma forma que o mundo lhe deu. Posso desfazê-la, e você poderá escolher outra... mais uma vez, desde o início.~
@1191 = ~Refaça-me.~
@1192 = ~Hoje não.~
@1193 = ~Saiba disto: uma vez que eu comece, não há volta. Raça, vocação, mente e corpo, tudo escolhido de novo. Suas memórias e seus pertences permanecem. Devo começar?~
@1194 = ~Comece.~
@1195 = ~Vou pensar nisso.~
@1196 = ~Baú do acampamento~
@1197 = ~*A tampa se abre rangendo.*~
@1198 = ~Nível antes da classe dupla~
@1199 = ~Nível %d: %d XP agora, %d XP após a classe dupla~
@1200 = ~%s: %d magias foram para o grimório~
@1201 = ~%s aprende %s~
@1202 = ~%s (nível %d)~
@1203 = ~Grimório - lido por %s~
@1204 = ~Abrir o grimório~
@1205 = ~Aprender~
@1206 = ~Fechar~
@1207 = ~Grimório das magias perdidas~
@1208 = ~As magias que um mago esqueceu quando Withers o refez repousam nestas páginas. Abra-o, e quem puder escrever magias arcanas em seu grimório as aprende de novo (as que puder conjurar).~
@1209 = ~Auto-Roller: an Auto-Roll button in character creation keeps the best of many rolls (18/xx strength weighted)~
@1210 = ~Wouldn't you rather identify our items?~
@1211 = ~I'd like to know more about this world.~
@1212 = ~Ah, let's see what my notes say...~
@1250 = ~Bring me a new companion.~
@1251 = ~One more soul for your band? I can shape one from nothing... or call back one you knew elsewhere. He will walk with you, as seasoned as your leader.~
@1252 = ~Shape him before me.~
@1253 = ~Call back someone I knew (import).~
@1254 = ~Another time.~
@1255 = ~Withers: new companion~
@1256 = ~Continue~
@1257 = ~Abandon~
@1258 = ~Does he keep the items he carried?~
@1259 = ~He keeps them~
@1260 = ~Leave them~
@1261 = ~Does he keep his own experience, or take the party leader's?~
@1262 = ~His own~
@1263 = ~The leader's~
@1264 = ~%s joins the party.~
@1265 = ~The party is full (%d members).~
@1266 = ~Withers recruits: a new companion made in the game's own creation screens or imported, free~
@1267 = ~The new companion's gear~
@1268 = ~Validate~
@1269 = ~Bought from the Grand merchant: %d gp (party gold: %d gp)~
@1270 = ~Stash~
@1271 = ~%d gp~
@1272 = ~free~
