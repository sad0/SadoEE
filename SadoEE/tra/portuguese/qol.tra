// ex-SadoQoL strings (GENERATED by build_sadoee.py from SadoQoL/tra; @N there = @1000 + N here)
@1001 = ~Detecção passiva de armadilhas: os ladrões percebem as armadilhas sem o modo Encontrar Armadilhas (requer EEex)~
@1002 = ~Requer EEex.~
@1003 = ~Armadilha encontrada~
@1004 = ~Contêineres valiosos: os contêineres que guardam algo valioso (alto valor/peso, mágico, joia, gema, pergaminho) ganham um contorno dourado permanente (requer EEex)~
@1020 = ~Desarme automático de armadilhas: fora de combate, todo ladrão ocioso com a detecção de armadilhas ativa desarma as armadilhas detectadas que conseguir (requer EEex)~
@1021 = ~Deixa que eu cuido da armadilha~
@1022 = ~Deixa que eu abro essa fechadura~
@1023 = ~Deixa que eu forço a fechadura~
@1024 = ~Ninguém aqui consegue desarmar esta armadilha (clique de novo para abrir mesmo assim)~
@1025 = ~Ninguém aqui consegue abrir esta fechadura~
@1030 = ~Saque ordenado: no chão, nos contêineres e na barra de saque, os itens de missão, depois os itens sem peso, depois o resto por valor/peso (requer EEex)~
@1040 = ~Metade do espaço pessoal: cada criatura ocupa metade do espaço, o grupo não fica mais preso nos corredores (requer EEex)~
@1042 = ~A metade do espaço pessoal foi removida: ela quebrava o alcance corpo a corpo.~
@1050 = ~Contador de FPS: quadros por segundo e o quadro mais lento no topo da tela de jogo, F12 mostra / oculta (requer EEex)~
@1060 = ~Munição infinita: as flechas, virotes, balas, dardos e armas de arremesso do grupo nunca se esgotam, exceto as mais poderosas (requer EEex)~
@1070 = ~Grupo compacto: o grupo não fica mais preso nos corredores, o alcance corpo a corpo não muda (requer EEex)~
@1071 = ~1 casa por personagem~
@1072 = ~Nenhuma casa: o grupo atravessa todo mundo, e todo mundo o atravessa~
@1090 = ~Modos duradouros: Canção do Bardo, Expulsar Mortos-Vivos, furtividade e dança xamânica continuam ativos enquanto o personagem age; o botão Encontrar Armadilhas liga ou desliga a detecção passiva de armadilhas (requer EEex)~
@1091 = ~Detecção de armadilhas: ligada~
@1092 = ~Detecção de armadilhas: desligada~
@1100 = ~Acampamento de descanso: um pergaminho acima do botão Viajar do mapa-múndi leva a um acampamento tranquilo (0 h na ida e na volta, descanso sem emboscada) (requer EEex)~
@1101 = ~Acampar~
@1102 = ~Voltar~
@1110 = ~Que a luz vele por vosso acampamento, viajantes. Os feridos, os amaldiçoados e os que perderam um companheiro encontram consolo aqui. Em que posso ajudar?~
@1111 = ~Mostre-me o que oferece.~
@1112 = ~Agora não, obrigado.~
@1113 = ~Sacerdote errante~
@1114 = ~Serviços do sacerdote errante~
@1115 = ~Grande mercador~
@1116 = ~Bem-vindos ao acampamento! Tudo o que viram nas lojas da Costa, eu consigo para vocês, pelo melhor preço.~
@1117 = ~Vejamos o que você tem.~
@1118 = ~Agora não.~
@1119 = ~Minhas carroças ainda não chegaram, voltem mais tarde.~
@1120 = ~Atacar e mover: o grupo selecionado anda até o cursor combatendo todo inimigo avistado no caminho, ao estilo RTS; atribuído pelo componente Botões do mouse (botão 4 por padrão) (requer EEex)~
@1130 = ~Botões do mouse: clique do meio, botões 4 a 8 e a roda, sozinhos ou com Shift / Ctrl / Alt, executam qualquer ação dos atalhos de teclado do jogo ou atacar e mover (botão 4 por padrão), definidos na página de opções do SadoEE (requer EEex)~
@1131 = ~SadoEE~
@1132 = ~Nada~
@1133 = ~Atacar e mover~
@1134 = ~Aura armadilhas~
@1135 = ~Contador FPS~
@1136 = ~Ação executada por este comando. Nada: o jogo mantém seu comportamento normal.~
@1137 = ~Clique do meio~
@1138 = ~Botão 4~
@1139 = ~Botão 5~
@1140 = ~Botão 6~
@1141 = ~Botão 7~
@1142 = ~Botão 8~
@1143 = ~Shift + roda p/ cima~
@1144 = ~Shift + roda p/ baixo~
@1145 = ~Ctrl + roda p/ cima~
@1146 = ~Ctrl + roda p/ baixo~
@1150 = ~O grupo mantém o equipamento ao morrer~
@1151 = ~Baús na barra de itens do chão~
@1160 = ~O Velho Erudito no acampamento (identifica tudo, 80 po por item)~
@1161 = ~Ah, viajantes! Venham, sentem-se um pouco junto ao fogo e escutem. Estes velhos olhos já leram mais runas do que há estrelas esta noite. Mostrem-me o que carregam, e eu lhes direi o que isso realmente é.~
@1162 = ~Não prefere identificar nossos itens? (<SQCAINC> de ouro)~
@1163 = ~Deixe-me ver... <SQCAINN> de seus pertences guardam segredos. Por <SQCAINC> peças de ouro, nomearei cada um deles.~
@1164 = ~Faça isso.~
@1165 = ~Pronto. Cada um deles me contou sua história, e agora vocês também a conhecem. Usem-nos com sabedoria, meu amigo.~
@1166 = ~Agora não.~
@1167 = ~Tudo o que carregam já lhes é conhecido. Voltem quando a estrada lhes trouxer novos enigmas.~
@1168 = ~Ai de mim, sua bolsa está leve demais: <SQCAINC> peças de ouro, nem uma a menos. Até um velho erudito precisa comer.~
@1169 = ~Muito bem, vejamos seus tesouros.~
@1170 = ~Conte-nos uma história, velho.~
@1171 = ~Há muito tempo, os eruditos da minha ordem aprisionaram coisas terríveis na pedra e enterraram as pedras bem fundo. Nem todas resistiram, receio. Se encontrarem uma gema que sussurra à noite... tragam-na primeiro a mim.~
@1172 = ~Adeus.~
@1173 = ~O Velho Erudito~
@1174 = ~Espera no acampamento: um membro que deixa o grupo pode esperar por você no acampamento de descanso, em volta da fogueira~
@1175 = ~Withers no acampamento: um lich que recria por completo um membro do grupo (raça, classe, kit, atributos...), de graça~
@1176 = ~Withers~
@1177 = ~%s: %s foi para o baú (mochila cheia)~
@1178 = ~Continuar~
@1179 = ~Concluir~
@1180 = ~Quer que eu espere por você no acampamento?~
@1181 = ~Sim, espere por mim no acampamento.~
@1182 = ~Não, fique aqui.~
@1183 = ~Pronto para partir de novo?~
@1184 = ~Junte-se a nós.~
@1185 = ~Ainda não.~
@1186 = ~Confirmar~
@1187 = ~Sem classe dupla~
@1188 = ~%s: %d XP devolvidos após a classe dupla~
@1190 = ~Mortal. Você veste uma forma que o mundo lhe deu. Posso desfazê-la, e você poderá escolher outra... mais uma vez, desde o início.~
@1191 = ~Refaça-me.~
@1192 = ~Hoje não.~
@1193 = ~Saiba disto: uma vez que eu comece, não há volta. Raça, vocação, mente e corpo, tudo escolhido de novo. Suas memórias e seus pertences permanecem. Devo começar?~
@1194 = ~Comece.~
@1195 = ~Vou pensar nisso.~
@1196 = ~Baú do acampamento~
@1197 = ~*A tampa se abre rangendo.*~
@1198 = ~Nível antes da classe dupla~
@1199 = ~Nível %d: %d XP agora, %d XP após a classe dupla~
@1200 = ~%s: %d magias foram para o grimório~
@1201 = ~%s aprende %s~
@1202 = ~%s (nível %d)~
@1203 = ~Grimório - lido por %s~
@1204 = ~Abrir o grimório~
@1205 = ~Aprender~
@1206 = ~Fechar~
@1207 = ~Grimório das magias perdidas~
@1208 = ~As magias que um mago esqueceu quando Withers o refez repousam nestas páginas. Abra-o, e quem puder escrever magias arcanas em seu grimório as aprende de novo (as que puder conjurar).~
@1209 = ~Auto-Roller: um botão Auto-Roll na criação de personagem guarda a melhor de muitas rolagens (força 18/xx ponderada)~
@1210 = ~Não prefere identificar nossos itens?~
@1211 = ~Gostaria de saber mais sobre este mundo.~
@1212 = ~Ah, vejamos o que dizem minhas anotações...~
@1250 = ~Traga-me um novo companheiro.~
@1251 = ~Mais uma alma para o seu bando? Posso moldar uma do nada... ou chamar de volta alguém que você conheceu em outro lugar. Ela caminhará com vocês, tão experiente quanto o seu líder.~
@1252 = ~Molde-o diante de mim.~
@1253 = ~Chame de volta alguém que conheci (importar).~
@1254 = ~Outra hora.~
@1255 = ~Withers: novo companheiro~
@1256 = ~Continuar~
@1257 = ~Abandonar~
@1258 = ~Ele mantém os itens que carregava?~
@1259 = ~Ele os mantém~
@1260 = ~Deixá-los~
@1261 = ~Ele mantém a própria experiência ou recebe a do líder do grupo?~
@1262 = ~A própria~
@1263 = ~A do líder~
@1264 = ~%s se junta ao grupo.~
@1265 = ~O grupo está completo (%d membros).~
@1266 = ~Withers recruta: um novo companheiro criado nas próprias telas de criação do jogo ou importado, de graça~
@1267 = ~Equipamento do novo companheiro~
@1268 = ~Confirmar~
@1269 = ~Compras com o Grande mercador: %d po (ouro do grupo: %d po)~
@1270 = ~Baú~
@1271 = ~%d gp~
@1272 = ~grátis~
@1273 = ~Arma corpo a corpo~
@1274 = ~Mão secundária~
@1275 = ~Arma à distância~
@1276 = ~Munição~
@1277 = ~Armadura~
@1278 = ~Elmo~
@1279 = ~Amuleto~
@1280 = ~Anéis (dois)~
@1281 = ~Braçadeiras / manoplas~
@1282 = ~Cinto~
@1283 = ~Botas~
@1284 = ~Manto~
@1285 = ~Withers oferece~
@1286 = ~Aceite nossa doação para o seu templo: <SQPRRC> po (reputação <SQPRREP> -> <SQPRNEXT>).~
@1287 = ~Cure todo o grupo: <SQPRHL>. Total: <SQPRHC> po.~
@1288 = ~Sejam abençoados. Os pobres da Costa dirão seus nomes com gratidão.~
@1289 = ~Está feito. Levantem-se, todos vocês, e caminhem na luz.~
@1290 = ~Infelizmente, sua bolsa está leve demais para isso. Voltem quando puderem.~
@1291 = ~ressurreição~
@1292 = ~ferimentos~
@1293 = ~níveis perdidos~
@1294 = ~maldição~
@1295 = ~veneno~
@1296 = ~doença~
@1297 = ~Necromante~
@1298 = ~Os mortos não têm nada melhor a fazer do que ajudar os vivos a treinar. Nomeiem um adversário, e ele se erguerá diante de vocês... inofensivo, a menos que peçam o contrário.~
@1299 = ~Erga uma criatura para nós.~
@1300 = ~Liberte-os: que lutem, e morram.~
@1301 = ~Acalme-os: que voltem a ser marionetes imortais.~
@1302 = ~Faça a limpeza: que todos caiam.~
@1303 = ~Adeus.~
@1304 = ~Quantos <SQNECRN> devem se erguer?~
@1305 = ~Um.~
@1306 = ~Dois.~
@1307 = ~Três.~
@1308 = ~Cinco.~
@1309 = ~Dez.~
@1310 = ~Nenhum, mudei de ideia.~
@1311 = ~Vincule-os a nós: que se juntem ao nosso grupo.~
@1312 = ~Está feito.~
@1313 = ~Bestiário~
@1314 = ~Monstros~
@1315 = ~Humanos~
@1316 = ~Buscar~
@1317 = ~Erguer~
@1318 = ~Fechar~
@1319 = ~Nível~
@1320 = ~HP~
@1321 = ~AC~
@1322 = ~Dano~
@1323 = ~Total~
@1324 = ~Zerar~
@1325 = ~%d criaturas~
@1326 = ~Necromante do acampamento: bonecos de treino de todo o bestiário, medidor de dano (requer o acampamento de descanso)~
@1340 = ~Cuide de nossos ferimentos, por favor.~
@1341 = ~Pronto. Fiquem tranquilos: a luz não pede nada por isto.~
@1342 = ~A sacerdotisa tratou seus ferimentos enquanto vocês dormiam.~
@1343 = ~A sacerdotisa cuida dos ferimentos do grupo.~
@1344 = ~Preços da sacerdotisa do acampamento~
@1345 = ~Preços da sacerdotisa do acampamento: 75 %~
@1346 = ~Preços da sacerdotisa do acampamento: 50 %~
@1347 = ~Preços da sacerdotisa do acampamento: 25 %~
@1348 = ~Preços da sacerdotisa do acampamento: grátis~
@1540 = ~SadoEE~
@1541 = ~Funções do SadoEE ligadas ou desligadas no jogo. Desligar só impede a função de agir: o que ela já fez permanece.~
@1542 = ~Dicas do baú: itens vermelhos / azuis~
@1543 = ~Página do baú do grupo: itens inutilizáveis em vermelho, não identificados em azul.~
@1544 = ~Dicas do baú: marca + de melhoria~
@1545 = ~Página do baú do grupo: um + nos itens que melhoram o personagem mostrado, ou num pergaminho de mago que um membro ainda pode aprender.~
@1546 = ~Linha de DPS nas dicas das armas~
@1547 = ~Dano por rodada e TAC0 das armas equipadas, adicionados às suas dicas.~
@1548 = ~Detecção passiva de armadilhas~
@1549 = ~Os ladrões percebem as armadilhas ao redor sem o modo Encontrar Armadilhas.~
@1550 = ~Desarme automático de armadilhas~
@1551 = ~Fora de combate, os ladrões ociosos desarmam as armadilhas encontradas.~
@1552 = ~Abrir / destrancar / arrombar auto~
@1553 = ~Um clique num contêiner com armadilha ou trancado envia o melhor desarmador, ladrão de fechaduras ou brutamontes.~
@1554 = ~Contorno dourado nos contêineres valiosos~
@1555 = ~Os contêineres que guardam algo valioso ganham um contorno dourado.~
@1556 = ~Munição infinita~
@1557 = ~Flechas, virotes, balas, dardos e armas de arremesso nunca se esgotam, exceto as mais poderosas.~
@1558 = ~Munição básica na aljava~
@1559 = ~Com um arco, besta ou funda equipado, munição básica espera no primeiro espaço vazio da aljava.~
@1560 = ~Atacar e mover~
@1561 = ~A ação atacar e mover (atribuída na aba de botões do mouse do SadoEE).~
@1562 = ~Sem repetição de Canção do Bardo / Expulsar Mortos-Vivos~
@1563 = ~Os scripts de IA do grupo não reiniciam mais um modo já ativo (sem linha repetida).~
@1564 = ~Saque ordenado~
@1565 = ~Os itens no chão, nos contêineres e na barra de saque são ordenados.~
@1566 = ~Baús na barra de itens do chão~
@1567 = ~Contêineres próximos aparecem na barra de itens do chão.~
@1568 = ~Espera no acampamento~
@1569 = ~Um membro que deixa o grupo pode esperar no acampamento de descanso.~
@1570 = ~Contador de FPS~
@1571 = ~Quadros por segundo no topo da tela de jogo (F12 também mostra / oculta).~
@1572 = ~Baú do grupo~
@1573 = ~Armadilhas e contêineres~
@1574 = ~Combate e munição~
@1575 = ~Saque e acampamento~
@1576 = ~Exibição~
@1577 = ~Botões do mouse~
@1578 = ~Fechar~
@1579 = ~Atacar e mover (SadoEE)~
@1580 = ~Nada~
