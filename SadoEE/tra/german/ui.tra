@168 = ~2 Waffen~ // ab_two_weapon
@169 = ~Die Truhe leeren? Eure gesammelten Beutel kommen gefüllt mit den Gegenständen zurück, die sie aufnehmen können; alles andere fällt auf den Boden. Vor der Deinstallation von Party Stash tun.~ // empty_confirm
@170 = ~Strg + Linksklick: Truhe in eure Beutel und auf den Boden leeren (vor der Deinstallation)\nRechtsklick: den Rucksack oder diese Truhenseite (außer wertvollen und Quest-Gegenständen) in den nächsten geöffneten Behälter legen\n*Behälterfenster: die rote Schaltfläche unten rechts tut dasselbe~ // bag_tip
@171 = ~Das ist eure Truhe~ // help_stash_title
@172 = ~Klick: Gegenstand nehmen (Doppelklick: nehmen und ausrüsten)\nStrg + Klick: zum Verkauf markieren (Markierte verk. beim Händler)\nAlt + Klick: wertvoll (golden, nie verkauft)\nRechtsklick: Beschreibung. Mausrad: scrollen\n*Reiter: die Truhe nach Kategorie filtern (Mausrad oder Pfeile für alle)\n*Waffen: Schaden pro Runde im Tooltip~ // help_stash
@173 = ~Das ist das Inventar eures Charakters (die 2 oberen Reihen)~ // help_pack_title
@174 = ~Umschalt + Doppelklick oder auf die Truhe ziehen: Gegenstand einlagern\nLeertaste oder Alles einl.: ganzen Rucksack einlagern\n*Die Truhe im letzten Platz: eure Truhe; das Spiel zählt ihre Gegenstände als getragen (Quests).\nStrg + Klick: zum Verkauf markieren (geht in die Truhe)\nAlt + Klick: wertvoll (golden, nie verkauft)~ // help_pack
@175 = ~Leertaste: ganzen Rucksack einlagern.\nQuestgegenstände bleiben im Rucksack; Beutel fragen nach.~ // help_storeall
@176 = ~Klick: Sortierung ändern\nRechtsklick: umkehren\n*Auto: jeder Reiter seine Ordnung (Waffen nach Schaden pro Runde für die gezeigte Figur, Rüstungen nach RK, Schriftrollen nach Klasse und Stufe...).\n*Außerdem: Datum, Qualität, Typ, Preis, GM/Pfd.~ // help_sort
@177 = ~Beutel einlagern (Umschalt + Doppelklick oder Alles einl.): er wird in die Truhe geleert und hier behalten.\nTruhengegenstände, die er aufnehmen kann, wiegen nichts.~ // help_bags
@178 = ~%d markierte Gegenstände werden für %d GM verkauft.\n%d markierte Gegenstände werden übergangen (wertlos, Questgegenstand oder hier nicht gekauft).~ // help_sell
@179 = ~Die Truhe der Gruppe: Das Spiel zählt ihre Gegenstände als getragen (Quests).~ // stash_slot_tip
@180 = ~%s Schaden/Runde, ETW0 %d~ // dps_line
@181 = ~Angriffe/Runde: %s~ // st_apr
@182 = ~ (umgek.)~ // sort_rev
@183 = ~Ein wertvoller Gegenstand kann nicht auf den Boden gelegt werden~ // msg_valuable_ground
@184 = ~Öffnet den Behälter, der die Gegenstände aufnehmen soll (Esc bricht ab)~ // dump_armed
@185 = ~In diesen Behälter legen: den Rucksack (%d Gegenstände) oder diese Truhenseite (%d Gegenstände)?~ // dump_confirm
@186 = ~%d Gegenstände in den Behälter gelegt~ // dump_done
@187 = ~Nichts abzulegen~ // dump_none
@188 = ~Ablegen abgebrochen~ // dump_cancel
@189 = ~Rucksack~ // dump_backpack
@190 = ~Truhenseite~ // dump_stashpage
@191 = ~Den Rucksack oder die zuletzt gezeigte Truhenseite in diesen Behälter legen (außer wertvollen und Questgegenständen)~ // container_tip
@195 = ~Hilfe: was Party Stash dieser Seite hinzufügt~ // help_btn_tip
@196 = ~Gewichtsbeutel~ // bubble_weight_t
@197 = ~Reiter~ // bubble_tabs_t
@198 = ~Die Truhe nach Kategorie filtern\nMausrad oder Pfeile: alle Reiter sehen\n*Beutel: eure gesammelten Beutel; die Truhengegenstände, die sie aufnehmen können, wiegen nichts~ // bubble_tabs
@199 = ~Sortierung~ // bubble_sort_t
@200 = ~Boden~ // bubble_ground_t
@201 = ~Gegenstände auf dem Boden um die Gruppe\nZiehen: Gegenstände ablegen oder aufheben\nWertvolle Gegenstände können hier nicht abgelegt werden~ // bubble_ground
@202 = ~Irgendwo klicken zum Schließen~ // bubble_close
@203 = ~Notizen~ // tab_notes
