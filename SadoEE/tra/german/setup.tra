@1 = ~Party Stash: eine unendliche Truhe für die ganze Gruppe (benötigt EEex). Vor der Deinstallation: Strg + Linksklick auf den Gewichtsbeutel, um die Truhe zu leeren~
@2 = ~Benötigt EEex.~
@3 = ~Truhe~
@4 = ~Jeder Charakter trägt sie, damit das Spiel ihren Inhalt als getragen zählt (Quests). Die gemeinsame Truhe der ganzen Gruppe, auf der Inventarseite. Klickt auf einen Gegenstand, um ihn zu nehmen; Umschalt + Doppelklick auf einen Rucksackgegenstand oder Leertaste (Alles einl.) zum Einlagern; Strg + Klick markiert einen Gegenstand zum Verkauf über die Händler-Schaltfläche „Markierte verk.“. Ein in die Truhe gelegter Beutel wird in sie geleert und im Reiter Beutel behalten: Truhengegenstände, die er aufnehmen kann, wiegen nichts. Der Rest zählt zur Summe der Traglasten der Mitglieder; darüber werden alle verlangsamt.~
@5 = ~Sortierte Beute: am Boden, in Behältern und in der Beuteleiste~
@6 = ~Aussehen von Baldur's Gate 1 (empfohlen)~
@7 = ~Aussehen von Baldur's Gate II (empfohlen)~
@8 = ~Party Stash: Leert vor der Deinstallation die Truhe im Spiel: Strg + Linksklick auf den großen Beutel neben dem Gewicht auf der Inventarseite. Eure gesammelten Beutel kommen gefüllt mit den Gegenständen zurück, die sie aufnehmen können; alles andere fällt auf den Boden. Sonst bleibt der Truheninhalt in euren Spielständen, ist aber bis zur Neuinstallation des Mods unerreichbar.~
@9 = ~Aussehen von Baldur's Gate 1~
@10 = ~Aussehen von Baldur's Gate II~
@11 = ~Party Stash: eine unendliche Truhe für die ganze Gruppe (benötigt EEex). Vor der Deinstallation: Strg + Linksklick auf den Gewichtsbeutel, um die Truhe zu leeren~
@12 = ~Nur für Baldur's Gate: Enhanced Edition.~
@13 = ~Nur für Baldur's Gate II: Enhanced Edition / EET.~
@14 = ~Option: die Truhe wiegt nichts~
@15 = ~Option: das Gold der Gruppe bei Kampagnenwechseln behalten (BG1 zu SoD, SoD zu BG2 in EET)~
@16 = ~Option (Hardcore): Kampagnenwechsel leeren auch die Truhe, wie alles, was die Gruppe trägt~
@17 = ~Benötigt Party Stash.~
@18 = ~Lagerhändler: verkauft alles, was die bereits besuchten Läden vorrätig haben (für das Lager von SadoQoL)~
@19 = ~Lagerhändler~
@20 = ~Questchronik: Decard öffnet die Liste aller Quests des Spiels (Status, Tagebuch, Hinweise, vollständige Lösung)~
@21 = ~Benötigt Decard, den alten Gelehrten des Lagers (SadoQoL / SadoEE).~
@40 = ~Große Gruppe: 7 bis 32 Mitglieder (eine zusätzliche Porträtleiste, Skripte und Dialoge des Spiels auf Mitglieder ab 7 erweitert)~
@41 = ~Nur für Baldur's Gate: Enhanced Edition, Baldur's Gate II: Enhanced Edition und EET.~
@42 = ~XP der großen Gruppe: die Voreinstellung für jedes Spiel (jedes Spiel kann sie jederzeit auf der SadoEE-Optionsseite, Abschnitt Gruppe, ändern)~
@43 = ~Vanilla: die Verteilung des Spiels~
@44 = ~Gleiche XP pro Mitglied (BG2-Stil): jedes Mitglied erhält die Gesamt-XP einer 6er-Gruppe, geteilt durch 6~
@45 = ~Gleiche Gesamt-XP (BG1-Stil): jedes Mitglied erhält die Gesamt-XP einer 6er-Gruppe, geteilt durch die Zahl der Mitglieder~
@46 = ~Benötigt die große Gruppe (#40).~
