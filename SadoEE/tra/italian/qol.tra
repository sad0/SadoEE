// ex-SadoQoL strings (GENERATED by build_sadoee.py from SadoQoL/tra; @N there = @1000 + N here)
@1001 = ~Rilevamento passivo delle trappole: i ladri individuano le trappole senza la modalità Trova trappole (richiede EEex)~
@1002 = ~Richiede EEex.~
@1003 = ~Trappola individuata~
@1004 = ~Contenitori preziosi: i contenitori con qualcosa di valore (alto valore/peso, magico, gioiello, gemma, pergamena) hanno un contorno dorato permanente (richiede EEex)~
@1020 = ~Disinnesco automatico: fuori dal combattimento, ogni ladro inattivo con il rilevamento delle trappole attivo disinnesca le trappole individuate che è in grado di disinnescare (richiede EEex)~
@1021 = ~Ci penso io alla trappola~
@1022 = ~Scasso io la serratura~
@1023 = ~La forzo io~
@1024 = ~Nessuno qui può disinnescare questa trappola (clicca di nuovo per aprirlo comunque)~
@1025 = ~Nessuno qui può aprire questa serratura~
@1030 = ~Bottino ordinato: a terra, nei contenitori e nella barra del bottino, prima gli oggetti di missione, poi gli oggetti senza peso, poi il resto per valore/peso (richiede EEex)~
@1040 = ~Metà spazio personale: ogni creatura occupa metà dello spazio, il gruppo non si blocca più nei corridoi (richiede EEex)~
@1042 = ~La metà spazio personale è stata rimossa: rovinava la portata in mischia.~
@1050 = ~Contatore FPS: fotogrammi al secondo e il fotogramma più lento in cima alla schermata di gioco, F12 lo mostra / nasconde (richiede EEex)~
@1060 = ~Munizioni infinite: frecce, quadrelli, proiettili, dardi e armi da lancio del gruppo non si esauriscono mai, tranne le più potenti (richiede EEex)~
@1070 = ~Ingombro ridotto del gruppo: il gruppo non si blocca più nei corridoi, la portata in mischia non cambia (richiede EEex)~
@1071 = ~1 casella per personaggio~
@1072 = ~Nessuna casella: il gruppo attraversa tutti, e tutti attraversano il gruppo~
@1090 = ~Modalità persistenti: canzone del bardo, scacciare non morti, furtività e danza dello sciamano restano attive mentre il personaggio agisce; il pulsante Trova trappole attiva o disattiva il rilevamento passivo delle trappole (richiede EEex)~
@1091 = ~Rilevamento trappole: attivo~
@1092 = ~Rilevamento trappole: disattivo~
@1100 = ~Campo di riposo: una pergamena sopra il pulsante Viaggia della mappa del mondo porta a un accampamento tranquillo (0 h andata e ritorno, riposo senza imboscate) (richiede EEex)~
@1101 = ~Campo~
@1102 = ~Indietro~
@1110 = ~Che la luce vegli sul vostro accampamento, viandanti. I feriti, i maledetti e chi ha perso un compagno trovano qui conforto. Come posso aiutarvi?~
@1111 = ~Mostratemi cosa offrite.~
@1112 = ~Non ora, grazie.~
@1113 = ~Sacerdote errante~
@1114 = ~Servizi del sacerdote errante~
@1115 = ~Gran mercante~
@1116 = ~Benvenuti al campo! Tutto ciò che avete visto nelle botteghe della Costa, posso procurarvelo, al miglior prezzo.~
@1117 = ~Vediamo cosa avete.~
@1118 = ~Non ora.~
@1119 = ~I miei carri non sono ancora arrivati, tornate più tardi.~
@1120 = ~Attacco in movimento: il gruppo selezionato cammina verso il cursore combattendo ogni nemico avvistato lungo la strada, come in un RTS; assegnato dal componente Pulsanti del mouse (pulsante 4 di default) (richiede EEex)~
@1130 = ~Pulsanti del mouse: clic centrale, pulsanti da 4 a 8 e rotellina, da soli o con Shift / Ctrl / Alt, eseguono qualsiasi azione di Assegna Tasti del gioco o l'attacco in movimento (pulsante 4 di default), da impostare nella pagina delle opzioni di SadoEE (richiede EEex)~
@1131 = ~SadoEE~
@1132 = ~Niente~
@1133 = ~Attacco mov.~
@1134 = ~Aura trappole~
@1135 = ~Contatore FPS~
@1136 = ~Azione eseguita da questo comando. Niente: il gioco mantiene il suo comportamento normale.~
@1137 = ~Clic centrale~
@1138 = ~Pulsante 4~
@1139 = ~Pulsante 5~
@1140 = ~Pulsante 6~
@1141 = ~Pulsante 7~
@1142 = ~Pulsante 8~
@1143 = ~Shift + rotellina su~
@1144 = ~Shift + rotellina giù~
@1145 = ~Ctrl + rotellina su~
@1146 = ~Ctrl + rotellina giù~
@1150 = ~Il gruppo conserva l'equipaggiamento alla morte~
@1151 = ~Forzieri nella barra degli oggetti a terra~
@1160 = ~Il Vecchio Erudito al campo (identifica tutto, 80 mo per oggetto)~
@1161 = ~Ah, viandanti! Venite, sedete un poco accanto al fuoco e ascoltate. Questi vecchi occhi hanno letto più rune di quante stelle ci siano stanotte. Mostratemi ciò che portate, e vi dirò cosa è davvero.~
@1162 = ~Non preferiresti identificare i nostri oggetti? (<SQCAINC> oro)~
@1163 = ~Vediamo... <SQCAINN> delle vostre cose custodiscono ancora i loro segreti. Per <SQCAINC> monete d'oro, le chiamerò tutte per nome.~
@1164 = ~Fallo.~
@1165 = ~Ecco. Ognuna mi ha narrato la sua storia, e ora la conoscete anche voi. Usatele con saggezza, amico mio.~
@1166 = ~Non ora.~
@1167 = ~Tutto ciò che portate vi è già noto. Tornate quando la strada vi avrà portato nuovi enigmi.~
@1168 = ~Ahimè, la vostra borsa è troppo leggera: <SQCAINC> monete d'oro, non una di meno. Anche un vecchio erudito deve mangiare.~
@1169 = ~Molto bene, guardiamo i vostri tesori.~
@1170 = ~Raccontaci una storia, vecchio.~
@1171 = ~Molto tempo fa, gli eruditi del mio ordine imprigionarono cose terribili nella pietra e seppellirono le pietre in profondità. Non tutte hanno retto, temo. Se trovate una gemma che sussurra di notte... portatela prima a me.~
@1172 = ~Addio.~
@1173 = ~Il Vecchio Erudito~
@1174 = ~Attesa al campo: un membro che lascia il gruppo può aspettarti al campo di riposo, attorno al fuoco~
@1175 = ~Withers al campo: un lich che ricrea completamente un membro del gruppo (razza, classe, kit, caratteristiche...), gratis~
@1176 = ~Withers~
@1177 = ~%s: %s è finito nel baule (zaino pieno)~
@1178 = ~Continua~
@1179 = ~Fine~
@1180 = ~Ti aspetto al campo?~
@1181 = ~Sì, aspettami al campo.~
@1182 = ~No, resta qui.~
@1183 = ~Pronti a ripartire?~
@1184 = ~Unisciti a noi.~
@1185 = ~Non ancora.~
@1186 = ~Conferma~
@1187 = ~Nessuna doppia classe~
@1188 = ~%s: %d PE restituiti dopo la doppia classe~
@1190 = ~Mortale. Porti la forma che il mondo ti ha dato. Posso disfarla, e potrai sceglierne un'altra... ancora una volta, dall'inizio.~
@1191 = ~Rifammi.~
@1192 = ~Non oggi.~
@1193 = ~Sappi questo: una volta cominciato, non si torna indietro. Razza, vocazione, mente e corpo, tutto sarà scelto di nuovo. I tuoi ricordi e i tuoi averi restano. Devo cominciare?~
@1194 = ~Comincia.~
@1195 = ~Ci penserò.~
@1196 = ~Forziere del campo~
@1197 = ~*Il coperchio si apre cigolando.*~
@1198 = ~Livello prima della doppia classe~
@1199 = ~Livello %d: %d PE ora, %d PE con la doppia classe~
@1200 = ~%s: %d incantesimi sono finiti nel grimorio~
@1201 = ~%s impara %s~
@1202 = ~%s (livello %d)~
@1203 = ~Grimorio - letto da %s~
@1204 = ~Apri il grimorio~
@1205 = ~Impara~
@1206 = ~Chiudi~
@1207 = ~Grimorio degli incantesimi perduti~
@1208 = ~Gli incantesimi che un mago ha dimenticato quando Withers lo ha rifatto riposano in queste pagine. Aprilo, e chiunque sappia trascrivere incantesimi da mago nel proprio libro li imparerà di nuovo (quelli che può lanciare).~
@1209 = ~Auto-Roller: un pulsante Auto-Roll nella creazione del personaggio conserva il migliore di molti tiri (forza 18/xx ponderata)~
@1210 = ~Non preferiresti identificare i nostri oggetti?~
@1211 = ~Vorrei saperne di più su questo mondo.~
@1212 = ~Ah, vediamo cosa dicono i miei appunti...~
@1250 = ~Portami un nuovo compagno.~
@1251 = ~Un'anima in più per la tua compagnia? Posso plasmarne una dal nulla... o richiamarne una che hai conosciuto altrove. Camminerà con voi, esperto quanto il tuo capo.~
@1252 = ~Plasmalo davanti a me.~
@1253 = ~Richiama qualcuno che ho conosciuto (importa).~
@1254 = ~Un'altra volta.~
@1255 = ~Withers: nuovo compagno~
@1256 = ~Continua~
@1257 = ~Annulla~
@1258 = ~Tiene gli oggetti che portava?~
@1259 = ~Li tiene~
@1260 = ~Lasciarli~
@1261 = ~Tiene la propria esperienza o prende quella del capo del gruppo?~
@1262 = ~La sua~
@1263 = ~Quella del capo~
@1264 = ~%s si unisce al gruppo.~
@1265 = ~Il gruppo è al completo (%d membri).~
@1266 = ~Withers recluta: un nuovo compagno creato nelle schermate di creazione del gioco o importato, gratis~
@1267 = ~Equipaggiamento del nuovo compagno~
@1268 = ~Conferma~
@1269 = ~Acquisti dal Gran mercante: %d mo (oro del gruppo: %d mo)~
@1270 = ~Baule~
@1271 = ~%d gp~
@1272 = ~gratis~
@1273 = ~Arma da mischia~
@1274 = ~Mano secondaria~
@1275 = ~Arma a distanza~
@1276 = ~Munizioni~
@1277 = ~Armatura~
@1278 = ~Elmo~
@1279 = ~Amuleto~
@1280 = ~Anelli (due)~
@1281 = ~Bracciali / guanti~
@1282 = ~Cintura~
@1283 = ~Stivali~
@1284 = ~Mantello~
@1285 = ~Withers offre~
@1286 = ~Accettate la nostra offerta per il vostro tempio: <SQPRRC> mo (reputazione <SQPRREP> -> <SQPRNEXT>).~
@1287 = ~Curate tutto il gruppo: <SQPRHL>. Totale: <SQPRHC> mo.~
@1288 = ~Siate benedetti. I poveri della Costa pronunceranno i vostri nomi con gratitudine.~
@1289 = ~È fatto. Alzatevi, tutti quanti, e camminate nella luce.~
@1290 = ~Ahimè, la vostra borsa è troppo leggera per questo. Tornate quando potrete.~
@1291 = ~resurrezione~
@1292 = ~ferite~
@1293 = ~livelli persi~
@1294 = ~maledizione~
@1295 = ~veleno~
@1296 = ~malattia~
@1297 = ~Negromante~
@1298 = ~I morti non hanno niente di meglio da fare che aiutare i vivi ad allenarsi. Nominate un avversario e si leverà davanti a voi... innocuo, a meno che non chiediate altrimenti.~
@1299 = ~Risvegliate una creatura per noi.~
@1300 = ~Scatenateli: che combattano, e muoiano.~
@1301 = ~Calmateli: che tornino burattini immortali.~
@1302 = ~Fate pulizia: che cadano tutti.~
@1303 = ~Addio.~
@1304 = ~Quanti <SQNECRN> devono risorgere?~
@1305 = ~Uno solo.~
@1306 = ~Due.~
@1307 = ~Tre.~
@1308 = ~Cinque.~
@1309 = ~Dieci.~
@1310 = ~Nessuno, ho cambiato idea.~
@1311 = ~Legateli a noi: che si uniscano al nostro gruppo.~
@1312 = ~È fatto.~
@1313 = ~Bestiario~
@1314 = ~Mostri~
@1315 = ~Umani~
@1316 = ~Cerca~
@1317 = ~Risveglia~
@1318 = ~Chiudi~
@1319 = ~Livello~
@1320 = ~HP~
@1321 = ~AC~
@1322 = ~Danni~
@1323 = ~Totale~
@1324 = ~Azzera~
@1325 = ~%d creature~
@1326 = ~Negromante del campo: bersagli da allenamento da tutto il bestiario, misuratore di danni (richiede il campo di riposo)~
@1340 = ~Curate le nostre ferite, per favore.~
@1341 = ~Ecco. Riposate tranquilli: la luce non chiede nulla per questo.~
@1342 = ~La sacerdotessa ha medicato le vostre ferite mentre dormivate.~
@1343 = ~La sacerdotessa cura le ferite del gruppo.~
@1344 = ~Tariffe della sacerdotessa del campo~
@1345 = ~Tariffe della sacerdotessa del campo: 75 %~
@1346 = ~Tariffe della sacerdotessa del campo: 50 %~
@1347 = ~Tariffe della sacerdotessa del campo: 25 %~
@1348 = ~Tariffe della sacerdotessa del campo: gratis~
@1540 = ~SadoEE~
@1541 = ~Funzioni di SadoEE attivate o disattivate in gioco. Disattivare una funzione la ferma soltanto: ciò che ha già fatto resta.~
@1542 = ~Indicazioni del baule: oggetti rossi / blu~
@1543 = ~Pagina del baule del gruppo: oggetti inutilizzabili in rosso, non identificati in blu.~
@1544 = ~Indicazioni del baule: segno + di miglioramento~
@1545 = ~Pagina del baule del gruppo: un + sugli oggetti che migliorano il personaggio mostrato, o su una pergamena da mago che un membro può ancora imparare.~
@1546 = ~Riga DPS nei suggerimenti delle armi~
@1547 = ~Danni per round e THAC0 delle armi equipaggiate, aggiunti ai loro suggerimenti.~
@1548 = ~Rilevamento passivo delle trappole~
@1549 = ~I ladri individuano le trappole intorno a loro senza la modalità Trova trappole.~
@1550 = ~Disinnesco automatico~
@1551 = ~Fuori dal combattimento, i ladri inattivi disinnescano le trappole individuate.~
@1552 = ~Apri / scassina / sfonda auto~
@1553 = ~Un clic su un contenitore con trappola o serratura invia il miglior disinnescatore, scassinatore o sfondatore.~
@1554 = ~Contorno dorato sui contenitori preziosi~
@1555 = ~I contenitori che custodiscono qualcosa di valore hanno un contorno dorato.~
@1556 = ~Munizioni infinite~
@1557 = ~Frecce, quadrelli, proiettili, dardi e armi da lancio non si esauriscono mai, tranne i più potenti.~
@1558 = ~Munizioni base nella faretra~
@1559 = ~Con un arco, una balestra o una fionda equipaggiati, munizioni base attendono nel primo slot libero della faretra.~
@1560 = ~Attacco in movimento~
@1561 = ~L'azione attacco in movimento (assegnata nella scheda Pulsanti del mouse di SadoEE).~
@1562 = ~Niente spam di canzone del bardo / scacciare non morti~
@1563 = ~Gli script IA del gruppo non riavviano più una modalità già attiva (nessuna riga ripetuta).~
@1564 = ~Bottino ordinato~
@1565 = ~Gli oggetti a terra, nei contenitori e nella barra del bottino vengono ordinati.~
@1566 = ~Forzieri nella barra degli oggetti a terra~
@1567 = ~I contenitori vicini compaiono nella barra degli oggetti a terra.~
@1568 = ~Attesa al campo~
@1569 = ~Un membro che lascia il gruppo può aspettare al campo di riposo.~
@1570 = ~Contatore FPS~
@1571 = ~Fotogrammi al secondo in cima alla schermata di gioco (anche F12 lo mostra / nasconde).~
@1572 = ~Baule del gruppo~
@1573 = ~Trappole e contenitori~
@1574 = ~Combattimento e munizioni~
@1575 = ~Bottino e campo~
@1576 = ~Visualizzazione~
@1577 = ~Pulsanti del mouse~
@1578 = ~Chiudi~
@1579 = ~Attacco in movimento (SadoEE)~
@1580 = ~Niente~
@1581 = ~Mostra tutte le azioni...~
@1582 = ~Annulla~
@1583 = ~Da solo~
@1584 = ~Shift~
@1585 = ~Ctrl~
@1586 = ~Alt~
@1587 = ~Clic centrale~
@1588 = ~Rotellina su~
@1589 = ~Rotellina giù~
@1590 = ~Rotellina inclinata a sinistra~
@1591 = ~Rotellina inclinata a destra~
@1592 = ~Apri la pagina delle opzioni di SadoEE~
@1593 = ~Le opzioni e i pulsanti del mouse di SadoEE hanno una pagina propria: anche nel menu Opzioni del gioco (Esc) e da Decard al campo.~
@1594 = ~Vorrei cambiare alcune abitudini del gruppo.~
@1595 = ~Certo. Ecco come stanno le cose.~
@1596 = ~Punta una riga per leggerne la descrizione.~
@1597 = ~Clic: scegli l'azione. Clic destro: niente. I pulsanti laterali dei mouse MMO inviano tasti: assegnali in Assegna Tasti del gioco.~
@1600 = ~Le coppie di PNG possono separarsi: congedarne uno non congeda più anche l'altro (Jaheira e Khalid, Minsc e Dynaheir, Xzar e Montaron, Eldoth e Skie)~
@1601 = ~Questo componente è per Baldur's Gate (BGEE) ed EET.~
@1602 = ~Richiede Withers al campo di riposo (il suo componente deve essere installato prima).~
@1603 = ~Auto-tiro~
