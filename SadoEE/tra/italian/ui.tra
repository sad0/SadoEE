@169 = ~Svuotare il baule? Le borse collezionate tornano piene degli oggetti che possono contenere; tutto il resto cade a terra. Da fare prima di disinstallare Party Stash.~ // empty_confirm
@170 = ~Ctrl + clic sinistro: svuota il baule nelle borse e a terra (prima di disinstallare)\nClic destro: riponi lo zaino o questa pagina del baule (tranne oggetti preziosi e di missione) nel prossimo contenitore aperto\n*Pannello del contenitore: il pulsante rosso in basso a destra fa lo stesso~ // bag_tip
@171 = ~Questo è il tuo baule~ // help_stash_title
@172 = ~Clic: prendi un oggetto (doppio clic: prendi ed equipaggia)\nCtrl + clic: segnalo per la vendita (Vendi segnati da un mercante)\nAlt + clic: prezioso (dorato, mai venduto)\nClic destro: descrizione. Rotellina: scorri\n*Schede: filtra il baule per categoria (rotellina o frecce per vederle tutte)\n*Armi: danni per round nel tooltip~ // help_stash
@173 = ~Questo è l'inventario del tuo personaggio (le 2 righe in alto)~ // help_pack_title
@174 = ~Maiusc + doppio clic, o trascina sul baule: riponi un oggetto\nSpazio o Riponi tutto: riponi tutto lo zaino\n*Il baule nell'ultimo slot: il tuo baule; il gioco considera i suoi oggetti come portati (missioni).\nCtrl + clic: segna per la vendita (va nel baule)\nAlt + clic: prezioso (dorato, mai venduto)~ // help_pack
@175 = ~Spazio: riponi tutto lo zaino.\nGli oggetti di missione restano nello zaino; le borse chiedono conferma.~ // help_storeall
@176 = ~Clic: cambia ordinamento\nClic destro: invertilo\n*Auto: ogni scheda il suo ordine (armi per danni per round del personaggio mostrato, armature per CA, pergamene per classe e livello...).\n*Anche: Data, Qualità, Tipo, Prezzo, mo/lb.~ // help_sort
@177 = ~Riponi una borsa (Maiusc + doppio clic o Riponi tutto): viene svuotata nel baule e conservata qui.\nGli oggetti del baule che può contenere non pesano nulla.~ // help_bags
@178 = ~%d oggetti segnati saranno venduti per %d mo.\n%d oggetti segnati sono esclusi (senza valore, di missione o non acquistati qui).~ // help_sell
@179 = ~Il baule del gruppo: il gioco considera i suoi oggetti come portati (missioni).~ // stash_slot_tip
@180 = ~%s danni/round, THAC0 %d~ // dps_line
@181 = ~Attacchi/round: %s~ // st_apr
@182 = ~ (inv.)~ // sort_rev
@183 = ~Un oggetto prezioso non può essere posato a terra~ // msg_valuable_ground
@184 = ~Apri il contenitore che deve ricevere gli oggetti (Esc annulla)~ // dump_armed
@185 = ~Riporre in questo contenitore: lo zaino (%d oggetti) o questa pagina del baule (%d oggetti)?~ // dump_confirm
@186 = ~%d oggetti riposti nel contenitore~ // dump_done
@187 = ~Niente da riporre~ // dump_none
@188 = ~Deposito annullato~ // dump_cancel
@189 = ~Zaino~ // dump_backpack
@190 = ~Pagina del baule~ // dump_stashpage
@191 = ~Metti lo zaino o l'ultima pagina del baule mostrata in questo contenitore (tranne oggetti preziosi e di missione)~ // container_tip
@195 = ~Aiuto: cosa aggiunge Party Stash a questa pagina~ // help_btn_tip
@196 = ~Borsa del peso~ // bubble_weight_t
@197 = ~Schede~ // bubble_tabs_t
@198 = ~Filtra il baule per categoria\nRotellina o frecce: vedi tutte le schede\n*Borse: le borse raccolte; gli oggetti del baule che possono contenere non pesano nulla~ // bubble_tabs
@199 = ~Ordinamento~ // bubble_sort_t
@200 = ~Terreno~ // bubble_ground_t
@201 = ~Oggetti a terra intorno al gruppo\nTrascina: posa o raccogli oggetti\nGli oggetti preziosi non possono essere posati qui~ // bubble_ground
@202 = ~Clicca ovunque per chiudere~ // bubble_close
@203 = ~Note~ // tab_notes
@204 = ~DPS~ // sort_dps
@205 = ~Livello~ // sort_level
