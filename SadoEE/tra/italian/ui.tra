@130 = ~Peso di gruppo + baule / somma dei carichi massimi dei membri. Oltre, tutti vengono rallentati. Gli oggetti del baule che una borsa collezionata può contenere (scheda Borse) non pesano nulla.~ // weight_tip
@131 = ~Borsa: Maiusc + doppio clic o Riponi tutto~ // msg_bag_hint
@132 = ~Oggetti di missione e borse restano nello zaino~ // msg_quest_bags
@133 = ~Gli oggetti di missione restano nello zaino~ // msg_quest
@134 = ~Impossibile svuotare la mano~ // msg_hand
@135 = ~Le borse restano nella collezione~ // msg_bags_kept
@136 = ~Contenuto della borsa: ~ // msg_bag_contents
@137 = ~Ripristino del baule: libera uno spazio in uno zaino~ // msg_restore
@138 = ~Attenzione: le tue borse verranno svuotate nel baule e gli oggetti corrispondenti peseranno 0.~ // bags_warning
