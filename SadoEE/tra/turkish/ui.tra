@169 = ~Sandık boşaltılsın mı? Toplanan çantalarınız alabildikleri eşyalarla dolu olarak geri gelir; geri kalan her şey yere düşer. Bunu Party Stash'i kaldırmadan önce yapın.~ // empty_confirm
@170 = ~Ctrl + sol tık: sandığı çantalarınıza ve yere boşalt (kaldırmadan önce)\nSağ tık: sırt çantasını veya bu sandık sayfasını (değerli ve görev eşyaları hariç) açacağınız sonraki kaba koy\n*Kap paneli: sağ alttaki kırmızı düğme aynısını yapar~ // bag_tip
@171 = ~Bu sizin sandığınız~ // help_stash_title
@172 = ~Tıklama: eşya al (çift tıklama: al ve kuşan)\nCtrl + tıklama: satış için işaretle (tüccarda İşaretlileri sat)\nAlt + tıklama: değerli (altın renkli, asla satılmaz)\nSağ tık: açıklama. Fare tekerleği: kaydır\n*Sekmeler: sandığı kategoriye göre süz (hepsini görmek için tekerlek veya oklar)\n*Silahlar: ipucunda tur başına hasar~ // help_stash
@173 = ~Bu karakterinizin envanteri (üstteki 2 sıra)~ // help_pack_title
@174 = ~Shift + çift tıklama veya sandığa sürükleme: eşyayı sakla\nBoşluk veya Hepsini koy: tüm sırt çantasını sakla\n*Son yuvadaki sandık: sandığınız; oyun içindeki eşyaları taşınıyor sayar (görevler).\nCtrl + tıklama: satış için işaretle (sandığa gider)\nAlt + tıklama: değerli (altın renkli, asla satılmaz)~ // help_pack
@175 = ~Boşluk: tüm sırt çantasını sakla.\nGörev eşyaları sırt çantasında kalır; çantalar onay ister.~ // help_storeall
@176 = ~Tıklama: sıralamayı değiştir\nSağ tık: tersine çevir\n*Oto: her sekmenin kendi düzeni (silahlar gösterilen karakter için tur başına hasara, zırhlar ZS'ye, parşömenler sınıf ve seviyeye göre...).\n*Ayrıca: Tarih, Kalite, Tür, Fiyat, ap/lb.~ // help_sort
@177 = ~Bir çanta saklayın (Shift + çift tıklama veya Hepsini koy): sandığa boşaltılır ve burada tutulur.\nAlabileceği sandık eşyaları hiç ağırlık yapmaz.~ // help_bags
@178 = ~Satılacak işaretli eşya: %d, %d altına.\nAtlanan işaretli eşya: %d (değersiz, görev eşyası veya burada alınmıyor).~ // help_sell
@179 = ~Grubun sandığı: oyun içindeki eşyaları taşınıyor sayar (görevler).~ // stash_slot_tip
@180 = ~%s hasar/tur, THAC0 %d~ // dps_line
@181 = ~Saldırı/tur: %s~ // st_apr
@182 = ~ (ters)~ // sort_rev
@183 = ~Değerli bir eşya yere bırakılamaz~ // msg_valuable_ground
@184 = ~Eşyaları alacak kabı açın (Esc iptal eder)~ // dump_armed
@185 = ~Bu kaba ne konsun: sırt çantası (%d eşya) mı, bu sandık sayfası (%d eşya) mı?~ // dump_confirm
@186 = ~%d eşya kaba kondu~ // dump_done
@187 = ~Kaldırılacak bir şey yok~ // dump_none
@188 = ~Kaldırma iptal edildi~ // dump_cancel
@189 = ~Sırt çantası~ // dump_backpack
@190 = ~Sandık sayfası~ // dump_stashpage
@191 = ~Sırt çantasını veya en son gösterilen sandık sayfasını bu kaba koy (değerli ve görev eşyaları hariç)~ // container_tip
@195 = ~Yardım: Party Stash bu sayfaya ne ekler~ // help_btn_tip
@196 = ~Ağırlık çantası~ // bubble_weight_t
@197 = ~Sekmeler~ // bubble_tabs_t
@198 = ~Sandığı kategoriye göre süz\nTekerlek veya oklar: tüm sekmeler\n*Çantalar: toplanan çantalar; alabildikleri sandık eşyaları hiçbir şey çekmez~ // bubble_tabs
