@130 = ~Grup + sandık ağırlığı / üyelerin taşıma sınırları toplamı. Bunun üzerinde herkes yavaşlar. Toplanmış bir çantanın alabileceği sandık eşyaları (Çantalar sekmesi) hiç ağırlık yapmaz.~ // weight_tip
@131 = ~Çanta: Shift + çift tıklama veya Hepsini koy~ // msg_bag_hint
@132 = ~Görev eşyaları ve çantalar sırt çantasında kalır~ // msg_quest_bags
@133 = ~Görev eşyaları sırt çantasında kalır~ // msg_quest
@134 = ~El boşaltılamadı~ // msg_hand
@135 = ~Çantalar koleksiyonda kalır~ // msg_bags_kept
@136 = ~Çanta içeriği: ~ // msg_bag_contents
@137 = ~Sandığı geri yükleme: bir sırt çantasında yer açın~ // msg_restore
@138 = ~Dikkat: çantalarınız sandığa boşaltılacak ve ilgili eşyaların ağırlığı 0 olacak.~ // bags_warning
