@130 = ~Party + stash weight / sum of the members' weight allowances. Above it, everyone is slowed down. Stash items held by a collected bag (Bags tab) weigh nothing.~ // weight_tip
@131 = ~Bag: Shift + double-click or Store all~ // msg_bag_hint
@132 = ~Quest items and bags stay in the backpack~ // msg_quest_bags
@133 = ~Quest items stay in the backpack~ // msg_quest
@134 = ~Could not empty the hand~ // msg_hand
@135 = ~Bags stay in the collection~ // msg_bags_kept
@136 = ~Bag contents: ~ // msg_bag_contents
@137 = ~Stash restore: make room in a backpack~ // msg_restore
@138 = ~Warning: your bags will be emptied into the stash, and the matching items will weigh 0.~ // bags_warning
