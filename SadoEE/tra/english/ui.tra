@169 = ~Empty the stash? Your collected bags come back filled with the items they can hold; everything else drops on the ground. Do this before uninstalling Party Stash.~ // empty_confirm
@170 = ~Ctrl + left click: empty the stash into your bags and onto the ground (before uninstalling)\nRight click: put the backpack or this stash page (not the valuable or quest items) into the next container you open\n*Container panel: the red button at the bottom right does the same~ // bag_tip
@171 = ~This is your stash~ // help_stash_title
@172 = ~Click: take an item (double-click: take and equip)\nCtrl + click: mark it for sale (Sell Marked at a merchant)\nAlt + click: valuable (golden, never sold)\nRight-click: description. Mouse wheel: scroll\n*Tabs: filter the stash by category (wheel or arrows to see them all)\n*Weapons: damage per round in the tooltip~ // help_stash
@173 = ~This is your character's inventory (the 2 top rows)~ // help_pack_title
@174 = ~Shift + double-click, or drag onto the stash: store an item\nSpace or Store all: store the whole backpack\n*The chest in the last slot: your stash; the game counts its items as carried (quests).\nCtrl + click: mark for sale (it goes to the stash)\nAlt + click: valuable (golden, never sold)~ // help_pack
@175 = ~Space: store the whole backpack.\nQuest items stay in the backpack; bags ask first.~ // help_storeall
@176 = ~Click: change the sort\nRight-click: reverse it\n*Auto: each tab its own order (weapons by damage per round for the shown character, armor by AC, scrolls by class and level...).\n*Also: Date, Quality, Type, Price, Value/weight.~ // help_sort
@177 = ~Store a bag (Shift + double-click or Store all): it is emptied into the stash and kept here.\nStash items it can hold weigh nothing.~ // help_bags
@178 = ~%d marked items will be sold for %d gp.\n%d marked items are skipped (no value, quest item, or not bought here).~ // help_sell
@179 = ~Your party's stash: the game counts its items as carried (quests).~ // stash_slot_tip
@180 = ~%s dmg/round, THAC0 %d~ // dps_line
@181 = ~Attacks/round: %s~ // st_apr
@182 = ~ (rev.)~ // sort_rev
@183 = ~A valuable item cannot be dropped on the ground~ // msg_valuable_ground
@184 = ~Open the container that should receive the items (Esc cancels)~ // dump_armed
@185 = ~Put into this container: the backpack (%d items) or this stash page (%d items)?~ // dump_confirm
@186 = ~%d items put in the container~ // dump_done
@187 = ~Nothing to put away~ // dump_none
@188 = ~Put away cancelled~ // dump_cancel
@189 = ~Backpack~ // dump_backpack
@190 = ~Stash page~ // dump_stashpage
@191 = ~Put the backpack or the last stash page shown into this container (not the valuable or quest items)~ // container_tip
@195 = ~Help: what Party Stash adds to this page~ // help_btn_tip
@196 = ~Weight bag~ // bubble_weight_t
@197 = ~Tabs~ // bubble_tabs_t
@198 = ~Filter the stash by category\nWheel or arrows: see all the tabs\n*Bags: your collected bags; the stash items they can hold weigh nothing~ // bubble_tabs
@199 = ~Sort~ // bubble_sort_t
@200 = ~Ground~ // bubble_ground_t
@201 = ~Items on the ground around the party\nDrag: put items down or pick them up\nValuable items cannot be dropped here~ // bubble_ground
