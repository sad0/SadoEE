// ex-SadoQoL strings (GENERATED by build_sadoee.py from SadoQoL/tra; @N there = @1000 + N here)
@1001 = ~Passive trap detection: thieves spot traps without the Find Traps mode (requires EEex)~
@1002 = ~Requires EEex.~
@1003 = ~Trap found~
@1004 = ~Valuable containers: containers holding something valuable (high value/weight, magical, jewelry, gem, scroll) get a permanent gold outline (requires EEex)~
@1020 = ~Automatic trap disarming: out of combat, every idle thief with trap detection on disarms the detected traps she can; a click on a trapped or locked container sends the best disarmer, lockpicker or basher (requires EEex)~
@1021 = ~I'll take care of the trap~
@1022 = ~I'll pick the lock~
@1023 = ~I'll force it open~
@1024 = ~Nobody here can disarm this trap (click again to open it anyway)~
@1025 = ~Nobody here can open this lock~
@1030 = ~Sorted loot: on the ground, in containers and in the quick loot bar, quest items, then weightless items, then the rest by value/weight (requires EEex)~
@1040 = ~Half personal space: every creature takes half as much room, the party no longer jams in corridors (requires EEex)~
@1042 = ~Half personal space was removed: it broke melee reach.~
@1050 = ~FPS counter: frames per second and the slowest frame at the top of the game screen, F12 shows / hides it (requires EEex)~
@1060 = ~Endless ammo: the party's arrows, bolts, bullets, darts and throwing weapons are never used up, except the most powerful ones; with a bow, crossbow or sling equipped, basic ammo always waits in the first empty quiver slot (requires EEex)~
@1070 = ~Small party footprint: the party no longer jams in corridors, melee reach is unchanged (requires EEex)~
@1071 = ~1 square per character~
@1072 = ~No square: the party walks through everyone, and everyone walks through it~
@1090 = ~Lasting modes: bard song, turn undead, stealth and shaman dance stay on while the character acts; the Find Traps button turns passive trap detection on or off (requires EEex)~
@1091 = ~Trap detection: on~
@1092 = ~Trap detection: off~
@1100 = ~Rest camp: a parchment over the world map's Travel button leads to a quiet camp (0 h there and back, rest without ambush) (requires EEex)~
@1101 = ~Camp~
@1102 = ~Back~
@1110 = ~May the light watch over your camp, travellers. The wounded, the cursed and those who lost a companion find comfort here. How may I help you?~
@1111 = ~Show me what you offer.~
@1112 = ~Not now, thank you.~
@1113 = ~Wandering priest~
@1114 = ~Wandering priest's services~
@1115 = ~Grand Merchant~
@1116 = ~Welcome to the camp! Anything you have seen in the shops of the Coast, I can get for you, at the best price.~
@1117 = ~Let's see what you have.~
@1118 = ~Not now.~
@1119 = ~My wagons have not arrived yet, come back later.~
@1120 = ~Attack-move: the selected party walks to the cursor fighting every enemy seen on the way, RTS style; bound by the Mouse buttons component (button 4 by default) (requires EEex)~
@1130 = ~Mouse buttons: middle click, buttons 4 to 8 and the wheel, alone or with Shift / Ctrl / Alt, run any action of the game's keybindings or attack-move (button 4 by default), set in the SadoEE options page (requires EEex)~
@1131 = ~SadoEE~
@1132 = ~Nothing~
@1133 = ~Attack-move~
@1134 = ~Trap aura~
@1135 = ~FPS counter~
@1136 = ~Action run by this input. Nothing: the game keeps its normal behaviour.~
@1137 = ~Middle click~
@1138 = ~Button 4~
@1139 = ~Button 5~
@1140 = ~Button 6~
@1141 = ~Button 7~
@1142 = ~Button 8~
@1143 = ~Shift + wheel up~
@1144 = ~Shift + wheel down~
@1145 = ~Ctrl + wheel up~
@1146 = ~Ctrl + wheel down~
@1150 = ~Party keeps its gear on death~
@1151 = ~Chests in the ground items bar~
@1160 = ~The Old Scholar at the camp (identifies everything, 80 gp per item)~
@1161 = ~Ah, travellers! Come, sit awhile by the fire and listen. These old eyes have read more runes than there are stars tonight. Show me what you carry, and I shall tell you what it truly is.~
@1162 = ~Wouldn't you rather identify our items? (<SQCAINN> items x <SQCAINP> gold = <SQCAINC> gold)~
@1163 = ~Let me see... <SQCAINN> of your things keep their secrets. For <SQCAINC> gold, I will name every one of them.~
@1164 = ~Do it.~
@1165 = ~There. Each of them has told me its tale, and now you know it too. Use them wisely, my friend.~
@1166 = ~Not now.~
@1167 = ~Everything you carry is already known to you. Come back when the road gives you new riddles.~
@1168 = ~Alas, your purse is too light: <SQCAINC> gold, no less. Even an old scholar must eat.~
@1169 = ~Very well, let us look at your treasures.~
@1170 = ~Tell us a story, old man.~
@1171 = ~Long ago, the scholars of my order bound terrible things in stone and buried the stones deep. Not every stone held, I fear. When you find a gem that whispers at night... bring it to me first.~
@1172 = ~Farewell.~
@1173 = ~The Old Scholar~
@1174 = ~Waiting at the camp: a member who leaves the party can wait for you at the rest camp, around the fire~
@1175 = ~Withers at the camp: a lich who fully recreates a party member (race, class, kit, abilities...), free~
@1176 = ~Withers~
@1177 = ~%s: %s went to the stash (backpack full)~
@1178 = ~Continue~
@1179 = ~Finish~
@1180 = ~Shall I wait for you at the camp?~
@1181 = ~Yes, wait for me at the camp.~
@1182 = ~No, stay here.~
@1183 = ~Ready to set off again?~
@1184 = ~Join us.~
@1185 = ~Not yet.~
@1186 = ~Confirm~
@1187 = ~No dual-class~
@1188 = ~%s: %d XP given back after dual-classing~
@1190 = ~Mortal. You wear a shape the world gave you. I can unmake it, and you may choose another... once more, from the beginning.~
@1191 = ~Remake me.~
@1192 = ~Not today.~
@1193 = ~Know this: once I begin, there is no going back. Race, calling, mind and body, all of it chosen anew. Your memories and your belongings remain. Shall I begin?~
@1194 = ~Begin.~
@1195 = ~I will think on it.~
@1196 = ~Camp chest~
@1197 = ~*The lid creaks open.*~
@1198 = ~Level before dual-classing~
@1199 = ~Level %d: %d XP now, %d XP once dual-classed~
@1200 = ~%s: %d spells went into the grimoire~
@1201 = ~%s learns %s~
@1202 = ~%s (level %d)~
@1203 = ~Grimoire - read by %s~
@1204 = ~Open the grimoire~
@1205 = ~Learn~
@1206 = ~Close~
@1207 = ~Grimoire of lost spells~
@1208 = ~The spells a mage forgot when Withers remade him rest in these pages. Open it, and anyone who can write mage spells in his book learns them again (those he can cast).~
@1209 = ~Auto-Roller: an Auto-Roll button in character creation keeps the best of many rolls (18/xx strength weighted)~
@1210 = ~Wouldn't you rather identify our items?~
@1211 = ~I'd like to know more about this world.~
@1212 = ~Ah, let's see what my notes say...~
@1250 = ~Bring me a new companion.~
@1251 = ~One more soul for your band? I can shape one from nothing... or call back one you knew elsewhere. He will walk with you, as seasoned as your leader.~
@1252 = ~Shape him before me.~
@1253 = ~Call back someone I knew (import).~
@1254 = ~Another time.~
@1255 = ~Withers: new companion~
@1256 = ~Continue~
@1257 = ~Abandon~
@1258 = ~Does he keep the items he carried?~
@1259 = ~He keeps them~
@1260 = ~Leave them~
@1261 = ~Does he keep his own experience, or take the party leader's?~
@1262 = ~His own~
@1263 = ~The leader's~
