@127 = ~명중 ~ // cmp_hit
@128 = ~피해 ~ // cmp_damage
@129 = ~숙련: %d~ // cmp_skill
@130 = ~파티 + 보관함 무게 / 구성원 최대 적재량의 합. 이를 넘으면 모두 느려집니다. 모은 가방에 들어가는 보관함 아이템(가방 탭)은 무게가 없습니다.~ // weight_tip
@131 = ~가방: Shift + 더블클릭 또는 "모두 보관"~ // msg_bag_hint
@132 = ~퀘스트 아이템과 가방은 배낭에 남습니다~ // msg_quest_bags
@133 = ~퀘스트 아이템은 배낭에 남습니다~ // msg_quest
@134 = ~손을 비울 수 없습니다~ // msg_hand
@135 = ~가방은 수집품에 남습니다~ // msg_bags_kept
@136 = ~가방 내용물: ~ // msg_bag_contents
@137 = ~보관함 복원: 배낭에 빈칸을 만드세요~ // msg_restore
@138 = ~주의: 가방이 보관함에 비워지고 해당 아이템의 무게가 0이 됩니다.~ // bags_warning
@139 = ~확인~ // bags_ok
