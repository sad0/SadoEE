@161 = ~AC~ // ab_ac
@162 = ~AC 보정~ // ab_ac_mods
@163 = ~투사체~ // ab_missile
@164 = ~숙련~ // ab_prof
@165 = ~기본 THAC0~ // ab_base_thac0
@166 = ~주손~ // ab_main_hand
@167 = ~보조손~ // ab_off_hand
@168 = ~쌍수~ // ab_two_weapon
@169 = ~보관함을 비울까요? 모은 가방은 담을 수 있는 아이템으로 채워져 돌아오고, 나머지는 모두 바닥에 떨어집니다. Party Stash를 제거하기 전에 하세요.~ // empty_confirm
@170 = ~Ctrl + 왼쪽 클릭: 보관함을 가방과 바닥에 비우기 (제거 전)\n오른쪽 클릭: 배낭 또는 보관함의 이 페이지(귀중품과 퀘스트 아이템 제외)를 다음에 여는 용기에 넣기\n*용기 패널: 오른쪽 아래의 빨간 버튼도 같은 일을 합니다~ // bag_tip
@171 = ~여기는 보관함입니다~ // help_stash_title
@172 = ~클릭: 아이템 꺼내기 (더블클릭: 꺼내서 장착)\nCtrl + 클릭: 판매 표시 (상인에게서 "표시 판매")\nAlt + 클릭: 귀중품 (금색, 절대 판매 안 함)\n오른쪽 클릭: 설명. 마우스 휠: 스크롤\n*탭: 보관함을 종류별로 거르기 (휠이나 화살표로 전부 보기)\n*무기: 툴팁에 라운드당 피해~ // help_stash
@173 = ~여기는 캐릭터의 인벤토리입니다 (위쪽 2줄)~ // help_pack_title
@174 = ~Shift + 더블클릭 또는 보관함으로 끌기: 아이템 보관\n스페이스 또는 "모두 보관": 배낭 전체 보관\n*마지막 칸의 상자: 당신의 보관함; 게임은 안의 아이템을 소지한 것으로 칩니다 (퀘스트).\nCtrl + 클릭: 판매 표시(보관함으로 이동)\nAlt + 클릭: 귀중품 (금색, 절대 판매 안 함)~ // help_pack
@175 = ~스페이스: 배낭 전체 보관.\n퀘스트 아이템은 배낭에 남고, 가방은 확인을 묻습니다.~ // help_storeall
@176 = ~클릭: 정렬 변경\n오른쪽 클릭: 역순\n*자동: 탭마다 고유 순서 (무기는 표시된 캐릭터의 라운드당 피해순, 방어구는 AC순, 두루마리는 직업과 레벨순...).\n*그 외: 날짜, 품질, 종류, 가격, 골드/lb.~ // help_sort
@177 = ~가방 보관 (Shift + 더블클릭 또는 "모두 보관"): 내용물이 보관함으로 옮겨지고 여기에 남습니다.\n그 가방이 담을 수 있는 보관함 아이템은 무게가 없습니다.~ // help_bags
@178 = ~표시한 아이템 %d개를 %d 골드에 판매합니다.\n표시한 아이템 %d개는 제외됩니다 (가치 없음, 퀘스트 아이템, 또는 여기서 사지 않음).~ // help_sell
@179 = ~파티 보관함: 게임은 안의 아이템을 소지한 것으로 칩니다 (퀘스트).~ // stash_slot_tip
@180 = ~라운드당 피해 %s, THAC0 %d~ // dps_line
@181 = ~라운드당 공격: %s~ // st_apr
@182 = ~ (역순)~ // sort_rev
@183 = ~귀중품은 바닥에 내려놓을 수 없습니다~ // msg_valuable_ground
@184 = ~아이템을 받을 용기를 여세요 (Esc 취소)~ // dump_armed
@185 = ~이 용기에 넣을 것: 배낭(%d개) 아니면 보관함 이 페이지(%d개)?~ // dump_confirm
@186 = ~용기에 아이템 %d개를 넣었습니다~ // dump_done
@187 = ~넣을 것이 없습니다~ // dump_none
@188 = ~넣기 취소됨~ // dump_cancel
@189 = ~배낭~ // dump_backpack
@190 = ~보관함 페이지~ // dump_stashpage
@191 = ~배낭이나 마지막으로 표시된 보관함 페이지를 이 용기에 넣기 (귀중품과 퀘스트 아이템 제외)~ // container_tip
@195 = ~도움말: Party Stash가 이 페이지에 더하는 것~ // help_btn_tip
@196 = ~무게 가방~ // bubble_weight_t
@197 = ~탭~ // bubble_tabs_t
@198 = ~보관함을 종류별로 거르기\n휠이나 화살표: 모든 탭 보기\n*가방: 모은 가방; 가방이 담을 수 있는 보관함 아이템은 무게가 없음~ // bubble_tabs
@199 = ~정렬~ // bubble_sort_t
@200 = ~땅~ // bubble_ground_t
@201 = ~파티 주변 땅의 아이템\n끌기: 아이템 내려놓기 또는 줍기\n귀중품은 여기에 내려놓을 수 없음~ // bubble_ground
@202 = ~아무 곳이나 클릭하면 닫힘~ // bubble_close
@203 = ~메모~ // tab_notes
@204 = ~DPS~ // sort_dps
@205 = ~레벨~ // sort_level
@206 = ~이 아이템은 거기에 둘 수 없습니다~ // msg_cannot_equip
@207 = ~동료의 배낭이 가득 찼습니다~ // msg_comp_full
@208 = ~레벨 %d~ // ab_level
@209 = ~투구 숨기기~ // helm_hide
