@165 = ~Базовий THAC0~ // ab_base_thac0
@166 = ~Осн.~ // ab_main_hand
@167 = ~Друга~ // ab_off_hand
@168 = ~2 зброї~ // ab_two_weapon
@169 = ~Спорожнити скриню? Зібрані торби повернуться заповненими предметами, які вони вміщають; усе інше впаде на землю. Зробіть це перед видаленням Party Stash.~ // empty_confirm
@170 = ~Ctrl + лівий клік: розкласти скриню по торбах і на землю (перед видаленням)\nПравий клік: покласти наплічник або цю сторінку скрині (крім цінних і квестових предметів) до наступного відкритого контейнера\n*Панель контейнера: червона кнопка праворуч унизу робить те саме~ // bag_tip
@171 = ~Це ваша скриня~ // help_stash_title
@172 = ~Клік: узяти предмет (подвійний: узяти й одягнути)\nCtrl + клік: позначити для продажу («Продати позн.» у торговця)\nAlt + клік: цінний (золотий, не продається)\nПравий клік: опис. Коліщатко миші: прокрутка\n*Вкладки: фільтр скрині за категоріями (коліщатко або стрілки, щоб побачити всі)\n*Зброя: шкода за раунд у підказці~ // help_stash
@173 = ~Це спорядження вашого персонажа (2 верхні ряди)~ // help_pack_title
@174 = ~Shift + подвійний клік або перетягування на скриню: прибрати предмет\nПробіл або «Прибрати все»: прибрати весь наплічник\n*Скриня в останній комірці: ваша скриня; гра вважає її предмети носимими (квести).\nCtrl + клік: позначити для продажу (йде до скрині)\nAlt + клік: цінний (золотий, не продається)~ // help_pack
@175 = ~Пробіл: прибрати весь наплічник.\nКвестові предмети лишаються в наплічнику; торби просять підтвердження.~ // help_storeall
@176 = ~Клацання: змінити сортування\nПравий клік: обернути його\n*Авто: кожна вкладка свій порядок (зброя за шкодою за раунд для показаного персонажа, обладунки за КБ, сувої за класом і рівнем...).\n*Також: Дата, Якість, Тип, Ціна, зм/фнт.~ // help_sort
@177 = ~Приберіть торбу (Shift + подвійний клік або «Прибрати все»): її буде висипано у скриню й залишено тут.\nПредмети скрині, які вона вміщає, нічого не важать.~ // help_bags
@178 = ~Буде продано позначених предметів: %d, за %d зм.\nПропущено позначених: %d (без ціни, квестові або тут не купують).~ // help_sell
@179 = ~Скриня загону: гра вважає її предмети носимими (квести).~ // stash_slot_tip
@180 = ~%s шкоди/раунд, THAC0 %d~ // dps_line
@181 = ~Атак за раунд: %s~ // st_apr
@182 = ~ (обер.)~ // sort_rev
@183 = ~Цінний предмет не можна покласти на землю~ // msg_valuable_ground
@184 = ~Відкрийте контейнер, що прийме предмети (Esc — скасувати)~ // dump_armed
@185 = ~Покласти до цього контейнера: наплічник (%d предметів) чи цю сторінку скрині (%d предметів)?~ // dump_confirm
@186 = ~%d предметів покладено до контейнера~ // dump_done
@187 = ~Нічого прибрати~ // dump_none
@188 = ~Прибирання скасовано~ // dump_cancel
@189 = ~Наплічник~ // dump_backpack
@190 = ~Сторінка скрині~ // dump_stashpage
@191 = ~Покласти наплічник або останню показану сторінку скрині в цей контейнер (крім цінних і квестових предметів)~ // container_tip
@195 = ~Довідка: що Party Stash додає на цю сторінку~ // help_btn_tip
@196 = ~Торба ваги~ // bubble_weight_t
@197 = ~Вкладки~ // bubble_tabs_t
@198 = ~Фільтр скрині за категоріями\nКоліщатко або стрілки: усі вкладки\n*Торби: зібрані торби; предмети скрині, які вони вміщують, нічого не важать~ // bubble_tabs
@199 = ~Сортування~ // bubble_sort_t
@200 = ~Земля~ // bubble_ground_t
@201 = ~Предмети на землі навколо загону\nПеретягування: покласти або підняти предмет\nЦінні предмети сюди покласти не можна~ // bubble_ground
@202 = ~Клацніть будь-де, щоб закрити~ // bubble_close
@203 = ~Нотатки~ // tab_notes
@204 = ~Шкода~ // sort_dps
@205 = ~Рівень~ // sort_level
@206 = ~Цей предмет не можна туди покласти~ // msg_cannot_equip
@207 = ~Наплічник супутника повний~ // msg_comp_full
@208 = ~Рівень %d~ // ab_level
