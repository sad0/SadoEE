// Turkish translation of SadoEE (from English)
@1001 = ~Pasif tuzak tespiti: hırsızlar Tuzak Bul modu olmadan da tuzakları fark eder (EEex gerekir)~
@1002 = ~EEex gerekir.~
@1003 = ~Tuzak bulundu~
@1004 = ~Değerli kaplar: değerli bir şey içeren kaplar (yüksek değer/ağırlık, büyülü, mücevher, değerli taş, parşömen) kalıcı altın renkli bir dış hat kazanır (EEex gerekir)~
@1020 = ~Otomatik tuzak etkisizleştirme: savaş dışında, tuzak tespiti açık olan her boştaki hırsız, tespit edilen tuzaklardan gücünün yettiklerini etkisiz hâle getirir (EEex gerekir)~
@1021 = ~Tuzağı ben hallederim~
@1030 = ~Sıralı ganimet: yerde, kaplarda ve ganimet çubuğunda önce görev eşyaları, sonra ağırlıksız eşyalar, sonra geri kalanı değer/ağırlığa göre (EEex gerekir)~
@1040 = ~Yarı kişisel alan: her yaratık yarısı kadar yer kaplar, grup artık koridorlarda sıkışmaz (EEex gerekir)~
@1042 = ~Yarı kişisel alan kaldırıldı: yakın dövüş menzilini bozuyordu.~
@1050 = ~FPS sayacı: saniyedeki kare sayısı ve en yavaş kare oyun ekranının üstünde, F12 gösterir / gizler (EEex gerekir)~
@1060 = ~Sonsuz mühimmat: grubun okları, arbalet okları, sapan mermileri, dartları ve fırlatma silahları hiç tükenmez, en güçlüleri hariç (EEex gerekir)~
@1070 = ~Küçük grup ayak izi: grup artık koridorlarda sıkışmaz, yakın dövüş menzili değişmez (EEex gerekir)~
@1071 = ~Karakter başına 1 kare~
@1072 = ~Kare yok: grup herkesin içinden geçer, herkes de grubun içinden geçer~
@1090 = ~Kalıcı modlar: Ozan Şarkısı, Ölümsüzleri Kov, gizlilik ve şaman dansı karakter hareket ederken açık kalır; Tuzak Bul düğmesi pasif tuzak tespitini açar veya kapatır (EEex gerekir)~
@1091 = ~Tuzak tespiti: açık~
@1092 = ~Tuzak tespiti: kapalı~
@1100 = ~Dinlenme kampı: dünya haritasındaki Seyahat düğmesinin üstündeki bir parşömen sakin bir kampa götürür (gidiş-dönüş 0 saat, pusuya düşmeden dinlenme) (EEex gerekir)~
@1101 = ~Kamp~
@1102 = ~Geri~
@1110 = ~Işık kampınızı gözetsin, yolcular. Yaralılar, lanetliler ve bir yoldaşını yitirenler burada teselli bulur. Size nasıl yardım edebilirim?~
@1111 = ~Neler sunduğunu göster.~
@1112 = ~Şimdi değil, teşekkürler.~
@1113 = ~Gezgin rahip~
@1114 = ~Gezgin rahibin hizmetleri~
@1115 = ~Büyük tüccar~
@1116 = ~Kampa hoş geldiniz! Sahil'in dükkânlarında ne gördüyseniz size bulabilirim, en iyi fiyata.~
@1117 = ~Bakalım neyin var.~
@1118 = ~Şimdi değil.~
@1119 = ~Arabalarım henüz gelmedi, sonra tekrar gelin.~
@1120 = ~Saldırarak ilerle: seçili grup imlece yürür ve yolda gördüğü her düşmanla savaşır, RTS tarzı; Fare düğmeleri bileşeniyle atanır (varsayılan 4. düğme) (EEex gerekir)~
@1130 = ~Fare düğmeleri: orta tık, 4 ile 8 arası düğmeler ve tekerlek, tek başına veya Shift / Ctrl / Alt ile, oyunun tuş atamalarındaki herhangi bir eylemi veya saldırarak ilerlemeyi çalıştırır (varsayılan 4. düğme), SadoEE seçenekler sayfasından ayarlanır (EEex gerekir)~
@1131 = ~SadoEE~
@1132 = ~Hiçbiri~
@1133 = ~Saldırarak ilerle~
@1134 = ~Tuzak aurası~
@1135 = ~FPS sayacı~
@1136 = ~Bu girdinin çalıştırdığı eylem. Hiçbiri: oyun normal davranışını korur.~
@1137 = ~Orta tık~
@1138 = ~4. düğme~
@1139 = ~5. düğme~
@1140 = ~6. düğme~
@1141 = ~7. düğme~
@1142 = ~8. düğme~
@1143 = ~Shift + tekerlek yukarı~
@1144 = ~Shift + tekerlek aşağı~
@1145 = ~Ctrl + tekerlek yukarı~
@1146 = ~Ctrl + tekerlek aşağı~
@1150 = ~Grup ölünce teçhizatını korur~
@1151 = ~Yerdeki eşyalar çubuğunda sandıklar~
@1160 = ~Kamptaki Yaşlı Âlim (her şeyi tanımlar, eşya başına 80 ap)~
@1161 = ~Ah, yolcular! Gelin, ateşin başına biraz oturun ve dinleyin. Bu yaşlı gözler bu gece gökteki yıldızlardan daha fazla rün okudu. Taşıdıklarınızı gösterin, ben de size onların gerçekte ne olduğunu söyleyeyim.~
@1162 = ~Eşyalarımızı tanımlasan daha iyi olmaz mı? (<SQCAINC> altın)~
@1163 = ~Bakalım... eşyalarınızdan <SQCAINN> tanesi hâlâ sırrını saklıyor. <SQCAINC> altına hepsinin adını söylerim.~
@1164 = ~Yap.~
@1165 = ~İşte. Her biri bana hikâyesini anlattı, artık siz de biliyorsunuz. Onları akıllıca kullanın, dostum.~
@1166 = ~Şimdi değil.~
@1167 = ~Taşıdığınız her şeyi zaten biliyorsunuz. Yol size yeni bilmeceler getirdiğinde yine gelin.~
@1168 = ~Ne yazık, keseniz çok hafif: <SQCAINC> altın, bir eksik olmaz. Yaşlı bir âlimin de karnını doyurması gerek.~
@1169 = ~Pekâlâ, hazinelerinize bir bakalım.~
@1170 = ~Bize bir hikâye anlat, ihtiyar.~
@1171 = ~Çok uzun zaman önce, tarikatımın âlimleri korkunç şeyleri taşa hapsedip o taşları derinlere gömdüler. Korkarım her taş dayanmadı. Gece fısıldayan bir değerli taş bulursanız... önce onu bana getirin.~
@1172 = ~Elveda.~
@1173 = ~Yaşlı Âlim~
@1174 = ~Kampta bekleme: gruptan ayrılan bir üye sizi dinlenme kampında, ateşin başında bekleyebilir~
@1175 = ~Kampta Withers: bir grup üyesini baştan yaratan bir lich (ırk, sınıf, kit, yetenekler...), ücretsiz~
@1176 = ~Withers~
@1177 = ~%s: %s sandığa gitti (sırt çantası dolu)~
@1178 = ~Devam~
@1179 = ~Bitir~
@1180 = ~Seni kampta bekleyeyim mi?~
@1181 = ~Evet, beni kampta bekle.~
@1182 = ~Hayır, burada kal.~
@1183 = ~Yeniden yola çıkmaya hazır mısın?~
@1184 = ~Bize katıl.~
@1185 = ~Henüz değil.~
@1186 = ~Onayla~
@1187 = ~Çift sınıf yok~
@1188 = ~%s: çift sınıftan sonra %d TP geri verildi~
@1190 = ~Ölümlü. Dünyanın sana verdiği bir biçimi taşıyorsun. Onu bozabilirim, sen de bir başkasını seçersin... bir kez daha, en baştan.~
@1191 = ~Beni yeniden yarat.~
@1192 = ~Bugün değil.~
@1193 = ~Şunu bil: bir kez başladım mı, geri dönüş yok. Irk, meslek, zihin ve beden, hepsi yeniden seçilecek. Anıların ve eşyaların kalır. Başlayayım mı?~
@1194 = ~Başla.~
@1195 = ~Bunu düşüneceğim.~
@1196 = ~Kamp sandığı~
@1197 = ~*Kapak gıcırdayarak açılır.*~
@1198 = ~Çift sınıftan önceki seviye~
@1199 = ~Seviye %d: şimdi %d TP, çift sınıftan sonra %d TP~
@1200 = ~%s: %d büyü kitaba geçti~
@1201 = ~%s öğreniyor: %s~
@1202 = ~%s (seviye %d)~
@1203 = ~Büyü kitabı - okuyan: %s~
@1204 = ~Büyü kitabını aç~
@1205 = ~Öğren~
@1206 = ~Kapat~
@1207 = ~Kayıp Büyüler Kitabı~
@1208 = ~Withers bir büyücüyü yeniden yarattığında unuttuğu büyüler bu sayfalarda durur. Kitabı açın: kendi büyü kitabına büyücü büyüsü yazabilen herkes onları yeniden öğrenir (yapabildiklerini).~
@1022 = ~Kilidi ben açarım~
@1023 = ~Zorla açarım~
@1024 = ~Burada kimse bu tuzağı etkisiz hâle getiremez (yine de açmak için tekrar tıklayın)~
@1025 = ~Burada kimse bu kilidi açamaz~
@1209 = ~Otomatik zar: karakter yaratmada bir Auto-Roll düğmesi birçok atışın en iyisini tutar (18/xx güç ağırlıklı)~
@1210 = ~Eşyalarımızı tanımlasan daha iyi olmaz mı?~
@1211 = ~Bu dünya hakkında daha fazla şey öğrenmek istiyorum.~
@1212 = ~Ah, bakalım notlarım ne diyor...~
@1250 = ~Bana yeni bir yoldaş getir.~
@1251 = ~Grubuna bir ruh daha mı? Hiçlikten bir tane yaratabilirim... ya da başka bir yerde tanıdığın birini geri çağırabilirim. Liderin kadar deneyimli olarak sizinle yürüyecek.~
@1252 = ~Onu önümde yarat.~
@1253 = ~Tanıdığım birini geri çağır (içe aktar).~
@1254 = ~Başka zaman.~
@1255 = ~Withers: yeni yoldaş~
@1256 = ~Devam~
@1257 = ~Vazgeç~
@1258 = ~Taşıdığı eşyaları tutsun mu?~
@1259 = ~Tutsun~
@1260 = ~Bıraksın~
@1261 = ~Kendi tecrübesini mi korusun, yoksa grup liderininkini mi alsın?~
@1262 = ~Kendisininki~
@1263 = ~Liderinki~
@1264 = ~%s gruba katılır.~
@1265 = ~Grup dolu (%d üye).~
@1266 = ~Withers yoldaş toplar: oyunun kendi yaratma ekranlarında yaratılan veya içe aktarılan yeni bir yoldaş, ücretsiz~
@1267 = ~Yeni yoldaşın teçhizatı~
@1268 = ~Onayla~
@1269 = ~Büyük tüccardan alınanlar: %d ap (grubun altını: %d ap)~
