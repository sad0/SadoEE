@1347 = ~Kamp rahibesinin fiyatları: %25~
@1348 = ~Kamp rahibesinin fiyatları: ücretsiz~
@1540 = ~SadoEE~
@1541 = ~Oyunda açılıp kapatılan SadoEE özellikleri. Kapatmak yalnızca özelliğin çalışmasını durdurur: daha önce yaptıkları kalır.~
@1542 = ~Sandık ipuçları: kırmızı / mavi eşyalar~
@1543 = ~Grup sandığı sayfası: kullanılamayan eşyalar kırmızı, tanımlanmamışlar mavi.~
@1544 = ~Sandık ipuçları: + geliştirme işareti~
@1545 = ~Grup sandığı sayfası: gösterilen karakter için daha iyi olan eşyalarda veya bir grup üyesinin hâlâ öğrenebileceği büyücü parşömenlerinde bir +.~
@1546 = ~Silah ipuçlarında DPS satırı~
@1547 = ~Kuşanılan silahların tur başına hasarı ve THAC0'ı, ipuçlarına eklenir.~
@1548 = ~Pasif tuzak tespiti~
@1549 = ~Hırsızlar Tuzak Bul modu olmadan çevrelerindeki tuzakları fark eder.~
@1550 = ~Otomatik tuzak etkisizleştirme~
@1551 = ~Savaş dışında boştaki hırsızlar bulunan tuzakları etkisiz hâle getirir.~
@1552 = ~Otomatik açma / kilit açma / kırma~
@1553 = ~Tuzaklı veya kilitli bir kaba tıklamak, en iyi tuzak sökücüyü, kilit açıcıyı veya kırıcıyı gönderir.~
@1554 = ~Değerli kaplarda altın dış hat~
@1555 = ~Değerli bir şey içeren kaplar altın renkli bir dış hat kazanır.~
@1556 = ~Sonsuz mühimmat~
@1557 = ~Oklar, arbalet okları, sapan mermileri, dartlar ve fırlatma silahları hiç tükenmez, en güçlüleri hariç.~
@1558 = ~Sadakta temel mühimmat~
@1559 = ~Yay, arbalet veya sapan kuşanılınca temel mühimmat ilk boş sadak yuvasında bekler.~
@1560 = ~Saldırarak ilerle~
@1561 = ~Saldırarak ilerleme eylemi (SadoEE fare düğmeleri sekmesinde atanır).~
@1562 = ~Ozan Şarkısı / Ölümsüzleri Kov tekrarı yok~
@1563 = ~Grup YZ betikleri zaten açık olan bir modu yeniden başlatmaz (tekrarlanan bildirim satırı yok).~
@1564 = ~Sıralı ganimet~
@1565 = ~Yerdeki, kaplardaki ve ganimet çubuğundaki eşyalar sıralanır.~
@1566 = ~Yerdeki eşyalar çubuğunda sandıklar~
@1567 = ~Yakındaki kaplar yerdeki eşyalar çubuğunda görünür.~
@1568 = ~Kampta bekleme~
@1569 = ~Gruptan ayrılan bir üye dinlenme kampında bekleyebilir.~
