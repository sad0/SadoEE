// Ukrainian translation of SadoEE (from English)
@1001 = ~Пасивний пошук пасток: злодії помічають пастки без режиму «Пошук пасток» (потрібен EEex)~
@1002 = ~Потрібен EEex.~
@1003 = ~Знайдено пастку~
@1004 = ~Цінні контейнери: контейнери з чимось цінним (висока ціна/вага, магія, прикраси, самоцвіти, сувої) мають постійний золотий контур (потрібен EEex)~
@1020 = ~Автоматичне знешкодження пасток: поза боєм кожен бездіяльний злодій з увімкненим пошуком пасток знешкоджує знайдені пастки, які йому до снаги (потрібен EEex)~
@1021 = ~Я займуся пасткою~
@1030 = ~Відсортована здобич: на землі, у контейнерах і на панелі швидкої здобичі спершу квестові предмети, потім невагомі, потім решта за ціною/вагою (потрібен EEex)~
@1040 = ~Половина особистого простору: кожна істота займає вдвічі менше місця, загін більше не застрягає в коридорах (потрібен EEex)~
@1042 = ~Половину особистого простору прибрано: вона ламала досяжність ближнього бою.~
@1050 = ~Лічильник FPS: кадри за секунду й найповільніший кадр угорі ігрового екрана, F12 показує / ховає його (потрібен EEex)~
@1060 = ~Нескінченні набої: стріли, болти, кулі, дротики й метальна зброя загону ніколи не витрачаються, крім найпотужніших (потрібен EEex)~
@1070 = ~Компактний загін: загін більше не застрягає в коридорах, досяжність ближнього бою не змінюється (потрібен EEex)~
@1071 = ~1 клітинка на персонажа~
@1072 = ~Без клітинок: загін проходить крізь усіх, а всі проходять крізь нього~
@1090 = ~Тривалі режими: пісня барда, вигнання нежиті, скритність і танець шамана не перериваються, поки персонаж діє; кнопка «Пошук пасток» вмикає чи вимикає пасивний пошук пасток (потрібен EEex)~
@1091 = ~Пошук пасток: увімкнено~
@1092 = ~Пошук пасток: вимкнено~
@1100 = ~Табір відпочинку: пергамент над кнопкою «Подорожувати» на мапі світу веде до тихого табору (0 год туди й назад, відпочинок без засідок) (потрібен EEex)~
@1101 = ~Табір~
@1102 = ~Назад~
@1110 = ~Хай світло береже ваш табір, мандрівники. Поранені, прокляті й ті, хто втратив супутника, знайдуть тут розраду. Чим можу допомогти?~
@1111 = ~Покажи, що ти пропонуєш.~
@1112 = ~Не зараз, дякую.~
@1113 = ~Мандрівний жрець~
@1114 = ~Послуги мандрівного жерця~
@1115 = ~Великий торговець~
@1116 = ~Ласкаво просимо до табору! Усе, що ви бачили в крамницях Узбережжя, я можу для вас дістати, ще й за найкращою ціною.~
@1117 = ~Подивімося, що в тебе є.~
@1118 = ~Не зараз.~
@1119 = ~Мої вози ще не прибули, приходьте пізніше.~
@1120 = ~Атака в русі: вибраний загін іде до курсора, б'ючись із кожним ворогом, якого помітить дорогою, як у RTS; призначається компонентом «Кнопки миші» (типово кнопка 4) (потрібен EEex)~
@1130 = ~Кнопки миші: середній клік, кнопки 4–8 і Shift / Ctrl + коліщатко запускають дії SadoEE, які обирають у меню налаштувань EEex (потрібен EEex)~
@1131 = ~SadoEE~
@1132 = ~Нічого~
@1133 = ~Атака в русі~
@1134 = ~Аура пасток~
@1135 = ~Лічильник FPS~
@1136 = ~Дія для цієї кнопки. Нічого: гра поводиться як звичайно.~
@1137 = ~Середня кнопка~
@1138 = ~Кнопка 4~
@1139 = ~Кнопка 5~
@1140 = ~Кнопка 6~
@1141 = ~Кнопка 7~
@1142 = ~Кнопка 8~
@1143 = ~Shift + коліщатко вгору~
@1144 = ~Shift + коліщатко вниз~
@1145 = ~Ctrl + коліщатко вгору~
@1146 = ~Ctrl + коліщатко вниз~
@1150 = ~Загін зберігає спорядження після смерті~
@1151 = ~Скрині на панелі предметів на землі~
@1160 = ~Старий учений у таборі (розпізнає все, 80 зм за предмет)~
@1161 = ~О, мандрівники! Ходіть-но, посидьте трохи біля вогню й послухайте. Ці старі очі прочитали більше рун, ніж сьогодні зірок на небі. Покажіть, що ви несете, і я скажу вам, що воно таке насправді.~
@1162 = ~А може, краще розпізнаєш наші речі? (<SQCAINC> зм)~
@1163 = ~Ну-бо, погляньмо... <SQCAINN> з ваших речей бережуть свої таємниці. За <SQCAINC> золотих я назву кожну з них.~
@1164 = ~Зроби це.~
@1165 = ~Ось і все. Кожна розповіла мені свою історію, і тепер ви теж її знаєте. Користуйтеся ними мудро, друже мій.~
@1166 = ~Не зараз.~
@1167 = ~Усе, що ви несете, вам уже відоме. Повертайтеся, коли дорога підкине вам нові загадки.~
@1168 = ~На жаль, ваш гаманець надто легкий: <SQCAINC> золотих, і ні монетою менше. Навіть старому вченому треба їсти.~
@1169 = ~Що ж, погляньмо на ваші скарби.~
@1170 = ~Розкажи нам історію, старче.~
@1171 = ~Давним-давно вчені мого ордену ув'язнили жахливі речі в камені й глибоко закопали ті камені. Боюся, не кожен камінь витримав. Якщо знайдете самоцвіт, що шепоче вночі... спершу принесіть його мені.~
@1172 = ~Прощавай.~
@1173 = ~Старий учений~
@1174 = ~Очікування в таборі: персонаж, що покидає загін, може чекати на вас у таборі відпочинку, біля вогнища~
@1175 = ~Візерс у таборі: ліч, який повністю відтворює члена загону (раса, клас, спеціалізація, характеристики...), безкоштовно~
@1176 = ~Візерс~
@1177 = ~%s: предмет %s прибрано до скрині (наплічник повний)~
@1178 = ~Продовжити~
@1179 = ~Завершити~
@1180 = ~Мені чекати на тебе в таборі?~
@1181 = ~Так, чекай на мене в таборі.~
@1182 = ~Ні, лишайся тут.~
@1183 = ~Знову в дорогу?~
@1184 = ~Приєднуйся до нас.~
@1185 = ~Ще ні.~
@1186 = ~Підтвердити~
@1187 = ~Без подвійного класу~
@1188 = ~%s: повернуто %d досвіду після переходу на подвійний клас~
@1190 = ~Смертний. Ти носиш подобу, яку дав тобі світ. Я можу розвіяти її, і ти обереш іншу... ще раз, від самого початку.~
@1191 = ~Перероби мене.~
@1192 = ~Не сьогодні.~
@1193 = ~Знай: щойно я почну, шляху назад не буде. Раса, покликання, розум і тіло, усе буде обрано наново. Твої спогади й майно залишаться. Починати?~
@1194 = ~Починай.~
@1195 = ~Я подумаю.~
@1196 = ~Скриня табору~
@1197 = ~*Віко зі скрипом відчиняється.*~
@1198 = ~Рівень перед подвійним класом~
@1199 = ~Рівень %d: %d досвіду зараз, %d досвіду після подвійного класу~
@1200 = ~%s: %d закл. записано до гримуара~
@1201 = ~%s вивчає: %s~
@1202 = ~%s (рівень %d)~
@1203 = ~Гримуар - читає %s~
@1204 = ~Відкрити гримуар~
@1205 = ~Вивчити~
@1206 = ~Закрити~
@1207 = ~Гримуар утрачених заклять~
@1208 = ~На цих сторінках спочивають закляття, які маг забув, коли Візерс його переробив. Відкрийте гримуар, і кожен, хто вміє записувати закляття магів до своєї книги, вивчить їх знову (ті, які може творити).~
@1022 = ~Я відімкну замок~
@1023 = ~Я виламаю його~
@1024 = ~Ніхто тут не може знешкодити цю пастку (клацніть ще раз, щоб однаково відчинити)~
@1025 = ~Ніхто тут не може відімкнути цей замок~
@1209 = ~Авто-кидки: кнопка Auto-Roll під час створення персонажа зберігає найкращий з багатьох кидків (з урахуванням сили 18/xx)~
@1210 = ~А може, краще розпізнаєш наші речі?~
@1211 = ~Я хотів би дізнатися більше про цей світ.~
@1212 = ~О, погляньмо, що кажуть мої записи...~
@1250 = ~Приведи мені нового супутника.~
@1251 = ~Ще одна душа для твого загону? Я можу створити її з нічого... або покликати ту, яку ти знав деінде. Він піде з вами, такий самий досвідчений, як ваш ватажок.~
@1252 = ~Створи його в мене на очах.~
@1253 = ~Поклич того, кого я знав (імпорт).~
@1254 = ~Іншим разом.~
@1255 = ~Візерс: новий супутник~
@1256 = ~Продовжити~
@1257 = ~Відмовитися~
@1258 = ~Залишити йому предмети, що були при ньому?~
@1259 = ~Залишити~
@1260 = ~Не залишати~
@1261 = ~Залишити йому власний досвід чи дати досвід ватажка загону?~
@1262 = ~Власний~
@1263 = ~Досвід ватажка~
@1264 = ~%s приєднується до загону.~
@1265 = ~Загін повний (%d осіб).~
@1266 = ~Візерс набирає: новий супутник, створений на екранах створення персонажа або імпортований, безкоштовно~
@1267 = ~Спорядження нового супутника~
@1268 = ~Підтвердити~
@1269 = ~Куплено у Великого торговця: %d зм (золото загону: %d зм)~
@1270 = ~Скриня~
@1272 = ~безкоштовно~
@1273 = ~Зброя ближнього бою~
@1274 = ~Друга рука~
@1275 = ~Далекобійна зброя~
@1276 = ~Набої~
@1277 = ~Обладунок~
@1278 = ~Шолом~
@1279 = ~Амулет~
@1280 = ~Персні (два)~
@1281 = ~Наручі / рукавиці~
@1282 = ~Пояс~
@1283 = ~Чоботи~
@1284 = ~Плащ~
@1285 = ~Візерс пропонує~
@1286 = ~Прийми наш дар для свого храму: <SQPRRC> зм (репутація <SQPRREP> -> <SQPRNEXT>).~
@1287 = ~Зціли весь загін: <SQPRHL>. Разом: <SQPRHC> зм.~
@1288 = ~Благословляю вас. Бідняки Узбережжя згадуватимуть ваші імена добрим словом.~
@1289 = ~Готово. Підведіться, усі ви, і йдіть у світлі.~
@1290 = ~На жаль, ваш гаманець для цього надто легкий. Повертайтеся, коли зможете.~
@1291 = ~воскресіння~
@1292 = ~рани~
@1293 = ~втрачені рівні~
@1294 = ~прокляття~
@1295 = ~отрута~
@1296 = ~хвороба~
@1297 = ~Некромант~
@1298 = ~Мертвим нема чого робити, крім як допомагати живим тренуватися. Назвіть ворога, і він постане перед вами... безпечний, якщо не попросите іншого.~
@1299 = ~Підійми для нас істоту.~
@1300 = ~Спусти їх із ланцюга: хай б'ються й гинуть.~
@1301 = ~Утихомир їх: хай знову стануть безсмертними ляльками.~
@1302 = ~Прибери їх: хай усі впадуть.~
@1303 = ~Прощавай.~
@1304 = ~<SQNECRN>: скільки їх має постати?~
@1305 = ~Один.~
@1306 = ~Два.~
@1307 = ~Три.~
@1308 = ~П'ять.~
@1309 = ~Десять.~
@1310 = ~Жодного, я передумав.~
@1311 = ~Прив'яжи їх до нас: хай вступлять до нашого загону.~
@1312 = ~Готово.~
@1313 = ~Бестіарій~
@1314 = ~Чудовиська~
@1315 = ~Люди~
@1316 = ~Пошук~
@1317 = ~Підняти~
@1318 = ~Закрити~
@1319 = ~Рівень~
@1322 = ~Шкода~
@1323 = ~Разом~
@1324 = ~Скинути~
@1325 = ~Істот: %d~
@1326 = ~Некромант у таборі: тренувальні опудала з усього бестіарію, лічильник шкоди (потрібен табір відпочинку)~
@1340 = ~Зціли наші рани, прошу.~
@1341 = ~Ось так. Відпочивайте спокійно: світло нічого за це не просить.~
@1342 = ~Жриця перев'язала ваші рани, поки ви спали.~
@1343 = ~Жриця лікує рани загону.~
@1344 = ~Ціни жриці табору~
@1345 = ~Ціни жриці табору: 75 %~
@1346 = ~Ціни жриці табору: 50 %~
@1347 = ~Ціни жриці табору: 25 %~
@1348 = ~Ціни жриці табору: безкоштовно~
@1540 = ~SadoEE~
@1541 = ~Функції SadoEE, які вмикають і вимикають у грі. Вимкнення лише зупиняє функцію: те, що вона вже зробила, лишається.~
@1542 = ~Підказки скрині: червоні / сині предмети~
@1543 = ~Сторінка скрині загону: непридатні предмети червоним, нерозпізнані синім.~
@1544 = ~Підказки скрині: позначка + покращення~
@1545 = ~Сторінка скрині загону: + на предметах, які покращать показаного персонажа, або на сувоях магів, які член загону ще може вивчити.~
@1546 = ~Рядок DPS у підказках зброї~
@1547 = ~Шкода за раунд і THAC0 спорядженої зброї додаються до її підказок.~
@1548 = ~Пасивний пошук пасток~
@1549 = ~Злодії помічають пастки довкола себе без режиму «Пошук пасток».~
@1550 = ~Автознешкодження пасток~
@1551 = ~Поза боєм бездіяльні злодії знешкоджують знайдені пастки.~
@1552 = ~Автовідкриття / відмикання / виламування~
@1553 = ~Клік по контейнеру з пасткою чи замком надсилає найкращого сапера, зломщика або силача.~
@1554 = ~Золотий контур цінних контейнерів~
@1555 = ~Контейнери з чимось цінним мають золотий контур.~
@1556 = ~Нескінченні набої~
@1557 = ~Стріли, болти, кулі, дротики й метальна зброя ніколи не витрачаються, крім найпотужніших.~
@1558 = ~Прості набої в сагайдаку~
@1559 = ~Коли в руках лук, арбалет чи праща, прості набої чекають у першій порожній комірці сагайдака.~
@1560 = ~Атака в русі~
@1561 = ~Дія «Атака в русі» (призначається на вкладці кнопок миші SadoEE).~
@1562 = ~Без спаму пісні барда / вигнання нежиті~
@1563 = ~Скрипти ШІ загону більше не перезапускають уже ввімкнений режим (без повторюваного рядка повідомлень).~
@1564 = ~Відсортована здобич~
@1565 = ~Предмети на землі, у контейнерах і на панелі здобичі відсортовано.~
@1566 = ~Скрині на панелі предметів на землі~
@1567 = ~Найближчі контейнери показуються на панелі предметів на землі.~
@1568 = ~Очікування в таборі~
@1569 = ~Персонаж, що покидає загін, може чекати в таборі відпочинку.~
@1570 = ~Лічильник FPS~
@1571 = ~Кадри за секунду вгорі ігрового екрана (F12 теж показує / ховає його).~
