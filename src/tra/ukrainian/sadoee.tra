// Ukrainian translation of SadoEE (from English)
@2000 = ~Party Stash~
@2001 = ~Табір відпочинку~
@2002 = ~Зручність гри~
@2003 = ~Розширення рушія~
@2010 = ~SadoEE замінює Party Stash і SadoQoL (ті самі файли): спершу видаліть усі компоненти Party Stash і SadoQoL. Вміст скрині лишається у ваших збереженнях і повернеться разом зі скринею SadoEE.~
@2011 = ~Потрібен компонент «Табір відпочинку».~
@2012 = ~Великий торговець у таборі відпочинку: продає кожен предмет, побачений у вже відвіданих крамницях (потрібні табір відпочинку й скриня)~
@2013 = ~Потрібна скриня.~
@2014 = ~Поки що лише Baldur's Gate EE та EET (табір для BG2EE уже незабаром).~
