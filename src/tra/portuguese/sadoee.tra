// Brazilian Portuguese translation of SadoEE (from English)
@2000 = ~Party Stash~
@2001 = ~Acampamento de descanso~
@2002 = ~Qualidade de vida~
@2003 = ~Extensão do motor~
@2010 = ~O SadoEE substitui o Party Stash e o SadoQoL (mesmos arquivos): desinstale antes todos os componentes do Party Stash e do SadoQoL. O conteúdo do baú fica nos seus saves e volta com o baú do SadoEE.~
@2011 = ~Requer o componente Acampamento de descanso.~
@2012 = ~Grande mercador no acampamento de descanso: vende todo item visto nas lojas já visitadas (requer o acampamento de descanso e o baú)~
@2013 = ~Requer o baú.~
@2014 = ~Requer Baldur's Gate EE, Baldur's Gate II EE ou EET.~
