// Polish translation of SadoEE (from English)
@1001 = ~Pasywne wykrywanie pułapek: złodzieje dostrzegają pułapki bez trybu Wykrywania pułapek (wymaga EEex)~
@1002 = ~Wymaga EEex.~
@1003 = ~Wykryto pułapkę~
@1004 = ~Cenne pojemniki: pojemniki z czymś cennym (wysoka wartość/waga, magia, biżuteria, klejnot, zwój) mają stały złoty obrys (wymaga EEex)~
@1020 = ~Automatyczne rozbrajanie pułapek: poza walką każdy bezczynny złodziej z włączonym wykrywaniem pułapek rozbraja wykryte pułapki, z którymi sobie poradzi (wymaga EEex)~
@1021 = ~Zajmę się tą pułapką~
@1030 = ~Posortowane łupy: na ziemi, w pojemnikach i na pasku szybkich łupów najpierw przedmioty fabularne, potem przedmioty bez wagi, a reszta według wartości/wagi (wymaga EEex)~
@1040 = ~Połowa przestrzeni osobistej: każda istota zajmuje o połowę mniej miejsca, drużyna nie blokuje się już w korytarzach (wymaga EEex)~
@1042 = ~Usunięto połowę przestrzeni osobistej: psuła zasięg walki wręcz.~
@1050 = ~Licznik FPS: klatki na sekundę i najwolniejsza klatka u góry ekranu gry, F12 pokazuje / ukrywa licznik (wymaga EEex)~
@1060 = ~Niekończąca się amunicja: strzały, bełty, pociski do procy, strzałki i broń miotana drużyny nigdy się nie zużywają, z wyjątkiem najpotężniejszych (wymaga EEex)~
@1070 = ~Mniejsze rozmiary drużyny: drużyna nie blokuje się już w korytarzach, zasięg walki wręcz bez zmian (wymaga EEex)~
@1071 = ~1 pole na postać~
@1072 = ~Brak pola: drużyna przechodzi przez wszystkich, a wszyscy przez nią~
@1090 = ~Trwałe tryby: pieśń barda, odpędzanie nieumarłych, skradanie się i taniec szamana pozostają aktywne, gdy postać działa; przycisk Wykrywanie pułapek włącza lub wyłącza pasywne wykrywanie pułapek (wymaga EEex)~
@1091 = ~Wykrywanie pułapek: włączone~
@1092 = ~Wykrywanie pułapek: wyłączone~
@1100 = ~Obóz odpoczynku: pergamin nad przyciskiem Podróż na mapie świata prowadzi do spokojnego obozu (0 godz. w obie strony, odpoczynek bez zasadzek) (wymaga EEex)~
@1101 = ~Obóz~
@1102 = ~Powrót~
@1110 = ~Niech światło czuwa nad waszym obozem, wędrowcy. Ranni, przeklęci i ci, którzy stracili towarzysza, znajdą tu pocieszenie. Jak mogę wam pomóc?~
@1111 = ~Pokaż, co masz do zaoferowania.~
@1112 = ~Nie teraz, dziękuję.~
@1113 = ~Wędrowny kapłan~
@1114 = ~Usługi wędrownego kapłana~
@1115 = ~Wielki kupiec~
@1116 = ~Witajcie w obozie! Wszystko, co widzieliście w sklepach Wybrzeża, mogę dla was zdobyć, i to w najlepszej cenie.~
@1117 = ~Zobaczmy, co masz.~
@1118 = ~Nie teraz.~
@1119 = ~Moje wozy jeszcze nie dotarły, wróćcie później.~
@1120 = ~Atak w ruchu: wybrana drużyna idzie do kursora, walcząc z każdym wrogiem napotkanym po drodze, jak w grach RTS; przypisywany w komponencie Przyciski myszy (domyślnie przycisk 4) (wymaga EEex)~
@1130 = ~Przyciski myszy: środkowy przycisk, przyciski 4 do 8 i kółko, same lub z Shift / Ctrl / Alt, uruchamiają dowolną akcję ze skrótów klawiszowych gry lub atak w ruchu (domyślnie przycisk 4), ustawiane na stronie opcji SadoEE (wymaga EEex)~
@1131 = ~SadoEE~
@1132 = ~Nic~
@1133 = ~Atak w ruchu~
@1134 = ~Aura pułapek~
@1135 = ~Licznik FPS~
@1136 = ~Akcja uruchamiana tym przyciskiem. Nic: gra zachowuje się normalnie.~
@1137 = ~Środkowy przycisk~
@1138 = ~Przycisk 4~
@1139 = ~Przycisk 5~
@1140 = ~Przycisk 6~
@1141 = ~Przycisk 7~
@1142 = ~Przycisk 8~
@1143 = ~Shift + kółko w górę~
@1144 = ~Shift + kółko w dół~
@1145 = ~Ctrl + kółko w górę~
@1146 = ~Ctrl + kółko w dół~
@1150 = ~Drużyna zachowuje ekwipunek po śmierci~
@1151 = ~Skrzynie na pasku przedmiotów na ziemi~
@1160 = ~Stary Uczony w obozie (identyfikuje wszystko, 80 szt. złota za przedmiot)~
@1161 = ~Ach, wędrowcy! Chodźcie, usiądźcie na chwilę przy ogniu i posłuchajcie. Te stare oczy przeczytały więcej run, niż jest dziś gwiazd na niebie. Pokażcie mi, co nosicie, a powiem wam, czym to naprawdę jest.~
@1162 = ~A może wolałbyś zidentyfikować nasze przedmioty? (<SQCAINC> szt. złota)~
@1163 = ~Niech no spojrzę... <SQCAINN> z waszych rzeczy skrywa swoje tajemnice. Za <SQCAINC> sztuk złota nazwę każdą z nich.~
@1164 = ~Zrób to.~
@1165 = ~Proszę. Każda opowiedziała mi swoją historię, a teraz znacie ją i wy. Używajcie ich mądrze, przyjacielu.~
@1166 = ~Nie teraz.~
@1167 = ~Wszystko, co nosicie, jest wam już znane. Wróćcie, gdy droga przyniesie wam nowe zagadki.~
@1168 = ~Niestety, wasza sakiewka jest zbyt lekka: <SQCAINC> sztuk złota, ani grosza mniej. Nawet stary uczony musi coś jeść.~
@1169 = ~Dobrze więc, przyjrzyjmy się waszym skarbom.~
@1170 = ~Opowiedz nam jakąś historię, starcze.~
@1171 = ~Dawno temu uczeni z mojego zakonu zamknęli straszliwe rzeczy w kamieniu i zakopali te kamienie głęboko. Obawiam się, że nie każdy kamień wytrzymał. Gdy znajdziecie klejnot, który szepcze nocą... przynieście go najpierw do mnie.~
@1172 = ~Bywajcie.~
@1173 = ~Stary Uczony~
@1174 = ~Czekanie w obozie: członek, który opuszcza drużynę, może zaczekać na ciebie w obozie odpoczynku, przy ognisku~
@1175 = ~Withers w obozie: lisz, który całkowicie odtwarza członka drużyny (rasa, klasa, specjalizacja, atrybuty...), za darmo~
@1176 = ~Withers~
@1177 = ~%s: przedmiot %s trafia do skrzyni (plecak pełny)~
@1178 = ~Dalej~
@1179 = ~Zakończ~
@1180 = ~Mam zaczekać na ciebie w obozie?~
@1181 = ~Tak, zaczekaj na mnie w obozie.~
@1182 = ~Nie, zostań tutaj.~
@1183 = ~Ruszamy znów w drogę?~
@1184 = ~Dołącz do nas.~
@1185 = ~Jeszcze nie.~
@1186 = ~Zatwierdź~
@1187 = ~Bez dwuklasowości~
@1188 = ~%s: zwrócono %d PD po przejściu na dwie klasy~
@1190 = ~Śmiertelniku. Nosisz kształt, który dał ci świat. Mogę go rozplątać, a ty wybierzesz inny... jeszcze raz, od samego początku.~
@1191 = ~Stwórz mnie na nowo.~
@1192 = ~Nie dziś.~
@1193 = ~Wiedz jedno: gdy zacznę, nie będzie odwrotu. Rasa, powołanie, umysł i ciało, wszystko wybrane na nowo. Twoje wspomnienia i dobytek pozostaną. Mam zaczynać?~
@1194 = ~Zaczynaj.~
@1195 = ~Zastanowię się.~
@1196 = ~Skrzynia obozowa~
@1197 = ~*Wieko otwiera się ze skrzypieniem.*~
@1198 = ~Poziom przed dwuklasowością~
@1199 = ~Poziom %d: %d PD teraz, %d PD po dwuklasowości~
@1200 = ~%s: %d czarów trafiło do grymuaru~
@1201 = ~%s uczy się: %s~
@1202 = ~%s (poziom %d)~
@1203 = ~Grymuar - czyta %s~
@1204 = ~Otwórz grymuar~
@1205 = ~Naucz się~
@1206 = ~Zamknij~
@1207 = ~Grymuar utraconych czarów~
@1208 = ~Na tych kartach spoczywają czary, które mag zapomniał, gdy Withers stworzył go na nowo. Otwórz go, a każdy, kto potrafi wpisywać czary maga do swojej księgi, nauczy się ich ponownie (tych, które może rzucać).~
@1022 = ~Otworzę ten zamek wytrychem~
@1023 = ~Wyważę to~
@1024 = ~Nikt tutaj nie potrafi rozbroić tej pułapki (kliknij ponownie, aby mimo to otworzyć)~
@1025 = ~Nikt tutaj nie potrafi otworzyć tego zamka~
@1209 = ~Auto-Roller: przycisk Auto-Roll przy tworzeniu postaci zachowuje najlepszy z wielu rzutów (z uwzględnieniem siły 18/xx)~
@1210 = ~A może wolałbyś zidentyfikować nasze przedmioty?~
@1211 = ~Opowiedz mi więcej o tym świecie.~
@1212 = ~Ach, zobaczmy, co mówią moje notatki...~
@1250 = ~Sprowadź mi nowego towarzysza.~
@1251 = ~Jeszcze jedna dusza dla twojej kompanii? Mogę ulepić ją z niczego... albo przywołać kogoś, kogo znałeś gdzie indziej. Będzie wam towarzyszyć, równie doświadczona jak twój przywódca.~
@1252 = ~Stwórz go na moich oczach.~
@1253 = ~Przywołaj kogoś, kogo znałem (import).~
@1254 = ~Innym razem.~
@1255 = ~Withers: nowy towarzysz~
@1256 = ~Dalej~
@1257 = ~Zrezygnuj~
@1258 = ~Czy zachowuje przedmioty, które nosił?~
@1259 = ~Zachowuje je~
@1260 = ~Zostaw je~
@1261 = ~Czy zachowuje własne doświadczenie, czy przejmuje doświadczenie przywódcy drużyny?~
@1262 = ~Własne~
@1263 = ~Przywódcy~
@1264 = ~%s dołącza do drużyny.~
@1265 = ~Drużyna jest pełna (członków: %d).~
@1266 = ~Withers rekrutuje: nowy towarzysz stworzony na ekranach tworzenia postaci z gry lub zaimportowany, za darmo~
@1267 = ~Ekwipunek nowego towarzysza~
@1268 = ~Zatwierdź~
@1269 = ~Zakupy u Wielkiego kupca: %d szt. złota (złoto drużyny: %d szt.)~
@1270 = ~Skrzynia~
@1272 = ~gratis~
@1273 = ~Broń do walki wręcz~
@1274 = ~Druga ręka~
@1275 = ~Broń dystansowa~
@1276 = ~Amunicja~
@1277 = ~Pancerz~
@1278 = ~Hełm~
@1279 = ~Amulet~
@1280 = ~Pierścienie (dwa)~
@1281 = ~Karwasze / rękawice~
@1282 = ~Pas~
@1283 = ~Buty~
@1284 = ~Płaszcz~
@1285 = ~Withers oferuje~
@1286 = ~Przyjmij nasz dar dla twojej świątyni: <SQPRRC> szt. złota (reputacja <SQPRREP> -> <SQPRNEXT>).~
@1287 = ~Ulecz całą drużynę: <SQPRHL>. Razem: <SQPRHC> szt. złota.~
@1288 = ~Bądźcie błogosławieni. Ubodzy z Wybrzeża będą wymawiać wasze imiona z wdzięcznością.~
@1289 = ~Stało się. Powstańcie, wy wszyscy, i kroczcie w świetle.~
@1290 = ~Niestety, wasza sakiewka jest na to zbyt lekka. Wróćcie, gdy będziecie mogli.~
@1291 = ~wskrzeszenie~
@1292 = ~rany~
@1293 = ~utracone poziomy~
@1294 = ~klątwa~
@1295 = ~trucizna~
@1296 = ~choroba~
@1297 = ~Nekromanta~
@1298 = ~Umarli nie mają nic lepszego do roboty, niż pomagać żywym w treningu. Wskażcie przeciwnika, a powstanie przed wami... nieszkodliwy, chyba że zażądacie inaczej.~
@1299 = ~Ożyw dla nas stwora.~
@1300 = ~Uwolnij ich: niech walczą i giną.~
@1301 = ~Uspokój ich: niech znów będą nieśmiertelnymi kukłami.~
@1302 = ~Posprzątaj: niech wszyscy padną.~
@1303 = ~Bywaj.~
@1304 = ~Ile ma powstać: <SQNECRN>?~
@1305 = ~Jeden.~
@1306 = ~Dwa.~
@1307 = ~Trzy.~
@1308 = ~Pięć.~
@1309 = ~Dziesięć.~
@1310 = ~Żadnego, rozmyśliłem się.~
@1311 = ~Zwiąż ich z nami: niech dołączą do naszej drużyny.~
@1312 = ~Stało się.~
@1313 = ~Bestiariusz~
@1314 = ~Potwory~
@1315 = ~Ludzie~
@1316 = ~Szukaj~
@1317 = ~Ożyw~
@1318 = ~Zamknij~
@1319 = ~Poziom~
@1322 = ~Obrażenia~
@1323 = ~Suma~
@1324 = ~Wyczyść~
@1325 = ~Stworzenia: %d~
@1326 = ~Nekromanta w obozie: manekiny treningowe z całego bestiariusza, licznik obrażeń (wymaga obozu odpoczynku)~
@1340 = ~Opatrz nasze rany, proszę.~
@1341 = ~Proszę. Bądźcie spokojni: światło nie żąda za to niczego.~
@1342 = ~Kapłanka opatrzyła wasze rany, gdy spaliście.~
@1343 = ~Kapłanka opatruje rany drużyny.~
@1344 = ~Ceny kapłanki w obozie~
@1345 = ~Ceny kapłanki w obozie: 75 %~
@1346 = ~Ceny kapłanki w obozie: 50 %~
@1347 = ~Ceny kapłanki w obozie: 25 %~
@1348 = ~Ceny kapłanki w obozie: za darmo~
@1540 = ~SadoEE~
@1541 = ~Funkcje SadoEE włączane lub wyłączane w grze. Wyłączenie tylko powstrzymuje funkcję przed działaniem: to, co już zrobiła, zostaje.~
@1542 = ~Wskazówki skrzyni: przedmioty czerwone / niebieskie~
@1543 = ~Strona skrzyni drużyny: przedmioty nieużywalne na czerwono, niezidentyfikowane na niebiesko.~
@1544 = ~Wskazówki skrzyni: znak + ulepszenia~
@1545 = ~Strona skrzyni drużyny: + na przedmiotach, które są ulepszeniem dla wyświetlanej postaci, lub na zwoju maga, którego członek drużyny może się jeszcze nauczyć.~
@1546 = ~Linia DPS w podpowiedziach broni~
@1547 = ~Obrażenia na rundę i THAC0 założonej broni, dodane do jej podpowiedzi.~
@1548 = ~Pasywne wykrywanie pułapek~
@1549 = ~Złodzieje dostrzegają pułapki wokół siebie bez trybu Wykrywania pułapek.~
@1550 = ~Automatyczne rozbrajanie pułapek~
@1551 = ~Poza walką bezczynni złodzieje rozbrajają wykryte pułapki.~
@1552 = ~Auto otwieranie / wytrych / wyważanie~
@1553 = ~Kliknięcie pojemnika z pułapką lub zamkniętego wysyła najlepszego rozbrajacza, włamywacza lub siłacza.~
@1554 = ~Złoty obrys cennych pojemników~
@1555 = ~Pojemniki z czymś cennym otrzymują złoty obrys.~
@1556 = ~Niekończąca się amunicja~
@1557 = ~Strzały, bełty, pociski do procy, strzałki i broń miotana nigdy się nie zużywają, z wyjątkiem najpotężniejszych.~
@1558 = ~Podstawowa amunicja w kołczanie~
@1559 = ~Gdy założony jest łuk, kusza lub proca, podstawowa amunicja czeka w pierwszym wolnym miejscu kołczanu.~
@1560 = ~Atak w ruchu~
@1561 = ~Akcja ataku w ruchu (przypisywana w karcie przycisków myszy SadoEE).~
@1562 = ~Bez powtarzania pieśni barda / odpędzania nieumarłych~
@1563 = ~Skrypty SI drużyny nie uruchamiają ponownie trybu, który jest już aktywny (bez powtarzanej linii komunikatu).~
@1564 = ~Posortowane łupy~
@1565 = ~Przedmioty na ziemi, w pojemnikach i na pasku łupów są posortowane.~
@1566 = ~Skrzynie na pasku przedmiotów na ziemi~
@1567 = ~Pobliskie pojemniki pojawiają się na pasku przedmiotów na ziemi.~
@1568 = ~Czekanie w obozie~
@1569 = ~Członek, który opuszcza drużynę, może zaczekać w obozie odpoczynku.~
@1570 = ~Licznik FPS~
@1571 = ~Klatki na sekundę u góry ekranu gry (F12 również pokazuje / ukrywa licznik).~
@1572 = ~Skrzynia drużyny~
@1573 = ~Pułapki i pojemniki~
@1574 = ~Walka i amunicja~
@1575 = ~Łupy i obóz~
@1576 = ~Wyświetlanie~
@1577 = ~Przyciski myszy~
@1578 = ~Zamknij~
@1579 = ~Atak w ruchu (SadoEE)~
@1580 = ~Nic~
@1581 = ~Pokaż wszystkie akcje...~
@1582 = ~Anuluj~
@1583 = ~Sam~
@1584 = ~Shift~
@1585 = ~Ctrl~
@1586 = ~Alt~
@1587 = ~Środkowy przycisk~
@1588 = ~Kółko w górę~
@1589 = ~Kółko w dół~
@1590 = ~Kółko w lewo~
@1591 = ~Kółko w prawo~
@1592 = ~Otwórz stronę opcji SadoEE~
@1593 = ~Przełączniki i przyciski myszy SadoEE mają własną stronę: także w menu Opcje gry (Esc) i u Decarda w obozie.~
@1594 = ~Chciałbym zmienić kilka nawyków drużyny.~
@1595 = ~Oczywiście. Oto jak wyglądają sprawy.~
@1596 = ~Wskaż linię, aby przeczytać jej opis.~
@1597 = ~Kliknięcie: wybór akcji. Prawy przycisk: nic. Boczne przyciski myszy MMO wysyłają klawisze: przypisz je w Skrótach klawiszowych gry.~
@1600 = ~Pary BN mogą się rozdzielić: odprawienie jednej postaci nie odprawia już drugiej (Jaheira i Khalid, Minsc i Dynaheir, Xzar i Montaron, Eldoth i Skie)~
@1601 = ~Ten komponent jest dla Baldur's Gate (BGEE) i EET.~
@1602 = ~Wymaga Withersa w obozie odpoczynku (jego komponent musi zostać zainstalowany wcześniej).~
@1603 = ~Auto-losowanie~
@1604 = ~Zatrzymaj (%.1fs)~
@1605 = ~Waga 18/xx: %d~
@1606 = ~Czas: %ds~
@1607 = ~Najlepszy: %d~
@1608 = ~SIŁ~
@1609 = ~Losowań: %s~
