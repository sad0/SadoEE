// German translation of SadoEE (from English)
@1001 = ~Passive Fallenerkennung: Diebe entdecken Fallen auch ohne den Modus Fallen finden (benötigt EEex)~
@1002 = ~Benötigt EEex.~
@1003 = ~Falle entdeckt~
@1004 = ~Wertvolle Behälter: Behälter mit etwas Wertvollem (hoher Wert/Gewicht, magisch, Schmuck, Edelstein, Schriftrolle) erhalten einen dauerhaften goldenen Umriss (benötigt EEex)~
@1020 = ~Automatisches Entschärfen: außerhalb des Kampfes entschärft jeder untätige Dieb mit aktiver Fallenerkennung die entdeckten Fallen, die er entschärfen kann (benötigt EEex)~
@1021 = ~Ich kümmere mich um die Falle~
@1030 = ~Sortierte Beute: am Boden, in Behältern und in der Beuteleiste zuerst Questgegenstände, dann gewichtslose Gegenstände, dann der Rest nach Wert/Gewicht (benötigt EEex)~
@1040 = ~Halber persönlicher Raum: jede Kreatur braucht nur halb so viel Platz, die Gruppe verkeilt sich nicht mehr in Gängen (benötigt EEex)~
@1042 = ~Der halbe persönliche Raum wurde entfernt: er störte die Nahkampfreichweite.~
@1050 = ~FPS-Anzeige: Bilder pro Sekunde und das langsamste Bild oben im Spielbildschirm, F12 blendet sie ein / aus (benötigt EEex)~
@1060 = ~Endlose Munition: Pfeile, Bolzen, Kugeln, Wurfpfeile und Wurfwaffen der Gruppe werden nie verbraucht, außer den mächtigsten (benötigt EEex)~
@1070 = ~Kleiner Gruppen-Fußabdruck: die Gruppe verkeilt sich nicht mehr in Gängen, die Nahkampfreichweite bleibt gleich (benötigt EEex)~
@1071 = ~1 Feld pro Charakter~
@1072 = ~Kein Feld: die Gruppe läuft durch alle hindurch, und alle durch sie~
@1090 = ~Dauerhafte Modi: Bardenlied, Untote vertreiben, Schleichen und Schamanentanz bleiben aktiv, während der Charakter handelt; die Schaltfläche Fallen finden schaltet die passive Fallenerkennung ein oder aus (benötigt EEex)~
@1091 = ~Fallenerkennung: an~
@1092 = ~Fallenerkennung: aus~
@1100 = ~Rastlager: ein Pergament über der Schaltfläche Reisen der Weltkarte führt zu einem ruhigen Lager (0 Std. hin und zurück, Rasten ohne Überfall) (benötigt EEex)~
@1101 = ~Lager~
@1102 = ~Zurück~
@1110 = ~Möge das Licht über Euer Lager wachen, Reisende. Die Verwundeten, die Verfluchten und jene, die einen Gefährten verloren haben, finden hier Trost. Wie kann ich Euch helfen?~
@1111 = ~Zeigt mir, was Ihr anbietet.~
@1112 = ~Jetzt nicht, danke.~
@1113 = ~Wandernder Priester~
@1114 = ~Dienste des wandernden Priesters~
@1115 = ~Großhändler~
@1116 = ~Willkommen im Lager! Alles, was Ihr in den Läden der Schwertküste gesehen habt, kann ich Euch besorgen, zum besten Preis.~
@1117 = ~Mal sehen, was Ihr habt.~
@1118 = ~Jetzt nicht.~
@1119 = ~Meine Wagen sind noch nicht eingetroffen, kommt später wieder.~
@1120 = ~Angriffsbewegung: die ausgewählte Gruppe läuft zum Cursor und bekämpft unterwegs jeden gesichteten Feind, wie in einem Echtzeitstrategiespiel; belegt über die Komponente Maustasten (standardmäßig Taste 4) (benötigt EEex)~
@1130 = ~Maustasten: Mittelklick, Tasten 4 bis 8 und Umschalt / Strg + Mausrad lösen SadoEE-Aktionen aus, wählbar im Optionsmenü von EEex (benötigt EEex)~
@1131 = ~SadoEE~
@1132 = ~Nichts~
@1133 = ~Angriffsbew.~
@1134 = ~Fallenaura~
@1135 = ~FPS-Anzeige~
@1136 = ~Aktion für diese Eingabe. Nichts: das Spiel verhält sich wie gewohnt.~
@1137 = ~Mittelklick~
@1138 = ~Taste 4~
@1139 = ~Taste 5~
@1140 = ~Taste 6~
@1141 = ~Taste 7~
@1142 = ~Taste 8~
@1143 = ~Umschalt + Rad hoch~
@1144 = ~Umschalt + Rad runter~
@1145 = ~Strg + Rad hoch~
@1146 = ~Strg + Rad runter~
@1150 = ~Die Gruppe behält ihre Ausrüstung beim Tod~
@1151 = ~Truhen in der Leiste der Bodengegenstände~
@1160 = ~Der Alte Gelehrte im Lager (identifiziert alles, 80 GM pro Gegenstand)~
@1161 = ~Ah, Reisende! Kommt, setzt Euch eine Weile ans Feuer und hört zu. Diese alten Augen haben mehr Runen gelesen, als heute Nacht Sterne am Himmel stehen. Zeigt mir, was Ihr bei Euch tragt, und ich sage Euch, was es wirklich ist.~
@1162 = ~Wollt Ihr nicht lieber unsere Gegenstände identifizieren? (<SQCAINC> Gold)~
@1163 = ~Lasst sehen... <SQCAINN> Eurer Sachen hüten noch ihre Geheimnisse. Für <SQCAINC> Gold nenne ich Euch jedes einzelne beim Namen.~
@1164 = ~Tut es.~
@1165 = ~So. Jedes hat mir seine Geschichte erzählt, und nun kennt Ihr sie auch. Nutzt sie weise, mein Freund.~
@1166 = ~Jetzt nicht.~
@1167 = ~Alles, was Ihr tragt, ist Euch bereits bekannt. Kommt wieder, wenn die Straße Euch neue Rätsel beschert.~
@1168 = ~Ach, Euer Beutel ist zu leicht: <SQCAINC> Gold, nicht weniger. Auch ein alter Gelehrter muss essen.~
@1169 = ~Nun gut, betrachten wir Eure Schätze.~
@1170 = ~Erzähl uns eine Geschichte, alter Mann.~
@1171 = ~Vor langer Zeit bannten die Gelehrten meines Ordens schreckliche Dinge in Stein und vergruben die Steine tief. Nicht jeder Stein hat gehalten, fürchte ich. Findet Ihr einen Edelstein, der in der Nacht flüstert... bringt ihn zuerst zu mir.~
@1172 = ~Lebt wohl.~
@1173 = ~Der Alte Gelehrte~
@1174 = ~Warten im Lager: ein Mitglied, das die Gruppe verlässt, kann im Rastlager am Feuer auf euch warten~
@1175 = ~Withers im Lager: ein Lich, der ein Gruppenmitglied komplett neu erschafft (Volk, Klasse, Kit, Attribute...), kostenlos~
@1176 = ~Withers~
@1177 = ~%s: %s kam in die Truhe (Rucksack voll)~
@1178 = ~Weiter~
@1179 = ~Fertig~
@1180 = ~Soll ich im Lager auf dich warten?~
@1181 = ~Ja, warte im Lager auf mich.~
@1182 = ~Nein, bleib hier.~
@1183 = ~Bereit, wieder aufzubrechen?~
@1184 = ~Schließ dich uns an.~
@1185 = ~Noch nicht.~
@1186 = ~Bestätigen~
@1187 = ~Keine Doppelklasse~
@1188 = ~%s: %d EP nach dem Klassenwechsel zurückerstattet~
@1190 = ~Sterblicher. Du trägst eine Gestalt, die dir die Welt gegeben hat. Ich kann sie auflösen, und du darfst eine andere wählen... noch einmal, ganz von vorn.~
@1191 = ~Erschaffe mich neu.~
@1192 = ~Nicht heute.~
@1193 = ~Wisse: Habe ich einmal begonnen, gibt es kein Zurück. Volk, Berufung, Geist und Körper, alles wird neu gewählt. Deine Erinnerungen und deine Habe bleiben. Soll ich beginnen?~
@1194 = ~Beginne.~
@1195 = ~Ich werde darüber nachdenken.~
@1196 = ~Lagertruhe~
@1197 = ~*Der Deckel öffnet sich knarrend.*~
@1198 = ~Stufe vor dem Klassenwechsel~
@1199 = ~Stufe %d: jetzt %d EP, %d EP nach dem Klassenwechsel~
@1200 = ~%s: %d Zauber kamen ins Grimoire~
@1201 = ~%s lernt %s~
@1202 = ~%s (Stufe %d)~
@1203 = ~Grimoire - gelesen von %s~
@1204 = ~Grimoire öffnen~
@1205 = ~Lernen~
@1206 = ~Schließen~
@1207 = ~Grimoire der verlorenen Zauber~
@1208 = ~Die Zauber, die ein Magier vergaß, als Withers ihn neu erschuf, ruhen auf diesen Seiten. Öffnet es, und jeder, der Magierzauber in sein Buch schreiben kann, lernt sie erneut (jene, die er wirken kann).~
@1022 = ~Ich knacke das Schloss~
@1023 = ~Ich breche es auf~
@1024 = ~Niemand hier kann diese Falle entschärfen (erneut klicken, um trotzdem zu öffnen)~
@1025 = ~Niemand hier kann dieses Schloss öffnen~
@1209 = ~Auto-Roller: eine Schaltfläche Auto-Roll in der Charaktererschaffung behält den besten von vielen Würfen (Stärke 18/xx gewichtet)~
@1210 = ~Willst du nicht lieber unsere Gegenstände identifizieren?~
@1211 = ~Ich möchte mehr über diese Welt erfahren.~
@1212 = ~Ah, sehen wir, was meine Notizen sagen...~
@1250 = ~Bring mir einen neuen Gefährten.~
@1251 = ~Noch eine Seele für deine Schar? Ich kann eine aus dem Nichts formen... oder eine zurückrufen, die du anderswo gekannt hast. Er wird mit euch ziehen, so erfahren wie dein Anführer.~
@1252 = ~Forme ihn vor meinen Augen.~
@1253 = ~Rufe jemanden zurück, den ich kannte (importieren).~
@1254 = ~Ein andermal.~
@1255 = ~Withers: neuer Gefährte~
@1256 = ~Weiter~
@1257 = ~Abbrechen~
@1258 = ~Behält er die Gegenstände, die er trug?~
@1259 = ~Er behält sie~
@1260 = ~Zurücklassen~
@1261 = ~Behält er seine eigene Erfahrung oder übernimmt er die des Gruppenanführers?~
@1262 = ~Seine eigene~
@1263 = ~Die des Anführers~
@1264 = ~%s schließt sich der Gruppe an.~
@1265 = ~Die Gruppe ist voll (%d Mitglieder).~
@1266 = ~Withers rekrutiert: ein neuer Gefährte, in den Erschaffungsbildschirmen des Spiels erstellt oder importiert, kostenlos~
@1267 = ~Ausrüstung des neuen Gefährten~
@1268 = ~Bestätigen~
@1269 = ~Beim Großhändler gekauft: %d GM (Gold der Gruppe: %d GM)~
@1270 = ~Truhe~
@1272 = ~kostenlos~
@1273 = ~Nahkampfwaffe~
@1274 = ~Zweithand~
@1275 = ~Fernkampfwaffe~
@1276 = ~Munition~
@1277 = ~Rüstung~
@1278 = ~Helm~
@1279 = ~Amulett~
@1280 = ~Ringe (zwei)~
@1281 = ~Armschienen / Handschuhe~
@1282 = ~Gürtel~
@1283 = ~Stiefel~
@1284 = ~Umhang~
@1285 = ~Withers bietet an~
@1286 = ~Nehmt unsere Spende für Euren Tempel an: <SQPRRC> GM (Ruf <SQPRREP> -> <SQPRNEXT>).~
@1287 = ~Heilt die ganze Gruppe: <SQPRHL>. Gesamt: <SQPRHC> GM.~
@1288 = ~Seid gesegnet. Die Armen der Schwertküste werden Eure Namen voller Dankbarkeit nennen.~
@1289 = ~Es ist vollbracht. Erhebt euch, ihr alle, und wandelt im Licht.~
@1290 = ~Ach, Euer Beutel ist dafür zu leicht. Kommt wieder, wenn Ihr könnt.~
@1291 = ~Wiederbelebung~
@1292 = ~Wunden~
@1293 = ~verlorene Stufen~
@1294 = ~Fluch~
@1295 = ~Gift~
@1296 = ~Krankheit~
@1297 = ~Nekromant~
@1298 = ~Die Toten haben nichts Besseres zu tun, als den Lebenden beim Üben zu helfen. Nennt einen Gegner, und er wird sich vor Euch erheben... harmlos, es sei denn, Ihr wünscht es anders.~
@1299 = ~Erweckt eine Kreatur für uns.~
@1300 = ~Entfesselt sie: Sollen sie kämpfen und sterben.~
@1301 = ~Besänftigt sie: Macht sie wieder zu unsterblichen Puppen.~
@1302 = ~Räumt auf: Lasst sie alle fallen.~
@1303 = ~Lebt wohl.~
@1304 = ~Wie viele <SQNECRN> sollen sich erheben?~
@1305 = ~Einer.~
@1306 = ~Zwei.~
@1307 = ~Drei.~
@1308 = ~Fünf.~
@1309 = ~Zehn.~
@1310 = ~Keiner, ich habe es mir anders überlegt.~
@1311 = ~Bindet sie an uns: Sollen sie sich unserer Gruppe anschließen.~
@1312 = ~Es ist vollbracht.~
@1313 = ~Bestiarium~
@1314 = ~Monster~
@1315 = ~Menschen~
@1316 = ~Suchen~
@1317 = ~Erwecken~
@1318 = ~Schließen~
@1319 = ~Stufe~
@1322 = ~Schaden~
@1323 = ~Gesamt~
@1324 = ~Zurücksetzen~
@1325 = ~%d Kreaturen~
@1326 = ~Lagernekromant: Übungspuppen aus dem ganzen Bestiarium, Schadensmesser (benötigt das Rastlager)~
@1340 = ~Versorgt bitte unsere Wunden.~
@1341 = ~So. Ruht unbesorgt: Das Licht verlangt nichts dafür.~
@1342 = ~Die Priesterin hat eure Wunden versorgt, während ihr geschlafen habt.~
@1343 = ~Die Priesterin versorgt die Wunden der Gruppe.~
@1344 = ~Preise der Lagerpriesterin~
@1345 = ~Preise der Lagerpriesterin: 75 %~
@1346 = ~Preise der Lagerpriesterin: 50 %~
@1347 = ~Preise der Lagerpriesterin: 25 %~
@1348 = ~Preise der Lagerpriesterin: kostenlos~
@1540 = ~SadoEE~
@1541 = ~SadoEE-Funktionen im Spiel ein- oder ausschalten. Aus hält eine Funktion nur an: Was sie bereits getan hat, bleibt.~
@1542 = ~Truhenhinweise: rote / blaue Gegenstände~
@1543 = ~Seite der Gruppentruhe: unbrauchbare Gegenstände in Rot, nicht identifizierte in Blau.~
@1544 = ~Truhenhinweise: Verbesserungszeichen +~
@1545 = ~Seite der Gruppentruhe: ein + auf Gegenständen, die den angezeigten Charakter verbessern, oder auf einer Magierschriftrolle, die ein Mitglied noch lernen kann.~
@1546 = ~DPS-Zeile in Waffen-Tooltips~
@1547 = ~Schaden pro Runde und ETW0 der ausgerüsteten Waffen, ihren Tooltips hinzugefügt.~
@1548 = ~Passive Fallenerkennung~
@1549 = ~Diebe entdecken Fallen in ihrer Umgebung ohne den Modus Fallen finden.~
@1550 = ~Automatisches Entschärfen~
@1551 = ~Außerhalb des Kampfes entschärfen untätige Diebe die entdeckten Fallen.~
@1552 = ~Auto-Öffnen / Knacken / Aufbrechen~
@1553 = ~Ein Klick auf einen Behälter mit Falle oder Schloss schickt den besten Entschärfer, Schlossknacker oder Kraftprotz.~
@1554 = ~Goldener Umriss für wertvolle Behälter~
@1555 = ~Behälter mit etwas Wertvollem erhalten einen goldenen Umriss.~
@1556 = ~Endlose Munition~
@1557 = ~Pfeile, Bolzen, Kugeln, Wurfpfeile und Wurfwaffen werden nie verbraucht, außer den mächtigsten.~
@1558 = ~Grundmunition im Köcher~
@1559 = ~Mit ausgerüstetem Bogen, Armbrust oder Schleuder liegt Grundmunition im ersten freien Köcherplatz bereit.~
@1560 = ~Angriffsbewegung~
@1561 = ~Die Aktion Angriffsbewegung (zugewiesen im SadoEE-Reiter Maustasten).~
@1562 = ~Kein Spam von Bardenlied / Untote vertreiben~
@1563 = ~Die KI-Skripte der Gruppe starten einen bereits aktiven Modus nicht mehr neu (keine wiederholte Meldung).~
@1564 = ~Sortierte Beute~
@1565 = ~Gegenstände am Boden, in Behältern und in der Beuteleiste werden sortiert.~
@1566 = ~Truhen in der Leiste der Bodengegenstände~
@1567 = ~Behälter in der Nähe erscheinen in der Leiste der Bodengegenstände.~
@1568 = ~Warten im Lager~
@1569 = ~Ein Mitglied, das die Gruppe verlässt, kann im Rastlager warten.~
@1570 = ~FPS-Anzeige~
@1571 = ~Bilder pro Sekunde oben im Spielbildschirm (F12 blendet sie auch ein / aus).~
