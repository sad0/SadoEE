@2012 = ~Grand Merchant at the rest camp: sells every item seen at the stores already visited (requires the rest camp and the stash)~
@2013 = ~Requires the stash.~
@2014 = ~Requires Baldur's Gate EE, Baldur's Gate II EE or EET.~
@2020 = ~Features you can switch on or off in game (SadoEE options page)~
@2021 = ~Install them all: each one can be turned off in the SadoEE options page (recommended)~
