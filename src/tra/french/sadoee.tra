// SadoEE's own strings (groups, guards, merged components). Party Stash strings: setup.tra; ex-SadoQoL: qol.tra.
@2000 = ~Party Stash~
@2001 = ~Camp de repos~
@2002 = ~Confort de jeu~
@2010 = ~SadoEE remplace Party Stash et SadoQoL (mêmes fichiers) : désinstallez d'abord tous les composants de Party Stash et de SadoQoL. Le contenu du coffre reste dans vos sauvegardes et revient avec le coffre de SadoEE.~
@2011 = ~Nécessite le composant Camp de repos.~
@2012 = ~Grand marchand au camp de repos : vend tout objet vu chez les marchands déjà visités (nécessite le camp de repos et le coffre)~
@2013 = ~Nécessite le coffre.~
@2014 = ~Pour l'instant : Baldur's Gate EE et EET seulement (le camp de BG2EE arrive).~
